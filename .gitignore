# Graphify: track the graph, report, HTML, cache, labels, and analysis.
# Skip only machine-local paths, scratch, and optional bulky exports.
# Graphs live next to each corpus: papers/canonical/graphify-out, reviews/graphify-out, …
**/graphify-out/.graphify_python
**/graphify-out/.graphify_root
**/graphify-out/.graphify_uncached.txt
**/graphify-out/.needs_update
**/graphify-out/*.svg
**/graphify-out/*.graphml
**/graphify-out/cypher.txt
**/graphify-out/obsidian/
**/graphify-out/wiki/
**/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Bulk conversion logs
logs/

# Converter scratch (PDF/LaTeX/OCR workdirs, local test output)
.conversion-test/
.conversion-work/
*.conversion.json

# Local env / tooling
.env
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.DS_Store
__pycache__/
*.pyc
*.egg-info/

# Secrets
credentials.sh
