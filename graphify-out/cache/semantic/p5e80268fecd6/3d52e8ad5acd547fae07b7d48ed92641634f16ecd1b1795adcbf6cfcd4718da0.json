{"nodes": [{"id": "2607_20548_paper", "label": "SOAP, Muon, and Beyond: Pushing LLM Pretraining Scales", "file_type": "paper", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Mikail Khona et al.", "contributor": null, "rationale": null}, {"id": "2607_20548_soap", "label": "SOAP optimizer", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_20548_muon", "label": "Muon optimizer (orthogonalized update)", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orthogonalization structurally normalizes update directions independent of coordinate-wise scaling, giving stability at extreme batch sizes where AdamW's element-wise second-moment estimator becomes poorly calibrated."}, {"id": "2607_20548_adamw", "label": "AdamW optimizer", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_20548_kl_soap", "label": "KL-SOAP (KL-regularized Kronecker-factor SOAP variant)", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines per-step QR eigenbasis recomputation including the current gradient with KL-divergence-regularized covariance estimation to eliminate the slingshot instability and reduce factor-matrix condition number."}, {"id": "2607_20548_slingshot_instability", "label": "SOAP slingshot instability (stale preconditioner)", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caused by infrequent eigenbasis refresh combined with excluding the current step's gradient; harmless at small scale, catastrophic (divergence) at large batch/model scale."}, {"id": "2607_20548_update_rms_matching", "label": "Update-RMS matching (learning-rate transfer framework)", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps RMS norm of parameter update consistent across AdamW, SOAP, and Muon to enable a fair comparison rather than confounding results via independent per-optimizer LR tuning; adopted from prior Kimi-Moonshot work."}, {"id": "2607_20548_batch_size_ramp_up", "label": "Batch-size ramp-up schedule", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starting small and doubling batch size periodically (with sqrt LR scaling) avoids the early-training cost of jumping straight to a large batch size while still realizing its eventual large-batch advantage."}, {"id": "2607_20548_layer_wise_distributed_optimizer", "label": "Layer-wise distributed optimizer (Megatron-LM)", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assigns whole parameter matrices to GPUs round-robin and hides synchronization via bucketed asynchronous all-gather, retaining full unapproximated optimizer computations that require intact 2D matrices, unlike ZeRO/FSDP element-wise sharding."}, {"id": "2607_20548_mamba_conv1d_mismatch", "label": "Mamba Conv1D / Muon orthogonalization mismatch", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applying Muon's orthogonalization to Mamba's Conv1D filters degrades convergence and causes instability, so Muon is selectively applied only to dense linear projections, falling back to AdamW for structurally mismatched parameters."}, {"id": "2607_20548_emerging_optimizers_library", "label": "Emerging-Optimizers library", "file_type": "code", "source_file": "2607.20548.md", "source_location": null, "source_url": "https://github.com/NVIDIA-NeMo/Emerging-Optimizers", "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_20548_megatron_lm_layer_wise_optimizer_file", "label": "Megatron-LM layer_wise_optimizer.py", "file_type": "code", "source_file": "2607.20548.md", "source_location": null, "source_url": "https://github.com/NVIDIA/Megatron-LM/blob/main/megatron/core/optimizer/layer_wise_optimizer.py", "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_20548_nvidia", "label": "NVIDIA", "file_type": "concept", "source_file": "2607.20548.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "2607_20548_paper", "target": "2607_20548_emerging_optimizers_library", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "2607.20548.md", "source_location": "artifacts", "weight": 1.0}, {"source": "2607_20548_paper", "target": "2607_20548_megatron_lm_layer_wise_optimizer_file", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "2607.20548.md", "source_location": "artifacts", "weight": 1.0}, {"source": "2607_20548_paper", "target": "2607_20548_nvidia", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2607.20548.md", "source_location": "organizations", "weight": 1.0}, {"source": "2607_20548_layer_wise_distributed_optimizer", "target": "2607_20548_megatron_lm_layer_wise_optimizer_file", "relation": "implements", "confidence": "EXTRACTED", "confid