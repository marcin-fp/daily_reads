{"nodes": [{"id": "2510_00931_paper", "label": "Making, not Taking, the Best of N", "file_type": "paper", "source_file": "2510.00931.md", "source_location": null, "source_url": "https://arxiv.org/abs/2510.00931v1", "captured_at": null, "author": "Ammar Khairi, Daniel D'souza, Marzieh Fadaee, Julia Kreutzer", "contributor": null, "rationale": null}, {"id": "2510_00931_best_of_n", "label": "Best-of-N Selection", "file_type": "concept", "source_file": "2510.00931.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Quality is capped by the single best candidate in the pool and by how well the scoring function aligns with what is wanted; scaling reward model accuracy or sample count to fix this can be expensive."}, {"id": "2510_00931_fusion_of_n", "label": "Fusion-of-N (FusioN)", "file_type": "concept", "source_file": "2510.00931.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BoN wastes information because different candidates get different parts of an answer right; a fusor LLM reads all candidates and synthesizes a new answer, not restricted to be one of the originals, so it can in principle exceed the best individual candidate; BoN is a degenerate special case since the fusor can copy the best candidate wholesale."}, {"id": "2510_00931_llm_fusor", "label": "LLM Fusor", "file_type": "concept", "source_file": "2510.00931.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_00931_mixture_of_agents", "label": "Mixture-of-Agents (Wang et al. 2024)", "file_type": "document", "source_file": "2510.00931.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_00931_llm_blender", "label": "LLM-Blender (Jiang et al. 2023)", "file_type": "document", "source_file": "2510.00931.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_00931_li2025a", "label": "Li et al. 2025a (MoA robustness claim)", "file_type": "document", "source_file": "2510.00931.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_paper", "label": "Pre-training under infinite compute", "file_type": "paper", "source_file": "2510.00931.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "2510_00931_fusion_of_n", "target": "2510_00931_best_of_n", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2510.00931.md", "source_location": null, "weight": 1.0}, {"source": "2510_00931_paper", "target": "2510_00931_mixture_of_agents", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2510.00931.md", "source_location": null, "weight": 1.0}, {"source": "2510_00931_paper", "target": "2510_00931_llm_blender", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2510.00931.md", "source_location": null, "weight": 1.0}, {"source": "2510_00931_paper", "target": "2510_00931_li2025a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "2510.00931.md", "source_location": null, "weight": 1.0}, {"source": "2510_00931_paper", "target": "2509_14786_paper", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "2510.00931.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "fusion_bon_aggregation_flow", "label": "FusioN vs BoN Aggregation Mechanism Comparison", "nodes": ["2510_00931_fusion_of_n", "2510_00931_best_of_n", "2510_00931_llm_fusor"], "relation": "participate_