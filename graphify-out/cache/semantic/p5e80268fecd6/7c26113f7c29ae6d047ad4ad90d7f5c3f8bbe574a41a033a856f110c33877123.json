{"nodes": [{"id": "26vmfmem_paper", "label": "The von Mises\u2013Fisher N-Gram Memory Module for O(1) Zero-Shot Fact Injection", "file_type": "paper", "source_file": "26vmfmem.md", "source_location": null, "source_url": null, "captured_at": "2026", "author": "Not stated in source", "contributor": null, "rationale": "Proposes replacing each memory table entry's fixed embedding with a von Mises\u2013Fisher distribution (mean direction + confidence) so that editing a fact reduces to overwriting the mean and maximizing confidence, avoiding gradient-based retraining; no experiments are run to support this."}, {"id": "26vmfmem_vmf_memory_module", "label": "vMF N-Gram Memory Module (proposed mechanism)", "file_type": "concept", "source_file": "26vmfmem.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parameterizes each hashed n-gram slot as a vMF distribution (\u00b5, \u03ba) learned via MLE, fused into the residual stream via Slerp so the hidden state stays on the sphere; enables forced maximum-\u03ba overwrite for zero-shot fact injection."}, {"id": "26vmfmem_deepseek_engram_ref", "label": "DeepSeek Engram (arXiv:2601.07372)", "file_type": "paper", "source_file": "26vmfmem.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26vmfmem_slerp", "label": "Spherical Linear Interpolation (Slerp) Fusion", "file_type": "concept", "source_file": "26vmfmem.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as a norm-preserving alternative to additive activation injection, avoiding magnitude drift seen in naive activation steering."}, {"id": "26vmfmem_mhc", "label": "Manifold-Constrained Hyper-Connections (mHC / Birkhoff polytope projection)", "file_type": "concept", "source_file": "26vmfmem.md", "source_location": null, "source_url": null, "captured_a