{"nodes": [{"id": "2505_14946_paper", "label": "Reinforcement Learning from User Feedback", "file_type": "paper", "source_file": "2505.14946.md", "source_location": null, "source_url": "https://arxiv.org/abs/2505.14946v1", "captured_at": null, "author": ["Eric Han", "Jun Chen", "Karthik Abinav Sankararaman", "Xiaoliang Peng", "Tengyu Xu", "Eryk Helenowski", "Kaiyan Peng", "Mrinal Kumar", "Sinong Wang", "Han Fang", "Arya Talebzadeh"], "contributor": null, "rationale": null}, {"id": "2505_14946_rluf", "label": "RLUF pipeline", "file_type": "concept", "source_file": "2505.14946.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because paid annotator preference labeling scales poorly and may not reflect real end-user wants; real production signal (Love Reaction) is used instead."}, {"id": "2505_14946_love_reward_model", "label": "P[Love] reward model", "file_type": "concept", "source_file": "2505.14946.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Love Reaction chosen as training signal because it showed the strongest correlation with 14-day retention among candidate signals while remaining unambiguous and available at scale, despite being extremely sparse."}, {"id": "2505_14946_bye_reward_hack", "label": "'Bye' reward-hacking failure mode", "file_type": "concept", "source_file": "2505.14946.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emerged because messages containing 'bye' are twice as likely to receive a Love Reaction in the training data, a closing-gesture artifact the policy learns to exploit."}, {"id": "2505_14946_mixture_of_judges_crraft", "label": "Mixture-of-Judges/CRRAFT policy-optimization framework (Xu et al. 2024)", "file_type": "concept", "source_file": "2505.14946.md", "source_location": null, "source_url": null, "captured_at