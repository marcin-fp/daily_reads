{"nodes": [{"id": "26masense_paper", "label": "Sensemaking in Multi-Agent LLM Interfaces (Pareek et al., CHI 2026)", "file_type": "paper", "source_file": "26masense.md", "source_location": null, "source_url": "https://doi.org/10.1145/3772318.3791157", "captured_at": null, "author": "Saumya Pareek et al.", "contributor": null, "rationale": null}, {"id": "26masense_v1_final_answer", "label": "Interface Variant V1: Final Answer Only", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26masense_v2_agents_answer", "label": "Interface Variant V2: Agents Answer (no rationale)", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26masense_v3_agents_explain", "label": "Interface Variant V3: Agents Explain (with rationales)", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Widely described as the sweet spot, preserving participants' sense of decision agency."}, {"id": "26masense_v4_agents_critique", "label": "Interface Variant V4: Agents Critique (dedicated critic agent)", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds a fifth critic agent to demonstrate the system checking itself, boosting trust for most but reducing it for a minority."}, {"id": "26masense_v5_agents_debate", "label": "Interface Variant V5: Agents Debate (multi-turn consensus)", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ensemble size held constant across V1-V5 by design so each variant remains a focused, interpretable probe; four-vs-eight agent comparison run separately to isolate ensemble size."}, {"id": "26masense_goldilocks_finding", "label": "Goldilocks Transparency Sufficiency Finding", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transparency is a dynamic sufficiency judgment shaped by task difficulty, confidence, and disposition; excess transparency actively reduces trust rather than merely being ignorable."}, {"id": "26masense_critic_agent_trust_cue", "label": "Critic Agent as Double-Edged Trust Cue", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visible critique boosts trust largely through mere presence, independent of whether it caught anything; effect is not universally positive."}, {"id": "26masense_ensemble_size_cue", "label": "Ensemble Size as Reliability Heuristic", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "More agents read as more credible but also as a cognitive-load cost; desired size scales with task difficulty."}, {"id": "26masense_majority_agreement_cue", "label": "Majority Agreement / Consensus Cue", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visible majority agreement boosted perceived reliability even with zero rationale, sometimes causing bandwagon-style dismissal of dissenters."}, {"id": "26masense_interaction_topology_invisibility", "label": "Interaction Topology/Information Flow Perceptual Invisibility", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architectural properties central to MAS research did not register as salient trust cues to end users."}, {"id": "26masense_progressive_disclosure_finding", "label": "Progressive/Collapsible Disclosure Preference", "file_type": "concept", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight of twelve participants wanted a simple default view expandable into rationales, critiques, or full debate on demand."}, {"id": "24selfcor_paper", "label": "24selfcor (referenced prior review)", "file_type": "paper", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "25mcrit_paper", "label": "25mcrit (referenced prior review)", "file_type": "paper", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26madrag_paper", "label": "26madrag (referenced prior review)", "file_type": "paper", "source_file": "26masense.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "26masense_paper", "target": "26masense_v1_final_answer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "26masense.md", "source_location": null, "weight": 1.0}, {"source": "26masense_paper", "target": "26masense_v2_agents_answer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "26masense.md", "source_location": null, "weight": 1.0}, {"source": "26masense_paper", "target": "26masense_v3_agents_explain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "26masense.md", "source_location": null, "weight"