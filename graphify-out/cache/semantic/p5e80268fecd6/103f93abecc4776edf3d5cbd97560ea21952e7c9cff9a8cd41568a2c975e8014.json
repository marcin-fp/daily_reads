{"nodes": [{"id": "26daedsci_paper", "label": "How Do We Build AI to Push the Frontiers of Scientific Discovery? (Anandkumar, 2026)", "file_type": "paper", "source_file": "26daedsci.md", "source_location": null, "source_url": "https://doi.org/10.1162/daed.a.983", "captured_at": null, "author": "Anima Anandkumar", "contributor": null, "rationale": null}, {"id": "26daedsci_neural_operators", "label": "Neural Operators", "file_type": "concept", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed as remedy for purely data-driven AI's poor extrapolation and miscalibration: integrating physical laws/symmetries as constraints improves extrapolation and provides a verification mechanism against physical validity, potentially reducing need for physical prototyping."}, {"id": "26daedsci_fourcastnet", "label": "FourCastNet", "file_type": "concept", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26daedsci_fourcastnet3", "label": "FourCastNet3", "file_type": "concept", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26daedsci_pinns", "label": "Physics-Informed Neural Networks (PINNs)", "file_type": "concept", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PINNs solve a single problem instance via test-time optimization against PDE-residual loss, often facing an intractable optimization landscape for time-varying problems and typically no faster than classical solvers even when converged \u2014 motivating Neural Operators' trained-once, reusable design instead."}, {"id": "26daedsci_leandojo", "label": "LeanDojo", "file_type": "code", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Anima Anandkumar's team", "contributor": null, "rationale": null}, {"id": "26daedsci_lean", "label": "Lean (formal proof system)", "file_type": "concept", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26daedsci_spherical_fourier_neural_operator", "label": "Spherical Fourier Neural Operator (SFNO)", "file_type": "concept", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built-in rotational equivariance on the sphere avoids polar distortion accumulation, enabling stable extrapolation to seasonal/multi-year timescales despite training only on short autoregressive steps."}, {"id": "26daedsci_closure_modeling", "label": "Closure Modeling (coarse-graining correction)", "file_type": "concept", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closure corrections restricted to the same coarse grid as the underlying solver form an ill-posed learning target and cannot mix information nonlinearly across scales, making them less data-efficient and stable than end-to-end Neural Operators trained progressively across resolutions."}, {"id": "26daedsci_foundation_model_for_physics", "label": "Foundation Model for Physics (vision)", "file_type": "concept", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26daedsci_25mcpsim", "label": "25mcpsim (LLM-orchestrated agentic pipeline around numerical solver)", "file_type": "paper", "source_file": "26daedsci.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null},