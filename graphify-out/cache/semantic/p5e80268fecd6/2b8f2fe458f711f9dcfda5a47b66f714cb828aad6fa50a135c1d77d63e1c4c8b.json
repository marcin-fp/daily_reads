{"nodes": [{"id": "2402_07043_paper", "label": "A Tale of Tails: Model Collapse as a Change of Scaling Laws", "file_type": "paper", "source_file": "2402.07043.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Elvis Dohmatob; Yunzhen Feng; Pu Yang; Francois Charton; Julia Kempe", "contributor": null, "rationale": "Provides the first theoretical, scaling-law-based account of model collapse, grounding it in heavy-tailed power-law structure rather than only Gaussian toy settings."}, {"id": "2402_07043_tail_cutting_narrowing", "label": "Tail Cutting / Tail Narrowing Mechanism", "file_type": "concept", "source_file": "2402.07043.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2402_07043_model_collapse", "label": "Model Collapse Scaling-Law Theory", "file_type": "concept", "source_file": "2402.07043.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formalizes and generalizes Shumailov et al.'s empirically-observed term 'model collapse' with a mathematical mechanism."}, {"id": "2402_07043_grokking_mitigation", "label": "Grokking-Based Mitigation via Real-Data Mixing", "file_type": "concept", "source_file": "2402.07043.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any strictly positive proportion of real data, however small, eventually breaks through the collapse plateau at the cost of needing more total data, a specific and practically cheap prescription."}, {"id": "2402_07043_triplet_scaling_law", "label": "Triplet Scaling Law", "file_type": "concept", "source_file": "2402.07043.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends the collapse mechanism to capacity-limited associative-memory models via three competing terms (data, cap