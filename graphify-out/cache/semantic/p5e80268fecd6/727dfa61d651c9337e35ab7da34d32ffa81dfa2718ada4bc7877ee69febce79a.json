{"nodes": [{"id": "2507_04766_paper", "label": "ABench-Physics: Benchmarking Physical Reasoning in LLMs", "file_type": "paper", "source_file": "2507.04766.md", "source_location": null, "source_url": "https://arxiv.org/abs/2507.04766v1", "captured_at": null, "author": "Yiming Zhang et al.", "contributor": null, "rationale": null}, {"id": "2507_04766_abenchphysics", "label": "ABench-Physics Benchmark", "file_type": "concept", "source_file": "2507.04766.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "500-problem numerical-answer benchmark designed to be graduate/Olympiad-level, numerical-only, and dynamic to avoid memorization-based scoring."}, {"id": "2507_04766_phya", "label": "Phy A (Static High-Difficulty Set)", "file_type": "concept", "source_file": "2507.04766.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Problems selected via screening for cases where models produce long, low-accuracy responses, i.e. explicitly chosen because contemporary LLMs already struggle with them."}, {"id": "2507_04766_phyb", "label": "Phy B (Dynamic Variation Set)", "file_type": "concept", "source_file": "2507.04766.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built from problems with clear computational steps to enable numeric-constant perturbation while preserving the identical underlying physical model."}, {"id": "2507_04766_variationengine", "label": "Automatic Variation Engine", "file_type": "concept", "source_file": "2507.04766.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Still-ongoing development; perturbs numeric constants in ground-truth solutions to test whether correctness generalizes across differently-parameterized versions of the same physics model."}, {"id": "2507_04766_rlvs