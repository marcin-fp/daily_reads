{"nodes": [{"id": "2603_26718_paper", "label": "Toward Evaluation Frameworks for Multi-Agent Scientific AI Systems", "file_type": "paper", "source_file": "2603.26718.md", "source_location": null, "source_url": "https://arxiv.org/abs/2603.26718v2", "captured_at": "2026-09-17", "author": "Marcin Abram", "contributor": null, "rationale": "Position/framework paper arguing that agentic scientific-AI systems require structurally different evaluation than single-model exam-style benchmarks, due to retrieval-reasoning and temporal confounds and multi-dimensional scoring needs."}, {"id": "2603_26718_replication_benchmarks", "label": "Replication Benchmarks", "file_type": "concept", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exploit the gap between what a paper states and every step needed to reproduce it; strong integration test but source papers may contain errors and numeric match doesn't verify every intermediate step."}, {"id": "2603_26718_error_detection_benchmarks", "label": "Error Detection Benchmarks", "file_type": "concept", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distinguishes 'find the planted error' (search problem, easy to score) from 'review for correctness' (calibration/judgment problem, harder, closer to real review); crude errors caught by algebraic consistency alone, motivating physically-plausible-but-algebraically-consistent errors."}, {"id": "2603_26718_scientific_reasoning_benchmarks", "label": "Scientific Reasoning Benchmarks", "file_type": "concept", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_26718_discovery_style_benchmarks", "label": "Discovery-Style Benchmarks", "file_type": "concept", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Includes Fabricated Phenomena and Solving Novel Problems; central weakness is verifying self-consistency may require a verifier as capable as the generator, risking shared blind spots."}, {"id": "2603_26718_planted_structure_problems", "label": "Planted-Structure Problems", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Engineer the problem so the answer is known by construction, reducing likelihood the answer can be looked up directly."}, {"id": "2603_26718_constraint_modified_problems", "label": "Constraint-Modified Problems", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introduce realistic but non-standard constraints unlikely to appear verbatim in existing literature, reducing retrieval-based shortcuts."}, {"id": "2603_26718_dynamic_difficulty_families", "label": "Dynamic Difficulty Families", "file_type": "concept", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vary a continuous parameter to obtain a scaling curve rather than a single accuracy number."}, {"id": "2603_26718_self_consistency_tests", "label": "Self-Consistency Tests", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L232", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solve the same problem via two structurally independent methods; agreement is necessary but not sufficient for correctness since the same conceptual error could affect both methods."}, {"id": "2603_26718_multi_turn_dialogue", "label": "Multi-Turn Scientific Dialogue", "file_type": "concept", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reveal information progressively and score whether the system asks the right clarifying questions rather than only answering what it is given."}, {"id": "2603_26718_ablation_studies", "label": "Ablation Studies (Retrieval vs Reasoning Diagnostic)", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Disable specific subsystems to see how much score depends on retrieval versus reasoning; a cheap way to learn what a benchmark is actually measuring before trusting a single accuracy number."}, {"id": "2603_26718_interviews", "label": "Practitioner Interviews (Section VIII)", "file_type": "concept", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interviews with four quantum science/engineering professionals framed as providing 'initial intuition' rather than a representative survey; all want AI as a partner, not autonomous replacement, valuing critical pushback over raw problem-solving."}, {"id": "2603_26718_future_research_directions_pipeline", "label": "Future Research Directions Feasibility Pipeline", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L333", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preliminary feasibility demo: 300 quant-ph papers, 414 extracted future-direction claims via Claude Sonnet 4.6, clustered into 13 top-1 categories; not checked against independent ground truth and multi-category assignment untested."}, {"id": "2603_26718_retrievable_problem", "label": "Solving a Retrievable Problem", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_26718_reasoning_vs_retrieval_measurement", "label": "Measuring Reasoning vs Retrieval Ability", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L80", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A problem already solved in the literature mostly tests retrieval and synthesis, not the ability to solve it from scratch."}, {"id": "2603_26718_retrieval_reasoning_diagnosis", "label": "Diagnosing Retrieval vs Reasoning via Ablation", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L252", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small performance drop without retrieval indicates the benchmark tests reasoning; a collapse to near zero indicates it mostly tests retrieval."}, {"id": "2603_26718_retrieval_shortcut_resistance", "label": "Resistance to Retrieval-Based Shortcuts", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L194", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_26718_self_consistency_sufficiency", "label": "Sufficiency of Self-Consistency as Correctness Evidence", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L232", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly stated as necessary but not sufficient, since the same conceptual error can affect both independent methods."}, {"id": "2603_26718_dynamic_benchmark_feasibility", "label": "Feasibility of a Dynamic Contamination-Resistant Benchmark", "file_type": "concept", "source_file": "2603.26718.md", "source_location": "L333", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "300 papers processed, 414 directions extracted and clustered, with one explicitly flagged partial failure and no independent validation of extraction accuracy."}, {"id": "2603_26718_critpt", "label": "CritPt (Frontier-Physics Expert Problems)", "file_type": "paper", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sourced from unpublished expert work specifically to dodge retrieval contamination; credited as reflecting current best practice but flagged as costly, individually biased, and opaquely graded."}, {"id": "2603_26718_paperbench", "label": "PaperBench", "file_type": "paper", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ML research replication benchmark; best tested agent reached 21.0% against a 41.4% human-PhD baseline."}, {"id": "2603_26718_replicationbench", "label": "ReplicationBench", "file_type": "paper", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies PaperBench-style replication methodology to astrophysics; frontier models score below 20%."}, {"id": "2603_26718_gpqa", "label": "GPQA / GPQA-Diamond", "file_type": "paper", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First-generation closed-form exam-style benchmark now approaching saturation; frontier models exceed 90% in some evaluations."}, {"id": "2603_26718_alphaproof", "label": "AlphaProof / Formal Theorem-Proving Line (Aristotle, DeepSeek-Prover)", "file_type": "paper", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Closed axiomatic verification regime, structurally distinguished from theoretical physics which requires connecting formal derivation to physical intuition."}, {"id": "2603_26718_minif2f", "label": "miniF2F Benchmark", "file_type": "paper", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_26718_apollo", "label": "APOLLO Framework", "file_type": "paper", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines LLM generation with symbolic repair for formal theorem proving."}, {"id": "2603_26718_gu_krenn_work", "label": "Gu & Krenn LLM-Knowledge-Graph Idea Generation Work", "file_type": "paper", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cited as validating the underlying premise tested in the future-research-directions feasibility study."}, {"id": "2603_26718_verification_md", "label": "VERIFICATION.md (Review Corpus Reference Document)", "file_type": "document", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_26718_taxonomy_md", "label": "TAXONOMY.md (Review Corpus Reference Document)", "file_type": "document", "source_file": "2603.26718.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "2603_26718_paper", "target": "2603_26718_replication_benchmarks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2603.26718.md", "source_location": null, "weight": 1.0}, {"source": "2603_26718_paper", "target": "2603_26718_error_detection_benchmarks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2603.26718.md", "source_location": null, "weight": 1.0}, {"source": "2603_26718_paper", "target": "2603_26718_scientific_rea