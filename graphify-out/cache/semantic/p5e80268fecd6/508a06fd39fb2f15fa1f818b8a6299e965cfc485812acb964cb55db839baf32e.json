{"nodes": [{"id": "2512_04388_paper", "label": "Learning to Orchestrate Agents in Natural Language with the Conductor (arXiv:2512.04388)", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_conductor", "label": "The Conductor (7B RL-trained natural-language orchestrator)", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trained via GRPO so the model learns which worker excels at which task, correcting misconceptions an untrained frontier-model orchestrator retains; demonstrates orchestration skill is learnable and distinct from general model capability."}, {"id": "2512_04388_grpo_training", "label": "GRPO reinforcement learning training recipe", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repurposed from the DeepSeek-R1 reasoning-training paradigm to reward workflow design rather than direct problem solving; converges in 200 iterations without KL regularization because the strong worker pool sidesteps exploration difficulties."}, {"id": "2512_04388_worker_pool", "label": "Fixed pool of seven worker LLMs (GPT-5, Gemini 2.5 Pro, Claude Sonnet 4, DeepSeek-R1-Distill-Qwen-32B, Gemma3-27B, Qwen3-32B)", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_mixture_of_agents", "label": "Mixture-of-Agents baseline", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_masrouter", "label": "MASRouter baseline", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_routerdc", "label": "RouterDC baseline", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_smoothie", "label": "Smoothie baseline", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_self_reflection_baseline", "label": "5-round self-reflection baseline", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_recursive_conductor", "label": "Recursive Conductor (self-invoking test-time compute variant)", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows the Conductor to recursively call itself as one of its own workers, enabling a new test-time compute scaling axis; on BigCodeBench it detects GPT-5 is over-relied-upon and reallocates recursive calls to Claude Sonnet 4 and Gemini 2.5 Pro."}, {"id": "2512_04388_subtask_engineering_ablation", "label": "Natural-language subtask engineering ablation", "file_type": "concept", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The value of explicit per-worker subtask instructions scales with how constraint-heavy and format-sensitive a task is, with the largest drop from removing it occurring on LiveCodeBench versus minimal drop on MATH500/MMLU/RLPR."}, {"id": "2510_00931_fusion", "label": "FusioN: LLM-based synthesis aggregation of Best-of-N samples (arXiv:2510.00931)", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_pretraining_infinite_compute", "label": "Pre-training under infinite compute (arXiv:2509.14786)", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_conductor", "label": "The Conductor (RL-Trained Orchestrator)", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A small (7B) model is trained end-to-end with RL purely from a correctness reward, without hand-specified coordination strategies, to design natural-language agentic workflows that outperform individual workers and existing multi-agent baselines while using fewer API calls and lower cost."}, {"id": "2512_04388_worker_models", "label": "Worker LLM Pool", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_untrained_frontier_orchestrator", "label": "Untrained Frontier Model as Orchestrator (Control)", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used as a control to rule out the possibility that any capable LLM, without RL training, could achieve the Conductor's coordination performance."}, {"id": "2512_04388_multi_agent_baselines", "label": "Multi-Agent Coordination Baselines", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_test_time_recursion", "label": "Test-Time Recursive Conductor Invocation", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recursion reallocates calls away from an underperforming worker, boosting out-of-distribution performance."}, {"id": "2512_04388_subtask_ablation", "label": "Subtask Writing Ablation", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_livecodebench_result", "label": "Conductor LiveCodeBench SOTA Claim", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04388_gpqa_result", "label": "Conductor GPQA SOTA Claim", "file_type": "paper", "source_file": "2512.04388.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "2512_04388_paper", "target": "2512_04388_conductor", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2512.04388.md", "source_location": null, "weight": 1.0}, {"source": "2512_04388_conductor", "target": "2512_04388_grpo_training", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2512.04388.md", "source_location": null, "weight": 0.9}, {"source": "2512_04388_conductor", "target": "2512_04388_worker_pool", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2512.04388.md", "source_location": null, "weight": 0.9}, {"source": "2512_04388_conductor", "target": "2512_04388_mixture_of_agents", "relation": "con