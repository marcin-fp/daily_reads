{"nodes": [{"id": "2606_18208_loopwm", "label": "Looped World Models (LoopWM)", "file_type": "paper", "source_file": "2606.18208.md", "source_location": null, "source_url": "https://arxiv.org/abs/2606.18208v1", "captured_at": null, "author": "Hongyuan Adam Lu et al.", "contributor": null, "rationale": null}, {"id": "2606_18208_spectral_stability", "label": "Spectral Stability Constraint", "file_type": "concept", "source_file": "2606.18208.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parameterizes the state-retention matrix as a discretized continuous-time matrix with strictly negative diagonal entries, guaranteeing eigenvalues in (0,1) by construction without gradient clipping or renormalization."}, {"id": "2606_18208_deferred_decoding", "label": "Deferred Decoding", "file_type": "concept", "source_file": "2606.18208.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Advances latent state across K steps in continuous hidden space, invoking decoder heads only at the terminal step, reducing decoder calls from K to 1 and freeing the latent trajectory from step-by-step decodability pressure."}, {"id": "2606_18208_dual_loop", "label": "Dual Inner/Outer Loop Structure", "file_type": "concept", "source_file": "2606.18208.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decouples within-step computational depth (adaptive via early exit) from across-step temporal extent, letting each be tuned independently."}, {"id": "2511_05963_nextlat", "label": "Next-Latent Prediction Transformers Learn Compact World Models (referenced prior work)", "file_type": "paper", "source_file": "2606.18208.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2606_18208_loopedworldmodels", "label": "