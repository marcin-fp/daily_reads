{"nodes": [{"id": "2601_05280_paper", "label": "On Solomonoff Induction in Large Language Models and the Limits of Self-Improving", "file_type": "paper", "source_file": "2601.05280.md", "source_location": null, "source_url": "https://arxiv.org/abs/2601.05280v2", "captured_at": "2026-09-17", "author": "Hector Zenil", "contributor": null, "rationale": "Connects two AI-safety debates\u2014whether LLMs implement Solomonoff induction and whether recursive self-training drives a Singularity\u2014arguing neither holds under the training objective alone, and proposes 'symbolic model synthesis' (explicit mechanism construction and external testing) as the needed remedy."}, {"id": "2601_05280_solomonoff_induction", "label": "Solomonoff Induction", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_recursive_self_training", "label": "Recursive Self-Training / Self-Improving Loop", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_self_imitation_identity", "label": "Self-Imitation Identity Result (KL-loss fixed point)", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Population-level optimum of pure self-imitation under log-loss equals the predecessor's own distribution \u2014 an identity map, not an improvement direction; any observed capability gain from recursive self-training must come from something else added to the loop."}, {"id": "2601_05280_model_collapse", "label": "Finite-Resampling Diversity Decay (Model Collapse mechanism)", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated replacement of a distribution with empirical frequencies of N_t fresh draws reduces expected Gini-Simpson diversity by (1-1/N_t) per step, driving the process almost surely to a degenerate vertex under a divergent-sum condition on 1/N_t \u2014 one specific, narrow mechanism behind observed model collapse."}, {"id": "2601_05280_grounding_convergence", "label": "Grounding Convergence Result (cumulative retention product)", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Convergence to a fixed reference distribution P is governed by the infinite cumulative product of retention factors (1-alpha_s), not by whether the instantaneous grounding fraction alpha_t stays bounded away from zero; explicit contrasting schedules (1/(t+2) vs 1/(t+2)^2) demonstrate this."}, {"id": "2601_05280_accessible_information", "label": "Accessible Information (operational accessibility vs conservation)", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distinguishes a global information-conservation bound (DPI, Levin's non-growth) from an operational accessibility question: a value can be fully determined by data yet only partially accessible to a resource-bounded learner; a monotonically increasing 'accessible information' quantity captures this without violating conservation."}, {"id": "2601_05280_symbolic_model_synthesis", "label": "Symbolic Model Synthesis", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defined functionally rather than architecturally: any system (neural, symbolic, or hybrid) that can construct, manipulate, and test explicit generative structures against evidence not controlled by the system counts as satisfying the requirement for genuine self-improvement beyond distributional fitting."}, {"id": "2601_05280_ctm", "label": "Coding Theorem Method", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Hector Zenil", "contributor": null, "rationale": "Author's prior toolkit for finite algorithmic-probability estimation via enumerating small programs, offered as one concrete route to symbolic model synthesis; inherits uncomputability of exact Kolmogorov complexity."}, {"id": "2601_05280_bdm", "label": "Block Decomposition Method", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Hector Zenil", "contributor": null, "rationale": "Scales CTM estimates to larger objects by decomposition; noted to inherit decomposition-dependence as a known limitation."}, {"id": "2601_05280_aid", "label": "Algorithmic Information Dynamics", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Hector Zenil", "contributor": null, "rationale": "Perturbation-based structural analysis tool; noted to inherit representation- and perturbation-scheme-dependence as a known limitation; explicitly disclaimed as not a 'causal oracle'."}, {"id": "2601_05280_evaluator_endogeneity", "label": "Evaluator Endogeneity", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named as the harder, explicitly unresolved case: broad domains where the evaluator itself (reward model, LLM judge, benchmark) is trained, tunable, or gameable rather than a fixed invariant like a chess win condition."}, {"id": "2601_05280_autonomy_endogenisation", "label": "Autonomy vs Endogenisation Distinction", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reframes the Singularity debate around autonomy (needing less human labor) versus endogenisation (a loop whose targets, evaluators, and evidence are all generated from the same model family with no independent correctness signal)."}, {"id": "2601_05280_falsifiability_condition", "label": "Paper's Stated Falsifiability Condition", "file_type": "rationale", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A purely distributional recursive system achieving sustained, externally-verified improvement across changing domains without any functionally equivalent mechanism-construction step would refute the thesis; systems combining explicit mechanism search with independent verification that outperform matched-compute self-training-only baselines would support it."}, {"id": "2601_05280_distributional_displacement", "label": "Distributional Displacement (introduced quantity)", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly stated not to measure intelligence, labor, or epistemic value; a deliberately narrow toy-model quantity."}, {"id": "2601_05280_cross_entropy_objective", "label": "Cross-Entropy Next-Token Training Objective", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_external_evaluator", "label": "Fixed External Evaluator (e.g., game rules, proof checker)", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Self-play and theorem proving are argued not to be counterexamples to the paper's thesis even with 100% self-generated trajectories, because a genuinely external, non-circular success criterion (game rules, sound proof checker) still supplies verification."}, {"id": "2601_05280_young_witbrock_2024", "label": "Young and Witbrock (2024) - Transformers as approximations of Solomonoff induction", "file_type": "paper", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_wan_mei_2025", "label": "Wan and Mei (2025/2026) - LLMs as computable (surrogate) approximations to Solomonoff induction", "file_type": "paper", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_grau_moya_et_al", "label": "Grau-Moya et al. - meta-training neural predictors on UTM sequences", "file_type": "paper", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_shumailov_et_al", "label": "Shumailov et al. - Nature paper on model collapse under naive recursive replacement", "file_type": "paper", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_dohmatob_et_al", "label": "Dohmatob et al. - scaling-law framing of model collapse", "file_type": "paper", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_gerstgrasser_et_al", "label": "Gerstgrasser et al. - accumulation-based rebuttal to inevitability of collapse", "file_type": "paper", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_pearl_causality", "label": "Pearl - mechanism identification vs distribution fitting (causality)", "file_type": "paper", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_kings_college_london", "label": "King's College London", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_oxford_immune_algorithmics", "label": "Oxford Immune Algorithmics", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2601_05280_london_institute_healthcare_engineering", "label": "London Institute for Healthcare Engineering", "file_type": "concept", "source_file": "2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "2601_05280_paper", "target": "2601_05280_kings_college_london", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2601.05280.md", "source_location": null, "weight": 1.0}, {"source": "2601_05280_paper", "target": "2601_05280_oxford_immune_algorithmics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2601.05280.md", "source_location": null, "weight": 1.0}, {"source": "2601_05280_paper", "target": "2601_05280_london_institute_healthcare_engineering", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2601.05280.md", "source_location": null, "weight": 1.0}, {"source": "2601_05280_paper", "target": "2601_05280_solomonoff_induction", "relation": "refere