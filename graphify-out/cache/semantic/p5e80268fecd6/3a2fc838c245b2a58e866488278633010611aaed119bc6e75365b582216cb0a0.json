{"nodes": [{"id": "2511_09149_paper", "label": "Enabling Agents to Communicate Entirely in Latent Space", "file_type": "paper", "source_file": "2511.09149.md", "source_location": null, "source_url": "https://arxiv.org/abs/2511.09149v5", "captured_at": null, "author": "Zhuoyun Du, Runze Wang, Huiyu Bai, Zouying Cao, Xiaoyong Zhu, Yu Cheng, Bo Zheng, Wei Chen, Haochao Ying", "contributor": null, "rationale": null}, {"id": "2511_09149_interlat", "label": "Interlat (latent-space agent communication)", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": "https://github.com/XiaoDuflying/Interlat", "captured_at": null, "author": null, "contributor": null, "rationale": "Passes raw last-layer hidden states between agents instead of decoding to tokens, avoiding the token bottleneck's information loss."}, {"id": "2511_09149_communication_adapter", "label": "Communication Adapter", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most load-bearing component; removing it collapses task success despite still-fluent text output."}, {"id": "2511_09149_compression_model", "label": "Latent Message Compression Model (M_phi)", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trained to compress hundreds of latent positions to as few as 8 while preserving downstream utility via geometry-alignment loss."}, {"id": "2511_09149_ramesh_li", "label": "Activation grafting/blending (Ramesh and Li 2025)", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_09149_tang_et_al", "label": "Per-token latent deltas (Tang et al. 2025)", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_09149_pham_et_al", "label": "Probability-weighted tokenizer-embedding transmission (Pham et al. 2023)", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_09149_zheng_et_al", "label": "Autoencoder-inferred thought injection (Zheng et al. 2025)", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_09149_paper", "label": "Interlat: Latent Communication for Multi-Agent LLMs (arXiv:2511.09149)", "file_type": "paper", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_09149_interlat", "label": "Interlat (latent hidden-state message passing method)", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transmits last hidden state latent messages directly between agents to avoid discretizing reasoning into text, aiming for higher task success and lower communication latency than a trained natural-language channel."}, {"id": "2511_09149_text_baseline", "label": "Text (trained natural-language CoT communication baseline)", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_09149_no_comm_baseline", "label": "No-Comm baseline (no inter-agent communication)", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_09149_communication_adapter", "label": "Trainable communication adapter", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Removing this adapter collapses ALFWorld success to near zero despite fluent text output, showing it is load-bearing rather than cosmetic."}, {"id": "2511_09149_conditional_thought_separation", "label": "Conditional thought separation training objective", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Penalizes similar outputs under matched versus mismatched auxiliary inputs, to force genuine reliance on the latent signal rather than ignoring it."}, {"id": "2511_09149_staged_perturbation_verification", "label": "Staged-perturbation verification strategy", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Progressively destroys candidate structure (task identity, then higher-order statistics, then all structure) to isolate exactly what the model is sensitive to."}, {"id": "2511_09149_latent_direction_geometry_alignment_loss", "label": "Latent direction geometry alignment loss", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identified as the most critical of three compression training losses for maintaining performance under aggressive latent compression."}, {"id": "2511_09149_math_level5_result", "label": "MATH Level-5 'intriguing inversion' result", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framed as latent superposition permitting broader search versus natural language's forced discretization causing premature collapse on hard problems, though this is a narrow win against a larger aggregate CoT lead."}, {"id": "2511_09149_communication_latency", "label": "Inter-agent communication latency reduction", "file_type": "concept", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_09149_ethical_considerations", "label": "Ethical Considerations: latent channel safety-monitoring risk", "file_type": "rationale", "source_file": "2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fully latent, non-human-readable channel could in principle bypass language-based safety monitoring; mitigation (no training on harmful instructions, preliminary PCA visualization) is acknowledged as limited given the channel's design goal is efficiency via not being decoded into inspectable text."}], "edges": [{"source": "2511_09149_paper", "target": "2511_09149_interlat", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "2511.09149.md", "source_location": null, "weight": 1.0}, {"source": "2511_09149_interlat", "target": "2511_09149_communication_adapter", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2511.09149.md", "source_location": null, "weight": 1.0}, {"source": "2511_09149_interlat", "target": "2511_09149_compression_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2511.09149.md", "source_location": null, "weight": 1.0}, {"source": "2511_09149_paper", "target": "2511_09149_ramesh_li", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.75, "source_file": "2511.0914