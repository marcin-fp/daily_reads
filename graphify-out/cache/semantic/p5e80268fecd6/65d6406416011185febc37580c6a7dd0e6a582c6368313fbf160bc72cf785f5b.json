{"nodes": [{"id": "2310_03716_paper", "label": "A Long Way to Go: Investigating Length Correlations in RLHF", "file_type": "paper", "source_file": "2310.03716.md", "source_location": null, "source_url": "https://arxiv.org/abs/2310.03716v2", "captured_at": null, "author": "Prasann Singhal", "contributor": "Tanya Goyal, Jiacheng Xu, Greg Durrett", "rationale": null}, {"id": "2310_03716_nrg_metric", "label": "Non-Length Reward Gain (NRG) Decomposition", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bucketing outputs by length and measuring within-bucket gain isolates how much reported reward improvement is attributable to length shift versus genuine content quality."}, {"id": "2310_03716_lppo", "label": "LPPO (length-only reward PPO)", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A reward signal with zero quality information is used as a controlled causal test of how much of standard PPO's reported gain is explained by length alone."}, {"id": "2310_03716_dataset_cartography", "label": "Dataset Cartography Analysis", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-example confidence trajectories used to show reward models fail to learn from most training data and default to the rare confidently-learnable length heuristic."}, {"id": "2310_03716_dpo", "label": "Direct Preference Optimization (DPO)", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_hh_rlhf_dataset", "label": "Anthropic HH-RLHF Preference Dataset (arxiv:2204.05862)", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_blenderbot3x", "label": "BlenderBot 3x (arxiv:2306.04707)", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_paper", "label": "RLHF Reward Length Bias Paper", "file_type": "paper", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_nrg_analysis", "label": "Length-stratified NRG analysis", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_length_only_reward_experiment", "label": "Length-only reward substitution experiment", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_dataset_cartography", "label": "Dataset cartography training-dynamics analysis", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_intervention_study", "label": "Anti-length intervention study", "file_type": "concept", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_scale_limitation", "label": "Single base-model family/scale limitation", "file_type": "rationale", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every main experiment uses a single base-model family and scale (LoRA-tuned Llama-7B); the one scale check (Llama-2-13B reward accuracy) showed only marginal improvement and wasn't extended to full PPO/intervention/cartography re-runs, leaving open whether findings generalize to much larger frontier-scale models."}, {"id": "2310_03716_isolated_intervention_limitation", "label": "Interventions tested in isolation limitation", "file_type": "rationale", "source_file": "2310.03716.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each anti-length intervention is tested in isolation rather than combined, leaving open whether stacking interventions (e.g., length-balanced data + high-KL PPO + reward-data augmentation) could close more of the gap than any single intervention alone."}, {"id": "2310_03716_ppo_webgpt_rlcd", "label": "PPO optimization on WebGPT/RLCD preference data", "file_type": "concept", "source_file": "2310.03716.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_reward_gain_length", "label": "Reward gain explained by length increase", "file_type": "concept", "source_file": "2310.03716.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_length_only_reward", "label": "Purely length-based PPO reward", "file_type": "concept", "source_file": "2310.03716.md", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_03716_simulated_preference_win_rate", "label": "Simulated preference win rate comparable to PPO", "file_type": "concept", "source_file": "2310.03716.md", "source_location": "L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2310_0371