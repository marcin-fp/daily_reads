ource_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2311_01906_trockman_kolter_2023", "label": "Trockman & Kolter (2023) - Identity in value-projection product", "file_type": "paper", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2309_08593_paper", "label": "Attention-Only Transformers (2309.08593)", "file_type": "paper", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "1911_03864_paper", "label": "Sandwich Transformer (1911.03864)", "file_type": "paper", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2105_01601_paper", "label": "MLP-Mixer (2105.01601)", "file_type": "paper", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2105_08050_paper", "label": "gMLP (2105.08050)", "file_type": "paper", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2311_01906_paper", "label": "Simplifying Transformer Blocks (arXiv:2311.01906)", "file_type": "paper", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authors explicitly flag scale (100-300M params) as the clearest limitation and note PaLM's parallel-block scaling behavior makes extrapolation to frontier-scale models an open question rather than a safe assumption."}, {"id": "2311_01906_identity_value_projection_matrices", "label": "Identity-fixed value/projec