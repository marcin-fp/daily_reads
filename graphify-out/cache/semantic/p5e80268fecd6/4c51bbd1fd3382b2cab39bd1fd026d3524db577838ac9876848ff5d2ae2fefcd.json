{"nodes": [{"id": "2311_01906_paper", "label": "Simplifying Transformer Blocks", "file_type": "paper", "source_file": "2311.01906.md", "source_location": null, "source_url": "https://arxiv.org/abs/2311.01906v2", "captured_at": "2026-09-17", "author": "Bobby He; Thomas Hofmann", "contributor": null, "rationale": null}, {"id": "2311_01906_eth_zurich", "label": "ETH Zurich", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2311_01906_signal_propagation_theory", "label": "Signal-propagation theory", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2311_01906_shaped_attention", "label": "Shaped Attention", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2311_01906_sas_block", "label": "Simplified Attention Sub-block (SAS)", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2311_01906_sas_p_block", "label": "SAS-Parallel block (SAS-P)", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combination of shaped attention and identity-fixed value/projection matrices preserves inter-block signal well enough to substitute for what a skip connection would otherwise provide."}, {"id": "2311_01906_parallel_transformer_block", "label": "Parallel transformer block (PaLM/ViT-22B style)", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adopted for the MLP sub-block because signal-propagation-motivated techniques (including several Looks Linear variants) still caused significant training-speed loss under Adam when applied directly to the MLP skip connection, so the paper routes around the problem via the pre-existing parallel-block architecture instead of solving it directly."}, {"id": "2311_01906_value_skipinit", "label": "Value-SkipInit", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2311_01906_looks_linear_init", "label": "Looks Linear initialization", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2311_01906_identity_fixed_value_projection", "label": "Identity-fixed value/projection matrices", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empirically justified because (1) when left trainable but downweighted, the residual-to-skip gain ratio spontaneously converges toward zero for most layers, indicating the network doesn't use the extra capacity, and (2) fixing to identity outright achieves slightly better final eval loss (1.178 vs 1.194) than leaving them trainable but downweighted."}, {"id": "2311_01906_normalization_free_block", "label": "Normalization-free simplified block", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2311_01906_gpt_like_decoder_model", "label": "GPT-like decoder-only model", "file_type": "concept", "source_file": "2311.01906.md", "source_location": null, "source_url": null, "captured_at": null, "a