{"nodes": [{"id": "26eva_paper", "label": "I Don't Need Solution. I Need Emotional Support: Empathetic LLMs based on Emotional Validation", "file_type": "paper", "source_file": "26eva.md", "source_location": null, "source_url": "https://aclanthology.org/2026.findings-acl.1/", "captured_at": "2026-09-17", "author": "Suhyune Son, Jungwoo Lim, Myunghoon Kang, Seongtae Hong, Yuna Hur, Evelyn Hayoon Zi, Heuiseok Lim", "contributor": null, "rationale": null}, {"id": "26eva_eva", "label": "EVA (two-stage empathetic validation training method)", "file_type": "concept", "source_file": "26eva.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26eva_evad", "label": "Emotional Validation Aware Dataset (EVAD)", "file_type": "concept", "source_file": "26eva.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Candidate responses generated by GPT-3.5-Turbo then filtered by 12 psychology-background annotators; authors acknowledge this only partially resolves potential circularity between model-generated training data and model-based evaluation."}, {"id": "26eva_evaeval", "label": "EVAEval metric", "file_type": "concept", "source_file": "26eva.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built specifically because per-utterance metrics like EPITOME cannot capture whether supportive behavior appropriately progresses across a multi-turn conversation."}, {"id": "26eva_acq", "label": "Empathy Acquisition (ACQ) stage", "file_type": "concept", "source_file": "26eva.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "26eva_ali", "label": "Emotional Validation Alignment (ALI) stage", "file_type": "concept", "source_file": "26eva.md", "source_location": null, "source_url": null, "ca