{"nodes": [{"id": "2204_05862_paper", "label": "Training a Helpful and Harmless Assistant with RLHF (paper)", "file_type": "paper", "source_file": "2204.05862.md", "source_location": null, "source_url": "https://arxiv.org/abs/2204.05862v1", "captured_at": null, "author": "Yuntao Bai et al.", "contributor": null, "rationale": null}, {"id": "2204_05862_anthropic", "label": "Anthropic", "file_type": "concept", "source_file": "2204.05862.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2204_05862_rlhf", "label": "Reinforcement Learning from Human Feedback (RLHF)", "file_type": "concept", "source_file": "2204.05862.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2204_05862_preferencemodel", "label": "Preference Model (PM)", "file_type": "concept", "source_file": "2204.05862.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2204_05862_hhrlhfdataset", "label": "hh-rlhf helpfulness comparison dataset", "file_type": "concept", "source_file": "2204.05862.md", "source_location": null, "source_url": "https://github.com/anthropics/hh-rlhf", "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2204_05862_harmlessnessdataset", "label": "Harmlessness/red-teaming dataset (unreleased)", "file_type": "concept", "source_file": "2204.05862.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2204_05862_iteratedonlinerlhf", "label": "Iterated online RLHF", "file_type": "concept", "source_file": "2204.05862.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retraining fresh preference models and policies on a weekly cadence, mixing in newly collected online data, was tested via both observational comparison and a controlled experiment isolating dataset size and hyperparameters to confirm the improvement is attributable to the online iteration itself rather than confounds."}, {"id": "2204_05862_alignmenttaxbonus", "label": "Alignment tax vs alignment bonus finding", "file_type": "concept", "source_file": "2204.05862.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2204_05862_sqrtklfinding", "label": "Reward ~ sqrt(KL divergence) regularity", "file_type": "rationale", "source_file": "2204.05862.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Authors offer a conjectural small-perturbation Taylor-expansion argument (KL expands to quadratic order in a policy perturbation; if reward is locally linear, reward should scale as sqrt(KL)) as a plausible but unproven explanation for a robust empirical regularity observed across model sizes and PM configurations, explicitly flagged as not fully explained."}, {"id": "2204_05862_overrefusal_failuremode", "label": "Exaggerated over-refusal failure mode", "file_type": "rationale", "source_file": "2204.05862.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Traced to red-teaming data collection choice: crowdworkers always selected the more harmful of two responses to explore failure modes, teaching models what to avoid but never demonstrating a sophisticated helpful-but-firm response, causing exaggerated unhelpful refusals when harmlessness was over-optimized relative to helpfulness."}, {"id": "2204_05862_oodmahalanobis", "label": "Simplified Relative Mahalanobis distance OOD detection", "file_type": "concept", "source_file": "2204.05862.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rati