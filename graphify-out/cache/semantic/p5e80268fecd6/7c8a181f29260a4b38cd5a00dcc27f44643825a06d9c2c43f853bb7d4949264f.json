{"nodes": [{"id": "2105_08050_paper", "label": "Pay Attention to MLPs", "file_type": "paper", "source_file": "2105.08050.md", "source_location": null, "source_url": "https://arxiv.org/abs/2105.08050v2", "captured_at": null, "author": "Hanxiao Liu", "contributor": "Zihang Dai, David R. So, Quoc V. Le", "rationale": null}, {"id": "2105_08050_gmlp", "label": "gMLP", "file_type": "concept", "source_file": "2105.08050.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolates parallel per-token computation from dynamic content-based self-attention to test whether attention is necessary at all."}, {"id": "2105_08050_spatial_gating_unit", "label": "Spatial Gating Unit (SGU)", "file_type": "concept", "source_file": "2105.08050.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "W initialized near-zero and bias near one so the gate starts as identity, letting the block behave like a plain FFN early in training before gradually learning cross-token interactions."}, {"id": "2105_08050_amlp", "label": "aMLP (gMLP + tiny attention)", "file_type": "concept", "source_file": "2105.08050.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A disproportionately tiny single-head attention module is attached to recover cross-sentence alignment capability cheaply rather than scaling gMLP itself."}, {"id": "2105_08050_mlp_mixer", "label": "MLP-Mixer", "file_type": "concept", "source_file": "2105.08050.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "2105_08050_paper", "target": "2105_08050_gmlp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "2105.08050.md", "source_location": null, "weight": 1.0}, {"source": "2105_08050_gmlp", "targ