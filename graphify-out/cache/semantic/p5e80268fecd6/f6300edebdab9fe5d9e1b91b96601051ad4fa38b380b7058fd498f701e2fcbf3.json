{"nodes": [{"id": "2603_18009_paper", "label": "How Confident Is the First Token? UCPOF Framework (2603.18009)", "file_type": "paper", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_lsfu", "label": "Log-Scale Focal Uncertainty (LSFU)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designed to fix the label-prior blindness of plain first-token entropy by multiplying entropy with a focal-loss-style (1-P_prior)^2 term, suppressing confident-but-common predictions and amplifying rare-label signal, without requiring extra training or forward passes."}, {"id": "2603_18009_ucpof", "label": "UCPOF (Uncertainty-Calibrated Prompt Optimization Framework)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-stage fast-static/slow-reflective pipeline intended to capture most of RAG's accuracy benefit while triggering retrieval on far fewer inputs than an always-on RAG pipeline."}, {"id": "2603_18009_gold_shot", "label": "Gold Shot static exemplar selection", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selects lowest-LSFU correctly-predicted examples as exemplars because they sit near class-cluster centers, providing cleaner teaching examples than boundary cases."}, {"id": "2603_18009_full_rag", "label": "Full RAG (always-on retrieval baseline)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_qwen25_7b", "label": "Qwen2.5-7B-Instruct", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_llama3_8b", "label": "Llama-3-8B-Instruct", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_qwen25_14b", "label": "Qwen2.5-14B-Instruct", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_ace", "label": "ACE benchmark", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_casie", "label": "CASIE benchmark", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_agnews", "label": "AgNews benchmark", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_sst5", "label": "SST5 benchmark", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discordant boundary case: near-chance LSFU AUC (0.5242) and no UCPOF accuracy gain, where removing the focal-prior term slightly improved rather than hurt accuracy."}, {"id": "2603_18009_cb", "label": "CB benchmark", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_reuters21578", "label": "Reuters-21578 (R8) benchmark", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_self_refine", "label": "Self-Refine / self-consistency (Madaan et al.)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_semantic_entropy", "label": "Semantic entropy (Kuhn et al.)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_clark_entropy", "label": "Top-K logit entropy (Clark et al.)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_lin_confidence", "label": "Black-box confidence (Lin et al.)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_sharma_chopra", "label": "Sequence-level entropy (Sharma & Chopra)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_active_rag", "label": "Active RAG", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_yuan_adaptive_cot", "label": "Instance-adaptive zero-shot CoT (Yuan et al.)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_dong_retrieval_timing", "label": "Intrinsic response-planning for retrieval timing (Dong et al.)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_12201_indexcache", "label": "IndexCache (2603.12201)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shares the general strategy of using a cheap model-internal signal to convert an always-on cost into a conditionally-triggered one, though validated with a more rigorous search-and-ablation protocol than UCPOF's single 90%-coverage heuristic."}, {"id": "2603_18009_paper", "label": "First-Token Entropy Uncertainty Estimation Paper (LSFU/UCPOF)", "file_type": "paper", "source_file": "2603.18009.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2603_18009_lsfu", "label": "Label-Prior Modulated First-Token Entropy (LSFU)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": "L421", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Incorporates a squared label-prior modulation term into first-token entropy to improve discrimination between correct and incorrect predictions."}, {"id": "2603_18009_discrimination_improvement", "label": "Improved Correct/Incorrect Prediction Discrimination", "file_type": "concept", "source_file": "2603.18009.md", "source_location": "L421", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introducing P_prior consistently improves AUC across datasets on the main model, average AUC rising from 0.7429 without prior to 0.7555 with prior."}, {"id": "2603_18009_lowest_lsfu_selection", "label": "Lowest-LSFU Few-Shot Exemplar Selection", "file_type": "concept", "source_file": "2603.18009.md", "source_location": "L397", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Selecting exemplars with lowest LSFU (rather than highest or random) chosen to maximize average classification accuracy."}, {"id": "2603_18009_higher_avg_accuracy", "label": "Higher Average Classification Accuracy", "file_type": "concept", "source_file": "2603.18009.md", "source_location": "L397", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lowest LSFU gold shot selection yields the best average accuracy of 73.81 percent; highest LSFU selection substantially reduces accuracy on the most challenging datasets."}, {"id": "2603_18009_ucpof_gating", "label": "Uncertainty-Gated Retrieval-Augmented Correction (UCPOF gating)", "file_type": "concept", "source_file": "2603.18009.md", "source_location": "L366", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gates retrieval-augmented correction by an uncertainty threshold rather than always triggering retrieval, to avoid injecting irrelevant/misleading context."}, {"id": "2603_18009_avoidance_accuracy_collapse", "label": "Avoidance of Accuracy Collapse Under Unconditional Retrieval", "file_type": "concept", "source_file": "2603.18009.md", "source_location": "L366", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full RAG collapses to 48.21 percent accuracy on CB versus 78.57 percent for the fixed baseline; UCPOF avoids this by retrieving only when first-token uncertainty indicates risk."}, {"id": "2603_18009_near_chance_auc", "label": "Near-Chance First-Token Confidence AUC", "file_type": "concept", "source_file": "2603.18009.md", "source_location": "L421", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On SST5 the LSFU AUC is 0.5242, essentially indistinguishable from chance."}, {"id": "2603_18009_negligible_benefit", "label": "Negligible Benefit from LSFU-Driven Prompt Optimization", "file_type": "concept", "source_file": "2603.18009.md", "source_location": "L421", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UCPOF accuracy on SST5 is nearly identical to the random exemplar baseline across every reported table, implied by near-chance discriminative AUC."}], "edges": [{"source": "2603_18009_paper", "target": "2603_18009_lsfu", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "2603.18009.md", "source_location": null, "weight": 1.0}, {"source": "2603_18009_paper", "target": "2603_18009_ucpof", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "2603.18009.md", "source_location": null, "weight": 1.0}, {"source": "2603_18009_ucpof", "target": "2603_18009_lsfu", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2603.18009.md", "source_location": null, "weight": 1.0}, {"source": "2603_18009_ucpof", "target": "2603_18009_gold_shot", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "2603.18009.md", "source_location": null, "weight": 1.0}, {"source": "2603_18009_gold_shot", "target": "2603_18009_lsfu", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 0.85, "source_file": "2603.18009.md", "source_location": null, "weight": 1.0}, {"source": "2603_18009_paper", "target": "2603_18009_full_rag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 0.9, "source_file": "2603.18009.md", "source_location": null, "weight": 1.0}, {"source": "2603_18009_ucpof", "target": "2603_18009_full_rag", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 0.8, "source_file": "2603.18009.md", "