{"nodes": [{"id": "2502_07408_paper", "label": "Maximal Brain Damage Without Data or Optimization: Disrupting Neural Networks via Sign-Bit Flips", "file_type": "paper", "source_file": "2502.07408.md", "source_location": null, "source_url": "https://arxiv.org/abs/2502.07408v2", "captured_at": null, "author": ["Ido Galil", "Moshe Kimhi", "Ran El-Yaniv"], "contributor": null, "rationale": null}, {"id": "2502_07408_dnl", "label": "Deep Neural Lesion (DNL) attack method", "file_type": "concept", "source_file": "2502.07408.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One flip per kernel is enforced because two flips within the same kernel can partially cancel each other's effect, whereas spreading flips across kernels compounds damage; early layers are preferred because they are empirically most damaging, analogous to early sensory lesions causing outsized downstream impairment."}, {"id": "2502_07408_1p_dnl", "label": "1P-DNL (one-pass gradient-refined variant)", "file_type": "concept", "source_file": "2502.07408.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows a single forward-backward pass to compute a hybrid magnitude+Gauss-Newton-Hessian score, reframing classical pruning saliency criteria as adversarial scores instead."}, {"id": "2502_07408_selective_bit_protection_defense", "label": "Selective bit-protection defense", "file_type": "concept", "source_file": "2502.07408.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses the same critical-parameter identification that powers the attack, repurposed as a defense that shields only the highest-scoring sign bits."}, {"id": "2502_07408_bfa", "label": "BFA (Rakin et al., 2019) - Bit-Flip Attack", "file_type": "concept", "source_file": "2502.07408.md", "source_location": null, "source_url": null,