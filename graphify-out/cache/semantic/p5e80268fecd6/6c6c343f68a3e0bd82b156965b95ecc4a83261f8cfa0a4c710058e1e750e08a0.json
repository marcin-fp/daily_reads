{"nodes": [{"id": "2512_04695_trinity", "label": "TRINITY Coordinator", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposes that a tiny frozen backbone plus a small linear head reading only hidden states can carry enough signal for competent multi-agent coordination, decoupling coordination competence from raw generation competence."}, {"id": "2512_04695_qwen3_0_6b_backbone", "label": "Frozen Qwen3-0.6B Backbone", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04695_linear_head", "label": "Linear Coordination Head (~10K params)", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04695_singular_value_finetuning", "label": "Singular-Value Fine-Tuning", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adapts only singular values from SVD of selected backbone layers to sharpen internal representations for coordination without full fine-tuning."}, {"id": "2512_04695_sep_cma_es", "label": "sep-CMA-ES Training Algorithm", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over standard policy-gradient RL because the reward is sparse, per-step evaluation is expensive, and the parameter space exhibits block-\u03b5-separability, making a diagonal-covariance evolutionary strategy a better fit than noisy global-return RL."}, {"id": "2512_04695_block_epsilon_separability", "label": "Block-\u03b5-Separability Hypothesis", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04695_reinforce_baseline", "label": "REINFORCE Baseline", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04695_sft_baseline", "label": "Supervised Fine-Tuning Baseline", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Competitive on single-turn gains but does not scale well to multi-turn setting due to cost of generating full multi-turn demonstration labels."}, {"id": "2512_04695_random_search_baseline", "label": "Random Search Baseline", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04695_llm_as_coordinator_baseline", "label": "LLM-as-Coordinator Baseline (Gemini 2.5 Pro)", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Included to isolate whether TRINITY's value comes from training specifically rather than from simply having a capable model available to coordinate; the prompted model struggles to consistently track and weigh seven agents' strengths without reward-driven training."}, {"id": "2512_04695_tri_role_protocol", "label": "Thinker/Worker/Verifier Role Protocol", "file_type": "paper", "source_file": "2512.04695.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2512_04695_dataset_agent_selection", "label": "Joint Dataset-Agent Subset Selection (Appendix A.6)", "file_type": 