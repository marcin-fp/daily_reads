{"nodes": [{"id": "2602_06613_paper", "label": "DAVE: Distribution-aware Attribution via ViT Gradient Decomposition", "file_type": "paper", "source_file": "2602.06613.md", "source_location": null, "source_url": "https://arxiv.org/abs/2602.06613v1", "captured_at": "2026-09-17", "author": "Adam Wr\u00f3bel, Siddhartha Gairola, Jacek Tabor, Bernt Schiele, Bartosz Zieli\u0144ski, Dawid Rymarczyk", "contributor": null, "rationale": "Method-level verification via appendix derivations and sensitivity ablations is commended, but the paper's Conclusion framing ('consistently outperforms') slightly overclaims relative to the one clear loss (Chefer-LRP on ViT-B/16 Energy Pointing Game) reported transparently only in the results table; motivating high-stakes domains (medical, autonomous driving) are never evaluated."}, {"id": "2602_06613_dave", "label": "DAVE (Distribution-aware Attribution via ViT gradient decomposition)", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decomposes ViT input gradient into a stable effective transformation and a noisy operator-variation term, discarding the latter to reduce grid-like patch artifacts, then further cleans the result via equivariance averaging and low-pass Gaussian smoothing."}, {"id": "2602_06613_effective_transformation", "label": "Effective Transformation component", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_operator_variation", "label": "Operator Variation term", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identified as the source of high-frequency, input-sensitive noise in ordinary gradient-based ViT attributions; discarded by DAVE."}, {"id": "2602_06613_reynolds_averaging", "label": "Reynolds-inspired equivariance averaging", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Averages effective transformation over small rotations (\u00b120\u00b0), translations and flips; \u00b120\u00b0 range calibrated via a rotation-sensitivity ablation measuring actual model output change, rather than chosen a priori."}, {"id": "2602_06613_low_pass_filtering", "label": "Low-pass Gaussian smoothing step", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Analogous to SmoothGrad but applied to the already-cleaned effective transformation rather than raw gradients; smoothing scale calibrated via a noise-sensitivity ablation, noting ViT-B/16 is more noise-sensitive than DeiT-III-B/16."}, {"id": "2602_06613_gridpg", "label": "Grid Pointing Game benchmark", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_energypg", "label": "Energy Pointing Game benchmark", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_pixel_deletion_faithfulness", "label": "Pixel-deletion faithfulness curves", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reported only as qualitative visual comparison of curves without a tabulated single-number summary (e.g. AUC), a gap relative to the paper's otherwise precise quantitative reporting."}, {"id": "2602_06613_imagenet1k", "label": "ImageNet-1k", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_vit_b16", "label": "ViT-B/16", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_deit_b16", "label": "DeiT-B/16", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_deit3_b16", "label": "DeiT-III-B/16", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_dino_b16", "label": "DINO ViT-B/16 (self-supervised)", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_bcos_vit", "label": "B-cos ViT", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_bcos_vit_c", "label": "B-cos ViT-C", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_input_x_gradient", "label": "Input\u00d7Gradient", "file_type": "concept", "source_file": "2602.06613.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_06613_integrated_gradients", "label": "Integrated Gradients", "file_type": "concept", "source_file": "2602.06613.md", "source_l