{"nodes": [{"id": "2511_05963_paper", "label": "Next-Latent Prediction Transformers Learn Compact World Models", "file_type": "paper", "source_file": "2511.05963.md", "source_location": null, "source_url": "https://arxiv.org/abs/2511.05963v4", "captured_at": null, "author": "Jayden Teoh", "contributor": null, "rationale": null}, {"id": "2511_05963_nextlat", "label": "NextLat (Next-Latent Prediction)", "file_type": "code", "source_file": "2511.05963.md", "source_location": null, "source_url": "https://github.com/JaydenTeoh/NextLat", "captured_at": null, "author": null, "contributor": null, "rationale": "Trains transformer hidden states to be predictable step-to-step, provably forcing belief-state formation, without architecture changes or loss of training parallelism."}, {"id": "2511_05963_belief_state_theorem", "label": "Belief-state convergence theorem (Theorem 3.2)", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guarantee holds already at rollout horizon of one; longer horizons only add gradient signal, not a stronger guarantee."}, {"id": "2511_05963_latent_dynamics_model", "label": "Latent dynamics MLP model", "file_type": "code", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lightweight MLP jointly trained with stop-gradient Smooth L1 loss to regress next hidden state; enables latent-only rollout for speculative decoding."}, {"id": "2511_05963_jtp", "label": "JTP (Joint multi-token prediction, competing method)", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Belief-state guarantee requires prediction horizon at least the data's observability horizon, often impractically large for long-context text."}, {"id": "2511_05963_bst", "label": "Belief State Transformers (BST)", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Achieves similar guarantee but at quadratic gradient cost, training two full transformer encoders, over 3x slower to train."}, {"id": "2511_05963_mtp", "label": "Multi-token prediction (MTP) baseline", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_05963_manhattan_taxi_task", "label": "Manhattan taxi-ride world-modeling benchmark", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_05963_countdown_task", "label": "Countdown arithmetic-reasoning benchmark", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NextLat avoids the 'regretful compromise' failure pattern where a model realizes too late it cannot reach the target."}, {"id": "2511_05963_path_star_task", "label": "Path-Star lookahead-planning benchmark", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designed to expose the 'Clever Hans cheat' where transformers exploit local shortcuts rather than genuinely planning ahead."}, {"id": "2511_05963_a5_experiment", "label": "A5 permutation state-tracking experiment", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small co-trained latent dynamics model generalizes to 36-token sequences (95%+ accuracy) even though its parent transformer, provably bounded by TC0 expressivity, fails, an open question rather than a proven general result."}, {"id": "2511_05963_speculative_decoding", "label": "Variable-length self-speculative decoding", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Latent rollout can draft further than its training horizon since belief-state convergence does not depend on that horizon, yielding up to 3.3x inference speedup."}, {"id": "2511_05963_finewebedu_scaling", "label": "1.3B-parameter FineWeb-Edu scaling experiment", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accuracy gains modest and inconsistent at scale; authors state larger models might be needed for clearer gains."}, {"id": "2511_05963_tinystories_probe", "label": "TinyStories linear-probe analysis", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2511_05963_self_predictive_rl", "label": "Self-predictive representation learning (RL tradition)", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "microsoft_research", "label": "Microsoft Research", "file_type": "concept", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2508_17627_reasoning_dynamics", "label": "Reasoning Dynamics / RCP paper (arXiv:2508.17627)", "file_type": "paper", "source_file": "2511.05963.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "cont