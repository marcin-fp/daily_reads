{"nodes": [{"id": "2602_11908_paper", "label": "When Should LLMs Be Less Specific? Selective Abstraction for Reliable Long-Form Text Generation", "file_type": "paper", "source_file": "2602.11908.md", "source_location": null, "source_url": "https://arxiv.org/abs/2602.11908v3", "captured_at": null, "author": "Shani Goren, Ido Galil, Ran El-Yaniv", "contributor": "Technion, NVIDIA", "rationale": "Abstract highlights the largest single AURC improvement (27.73%) which is computed only against the weakest baseline (Redaction), while comparisons against Inline/Self-Revision rest on single-point risk-at-matched-coverage evidence rather than full AURC; 'consistently' language in Results glosses over one small negative exception (Llama-3.3-70B vs Inline on FactScore)."}, {"id": "2602_11908_selective_abstraction", "label": "Selective Abstraction (general framework)", "file_type": "concept", "source_file": "2602.11908.md"}, {"id": "2602_11908_atomwise_selective_abstraction", "label": "Atom-wise Selective Abstraction", "file_type": "concept", "source_file": "2602.11908.md", "rationale": "Instantiates Selective Abstraction at the level of individual atomic claims so a single response can mix fully-specific, partially-abstracted, and abstained content rather than one all-or-nothing decision."}, {"id": "2602_11908_claim_decomposition", "label": "Claim Decomposition into Atomic Claims", "file_type": "concept", "source_file": "2602.11908.md"}, {"id": "2602_11908_verbalized_confidence", "label": "Verbalized Confidence Scoring", "file_type": "concept", "source_file": "2602.11908.md", "rationale": "Chosen over logprob-based and P(True) scores because ranking quality (AUROC), not surface plausibility, most directly predicts whether the information budget is spent wisely."}, {"id": "2602_11908_conformal_calibration", "label": "Split Conformal Threshold Calibration", "file_type": "concept", "source_file": "2602.11908.md", "rationale": "Grounded in split conformal prediction to give a formal guarantee that true risk stays within alpha \u00b1 epsilon with probability at least 1-delta, avoiding ad hoc threshold picking."}, {"id": "2602_11908_risk_coverage_curve", "label": "Risk-Coverage Curve / AURC", "file_type": "concept", "source_file": "2602.11908.md"}, {"id": "2602_11908_entity_narrowing_information_measure", "label": "Entity-Narrowing Information Measure", "file_type": "concept", "source_file": "2602.11908.md", "rationale": "Treats a claim as a subject-independent predicate narrowing a reference entity set, giving a comparability across claims not tied to a fixed set of alternative-granularity answers to one question."}, {"id": "2602_11908_fact_checking_pipeline", "label": "Agentic Wikipedia Fact-Checking Pipeline", "file_type": "concept", "source_file": "2602.11908.md", "rationale": "Uses free Wikipedia API instead of paid search API; validated against 102 human-labeled claims (F1 0.93) to justify use as ground-truth oracle."}, {"id": "2602_11908_spinach", "label": "SPINACH (NL-to-SPARQL agent)", "file_type": "concept", "source_file": "2602.11908.md"}, {"id": "2602_11908_wikidata", "label": "Wikidata", "file_type": "concept", "source_file": "2602.11908.md", "rationale": "Entity-count estimates from Wikidata via SPINACH are noted by the authors as sparse and not covering all entities, yet this half of the pipeline is not independently spot-checked the way the fact-checking agent is."}, {"id": "2602_11908_wikipedia", "label": "Wikipedia (fact-checking source)", "file_type": "concept", "source_file": "2602.11908.md"}, {"id": "2602_11908_factscore", "label": "FactScore Benchmark", "file_type": "concept", "source_file": "2602.11908.md"}, {"id": "2602_11908_longfact_objects", "label": "LongFact-Objects Benchmark", "file_type": "concept", "source_file": "2602.11908.md"}, {"id": "2602_11908_selective_redaction", "label": "Selective Redaction (baseline)", "file_type": "concept", "source_file": "2602.11908.md"}, {"id": "2602_11908_inline_abstraction", "lab