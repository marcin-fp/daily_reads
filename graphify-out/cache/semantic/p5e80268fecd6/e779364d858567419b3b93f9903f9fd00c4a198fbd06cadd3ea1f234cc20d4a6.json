{"nodes": [{"id": "2607_27191_paper", "label": "Can AI agents conduct open-ended AI research? Early evidence from two case studies", "file_type": "paper", "source_file": "2607.27191.md", "source_location": null, "source_url": "https://arxiv.org/abs/2607.27191v2", "captured_at": null, "author": "Kirgis et al.", "contributor": null, "rationale": null}, {"id": "2607_27191_shadow_evaluation", "label": "Shadow evaluation (method)", "file_type": "concept", "source_file": "2607.27191.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introduced because verifiable-task benchmarks exclude open-ended research and AI-authored blind peer-review submissions inherit peer review's own documented unreliability; shadow evaluation instead uses the original authors' months of domain expertise to grade an agent's answer to their own unpublished research question."}, {"id": "2607_27191_generator_verifier_gap", "label": "Generator-verifier gap", "file_type": "concept", "source_file": "2607.27191.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named because a verifier that reliably rejects bad research could in principle power fast RL-driven improvement, but with only true-negative test cases the paper cannot establish whether the verifier is discerning quality or merely uniformly harsh."}, {"id": "2607_27191_failure_modes", "label": "Five agentic research failure modes", "file_type": "concept", "source_file": "2607.27191.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_27191_personas_case_study", "label": "Personas paper shadow-evaluation case study", "file_type": "concept", "source_file": "2607.27191.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_27191_tabpfn_ca