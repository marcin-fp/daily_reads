{"nodes": [{"id": "2606_10917_roleagent", "label": "Role-Agent: Bootstrapping LLM Agents via Dual-Role Evolution", "file_type": "paper", "source_file": "2606.10917.md", "source_location": null, "source_url": "https://arxiv.org/abs/2606.10917v2", "captured_at": null, "author": "Xucong Wang et al.", "contributor": null, "rationale": null}, {"id": "2606_10917_wia", "label": "World-In-Agent (WIA) predictive reward module", "file_type": "concept", "source_file": "2606.10917.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predictive reward is combined with task reward multiplicatively rather than additively, so accurate future-state prediction amplifies/discounts existing task-reward credit but cannot itself create credit for an action that earned no task reward, preventing plausible-but-false self-predictions from being rewarded independently."}, {"id": "2606_10917_aiw", "label": "Agent-In-World (AIW) failure-mode-based curriculum retrieval", "file_type": "concept", "source_file": "2606.10917.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retrieves replay tasks by shared underlying failure mechanism rather than surface task similarity or random replay, targeting the specific error pattern the agent just exhibited."}, {"id": "2606_10917_gigpo", "label": "GiGPO (state-grouped GRPO baseline, Feng et al. 2025)", "file_type": "concept", "source_file": "2606.10917.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2606_10917_roleagent", "label": "Role-Agent", "file_type": "document", "source_file": "2606.10917.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "2606_10917_roleagent", "target": "2606_10917_wia", "relation": "references", "confidence":