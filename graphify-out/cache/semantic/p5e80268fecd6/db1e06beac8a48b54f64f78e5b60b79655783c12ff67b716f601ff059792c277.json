{"nodes": [{"id": "2604_27251_paper", "label": "Compliance vs. Sensibility: On the Reasoning Controllability in Large Language Models", "file_type": "paper", "source_file": "2604.27251.md", "source_location": null, "source_url": "https://arxiv.org/abs/2604.27251v3", "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_reasoning_conflict", "label": "Reasoning Conflict (compliance vs. sensibility)", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formalized to study whether models obey a mismatched reasoning-type instruction or default to task-appropriate reasoning."}, {"id": "2604_27251_compliance", "label": "Compliance (matching instructed reasoning type)", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_sensibility", "label": "Sensibility (matching task-appropriate reasoning type)", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preference for sensibility over compliance predicts correct final answers, reframing 'disobedience' as a reliability feature."}, {"id": "2604_27251_lexical_mimicking", "label": "Lexical Mimicking judge vulnerability", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chain-of-thought can echo an instructed reasoning type's vocabulary without performing the corresponding logical operation, requiring the judge to be hardened against it; explicit type definitions/options actually reduced human agreement."}, {"id": "2604_27251_task_neglect", "label": "Task-neglect side effect of positive steering", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positive steering toward compliance on abductive instructions makes the model so focused on steered reasoning style that it fails output-formatting constraints, hurting accuracy."}, {"id": "2604_27251_decodability_gap", "label": "Instruction vs. behavior decodability gap", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gap between decodability of instructed type vs. judge-inferred behavioral type is a family-dependent signature (largest for LLaMA, smallest for Qwen), proposed as a general mechanistic diagnostic for instruction-following gaps."}, {"id": "2604_27251_llm_as_judge", "label": "LLM-as-judge reasoning type classifier", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_linear_probing", "label": "Linear probing of residual-stream activations", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_cka", "label": "Centered Kernel Alignment representation-similarity analysis", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_caa", "label": "Contrastive Activation Addition steering", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Steering vector isolates the compliance signal by matching pairs for correctness and instructed type; positive steering raises compliance but hurts accuracy on abductive tasks via task-neglect, while negative steering consistently improves accuracy, suggesting steering toward sensibility is more useful than toward compliance."}, {"id": "2604_27251_p_true_confidence", "label": "p(True) internal confidence estimation", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_folio", "label": "FOLIO benchmark (deduction)", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_spr", "label": "SPR benchmark (induction)", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_alphanli", "label": "\u03b1NLI benchmark (abduction)", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_recv", "label": "RECV benchmark (mixed deduction/abduction, claim verification)", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_gpt51", "label": "GPT-5.1", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2604_27251_gemini3flash", "label": "Gemini3-Flash", "file_type": "concept", "source_file": "2604.27251.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "ratio