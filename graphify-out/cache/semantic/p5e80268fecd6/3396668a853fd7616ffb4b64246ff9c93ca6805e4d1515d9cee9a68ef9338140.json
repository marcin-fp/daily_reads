, {"id": "2509_14786_lm_eval_ensemble", "label": "Evaluation code for ensemble downstream benchmarks (lm-eval-ensemble)", "file_type": "code", "source_file": "2509.14786.md", "source_location": null, "source_url": "https://github.com/konwook/lm-eval-ensemble", "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_marin_framework", "label": "Marin pretraining framework", "file_type": "code", "source_file": "2509.14786.md", "source_location": null, "source_url": "https://marin.community", "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_dclm_seed_corpus", "label": "200M-token DCLM seed corpus (and 400M/800M/1.7B variants)", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_standard_recipe", "label": "Standard data-constrained recipe (epoch repetition + parameter scaling)", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_regularization_recipe", "label": "Heavy-regularization recipe (tuned weight decay, LR, epochs)", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard recipe overfits under a fixed data budget, so weight decay ~30x default is used to restore monotonic power-law scaling."}, {"id": "2509_14786_monotonic_loss_scaling", "label": "Monotone power-law loss scaling in parameter count", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_asymptote_methodology", "label": "Asymptote-based recipe comparison methodology", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen instead of fixed-compute-budget comparison because with genuinely unlimited compute a practitioner would scale until marginal benefit vanishes."}, {"id": "2509_14786_ensembling_recipe", "label": "Ensembling recipe (K independent models, logit averaging)", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimal single-model hyperparameters differ from ensemble-optimal ones; tuning specifically for the infinite-ensemble asymptote (more epochs, less weight decay per member) improves the asymptote further."}, {"id": "2509_14786_joint_scaling_recipe", "label": "Joint scaling recipe (regularization + ensembling, both taken to infinity)", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses an experimentally-motivated heuristic (~2x epochs, 0.5x weight decay per member) to translate single-model-optimal hyperparameters to ensemble-optimal ones rather than a full independent hyperparameter search at every scale, since that search proved computationally impractical."}, {"id": "2509_14786_distillation_recipe", "label": "Sequence-level knowledge distillation from ensemble to single student", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_self_distillation", "label": "Self-distillation on real+synthetic token mixture", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixing real tokens with synthetic teacher-generated tokens, rather than training purely on model-generated text, is argued to be the key difference from collapse-inducing setups in prior literature."}, {"id": "2509_14786_model_collapse_concept", "label": "Model collapse from recursive self-generated training data", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_data_scaling_laws", "label": "Data scaling laws across token counts (200M-1.7B)", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2509_14786_cpt_experiment", "label": "Continued pre-training transfer experiment (Llama 3.2 3B on MegaMath-Web-Pro)", "file_type": "concept", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "muennighoff2023_epoch_scaling_law", "label": "Muennighoff et al. 2023 epoch-scaling law", "file_type": "paper", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "kaplan2020_scaling_laws", "label": "Kaplan et al. 2020 scaling laws", "file_type": "paper", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "hoffmann2022_chinchilla", "label": "Hoffmann et al. 2022 (Chinchilla)", "file_type": "paper", "source_file": "2509.14786.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "allen_zhu_li2023_multiview", "label": "Allen-Zhu and Li 2023 multi-view ensembling theory", "file_type": "paper", "source_file": "2509.