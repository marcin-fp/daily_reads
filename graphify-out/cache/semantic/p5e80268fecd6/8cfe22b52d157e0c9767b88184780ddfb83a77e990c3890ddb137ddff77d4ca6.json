{"nodes": [{"id": "2211_09085_paper", "label": "Galactica: A Large Language Model for Science (paper)", "file_type": "paper", "source_file": "2211.09085.md", "source_location": null, "source_url": "https://arxiv.org/abs/2211.09085v1", "captured_at": null, "author": ["Ross Taylor", "Marcin Kardas", "Guillem Cucurull", "Thomas Scialom", "Anthony Hartshorn", "Elvis Saravia", "Andrew Poulton", "Viktor Kerkez", "Robert Stojnic"], "contributor": null, "rationale": null}, {"id": "2211_09085_galactica", "label": "Galactica (LLM for science)", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Central bet: a curated, high-quality, multi-epoch corpus can let a comparatively small model outperform much larger general-purpose language models on technical knowledge and reasoning tasks; the 120B model was deliberately capped in size so inference fits on a single A100 node for downstream accessibility."}, {"id": "2211_09085_curated_corpus", "label": "Curated 106B-token scientific pretraining corpus", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate contrast to the uncurated-crawl paradigm used by GPT-3, OPT and PaLM; the paper notes 50% of PaLM's corpus is social media conversation of limited transfer value to scientific tasks, motivating a 'normative' curated-data paradigm instead."}, {"id": "2211_09085_prompt_pretraining", "label": "Prompt pre-training", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixing 358M tokens of task-formatted prompts directly into the general pretraining mix rather than as a separate instruction-tuning stage, to boost task performance at smaller model scale without needing a >1 trillion-token corpus or larger model."}, {"id": "2211_09085_working_memory_token", "label": "<work> working memory token", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human-written chain-of-thought text in the wild typically omits intermediate steps done via internal mental calculation; purpose-built prompt datasets explicitly include the normally-omitted steps to close the reasoning gap, optionally offloading arithmetic to an executed Python script (not actually used in the reported experiments)."}, {"id": "2211_09085_citation_token", "label": "[START_REF]/[END_REF] citation tokenization", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Title-based identifiers were chosen over alphanumeric IDs after ablation, despite titles being more hallucination-prone at smaller scale."}, {"id": "2211_09085_repeated_token_training", "label": "Multi-epoch (repeated-token) training finding", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contradicts prior scaling-law literature (Hernandez et al. 2022) suggesting repeated tokens harm performance; validation loss and BIG-bench accuracy kept improving through >4 epochs for all model sizes, with only the 120B model beginning to overfit at the start of epoch five. Two untested candidate explanations offered: a 'quality factor' from curation or a 'modality factor' specific to scientific data, without adjudicating between them."}, {"id": "2211_09085_citation_prediction", "label": "Citation prediction task", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framed as evidence that weight-based context association can outperform retrieval infrastructure; distributional analysis shows predicted citation-count distribution converges toward the true empirical distribution with model size, though popularity bias persists even at 120B."}, {"id": "2211_09085_toxicity_bias_evaluation", "label": "Toxicity and bias evaluation (CrowS-Pairs, StereoSet, RealToxicityPrompts)", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paper attributes lower stereotypical bias and toxicity directly to the scientific corpus's lower base rate of discriminatory or toxic text relative to corpora drawing on sources like Reddit."}, {"id": "2211_09085_truthfulqa", "label": "TruthfulQA evaluation", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Galactica exceeds OPT and BLOOM but the paper is explicit that 'absolute performance is still low,' concluding a curated corpus alone does not solve the truthfulness problem."}, {"id": "2211_09085_verification_limitation", "label": "Verification future-work limitation", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paper's own future-work item stating that even as language models become more accurate with scale, assurances of correctness and factuality are needed; framed as future infrastructure work rather than a solved or centrally load-bearing part of this paper's own evaluation, and in tension with how the model was subsequently used in a public demo."}, {"id": "2211_09085_latex_probe", "label": "LaTeX equation knowledge probe", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluated via manual, unblinded human judgment given possibility of multiple correct forms; no reported inter-annotator agreement despite being among the paper's most widely quoted results."}, {"id": "2211_09085_overfitting_expectation", "label": "Prior scaling-law overfitting expectation (repeated tokens)", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2211_09085_retrieval_baselines", "label": "Sparse/dense retrieval baselines (ElasticSearch, Contriever)", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2211_09085_mmlu", "label": "MMLU benchmark", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2211_09085_math_benchmark", "label": "MATH benchmark", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2211_09085_pubmedqa", "label": "PubMedQA benchmark", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2211_09085_medmcqa", "label": "MedMCQA benchmark", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2211_09085_big_bench", "label": "BIG-bench benchmark", "file_type": "concept", "source_file": "2211.09085.md", "source_location": null, "source_url": null, "captured_at": null, "