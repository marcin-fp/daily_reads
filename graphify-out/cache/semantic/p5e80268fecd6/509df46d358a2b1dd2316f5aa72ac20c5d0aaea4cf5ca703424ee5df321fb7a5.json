{"nodes": [{"id": "2510_26887_paper", "label": "The Denario project: Deep knowledge AI agents for scientific discovery", "file_type": "paper", "source_file": "2510.26887.md", "source_location": null, "source_url": "https://arxiv.org/abs/2510.26887v1", "captured_at": null, "author": "Francisco Villaescusa-Navarro", "contributor": null, "rationale": null}, {"id": "2510_26887_denario", "label": "Denario multi-agent system", "file_type": "code", "source_file": "2510.26887.md", "source_location": null, "source_url": "https://github.com/AstroPilot-AI/Denario", "captured_at": null, "author": null, "contributor": null, "rationale": "Designed as a modular architecture so modules can run independently or be chained end-to-end, supporting both fully autonomous and human-in-the-loop use."}, {"id": "2510_26887_idea_module", "label": "Idea module (propose-critique loop)", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idea-maker paired against idea-hater agent, motivated by prior findings that multi-agent idea generation is judged more novel than single-agent generation."}, {"id": "2510_26887_literature_module", "label": "Literature module", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept deliberately separate from the autonomous pipeline so a human decides whether an idea is truly original."}, {"id": "2510_26887_methods_module", "label": "Methods module", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_26887_analysis_module", "label": "Analysis module (Planning & Control)", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Borrows Planning & Control strategy from robotics: plan decomposed into subtasks, executed and monitored by dedicated agents with automatic retry."}, {"id": "2510_26887_paper_module", "label": "Paper module", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_26887_review_module", "label": "Review module (LLM referee)", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_26887_ag2", "label": "AG2 orchestration framework", "file_type": "code", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_26887_langgraph", "label": "LangGraph orchestration framework", "file_type": "code", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_26887_cmbagent", "label": "CMBAgent (prior authors' system)", "file_type": "code", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_26887_peptide_failure", "label": "Cyclic-peptide fabricated-result failure case", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paper-writing agent produced a complete paper claiming success despite no working numerical solver in the code; authors stress code/data verification, not just narrative reading, is essential."}, {"id": "2510_26887_math_failure", "label": "Pure-mathematics imitation-without-substance failure case", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five generated papers exhibited surface form of mathematical writing without real proofs, coherent logic, or correctly-used citations."}, {"id": "2510_26887_domain_expert_scoring", "label": "Domain-expert quality scoring (Fig. 11)", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly caveated by authors as informal and not a rigorous evaluation criterion; scorer independence/blinding not disclosed."}, {"id": "2510_26887_independent_reproduction", "label": "Independent code-blind reproduction check", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A domain expert reimplemented an astrophysics analysis without access to Denario's own code and obtained closely matching results, guarding against circular self-verification."}, {"id": "2510_26887_homogenization_concern", "label": "Homogenization concern (Sec. 7.1)", "file_type": "rationale", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "System struggles to propose genuinely novel research questions or notice serendipitous findings, tending toward research confirming/extending training-data literature."}, {"id": "flatiron_institute", "label": "Flatiron Institute", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "princeton_university", "label": "Princeton University", "file_type": "concept", "source_file": "2510.26887.md", "source_location": null, "sou