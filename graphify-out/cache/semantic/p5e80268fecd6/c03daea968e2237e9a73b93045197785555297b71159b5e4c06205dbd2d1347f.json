{"nodes": [{"id": "2607_07508_paper", "label": "Single-Rollout Asynchronous Optimization for Agentic Reinforcement Learning", "file_type": "paper", "source_file": "2607.07508.md", "source_location": null, "source_url": "https://arxiv.org/abs/2607.07508v1", "captured_at": null, "author": "Zhenyu Hou, Yujiang Li, Jie Tang, Yuxiao Dong", "contributor": null, "rationale": null}, {"id": "2607_07508_sao", "label": "Single-rollout Asynchronous Optimization (SAO)", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces group-comparison advantage estimation with a single rollout plus trained value model to remove group-wise synchronization barriers in asynchronous training."}, {"id": "2607_07508_dis", "label": "Direct Importance Sampling (DIS)", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sidesteps the infeasibility of tracking every intermediate old-policy checkpoint by using the rollout engine's own logged probabilities directly as the importance-sampling denominator, with a stricter double-sided token-level clipping window."}, {"id": "2607_07508_faster_value_update", "label": "Faster value update (K=2 critic updates per policy update)", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An inaccurate, lagging value estimate is the primary source of noisy advantages and destructive updates in single-rollout training."}, {"id": "2607_07508_frozen_attention_value_training", "label": "Frozen-attention value model training", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critic gradient norms are dramatically larger and less stable in attention layers; pretrained attention weights already know how to attend to relevant tokens."}, {"id": "2607_07508_skip_observation_gae", "label": "Skip-observation token-level GAE", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids injecting noise from asking the value function to predict environment-observation-state values it has no basis to have learned."}, {"id": "2607_07508_grpo", "label": "GRPO (group relative policy optimization)", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_vapo", "label": "VAPO baseline", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_areal", "label": "AReaL asynchronous RL infrastructure", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_roll_flash", "label": "ROLL Flash rollout-train decoupling", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_mobilerl", "label": "MobileRL difficulty-adaptive GRPO", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_qwen3_30b_a3b", "label": "Qwen3-30B-A3B", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_glm_5_2", "label": "GLM-5.2 (750B-A40B)", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_paper", "label": "SAO: Single-Rollout Asynchronous Optimization for Agentic RL", "file_type": "paper", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_sao", "label": "SAO (single-rollout + trained value model advantage estimation)", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces group-wise (GRPO-style) advantage estimation with single-rollout sampling plus a well-trained value model to improve stability and accuracy in asynchronous agentic RL."}, {"id": "2607_07508_grpo", "label": "GRPO-style group-wise advantage estimation baseline", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_value_model", "label": "Trained value model (advantage baseline)", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used as a fast-updating advantage baseline to track a genuinely non-stationary reward signal better than a running-mean baseline."}, {"id": "2607_07508_single_rollout_sampling", "label": "Single-rollout sampling", "file_type": "concept", "source_file": "2607.07508.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2607_07508_frozen_attention_value_model", "label": "