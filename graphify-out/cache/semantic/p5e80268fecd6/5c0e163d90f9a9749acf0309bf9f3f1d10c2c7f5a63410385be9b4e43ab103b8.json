{"nodes": [{"id": "2602_07824_paper", "label": "Data Darwinism Part I: Unlocking the Value of Scientific Data for Pre-training", "file_type": "paper", "source_file": "2602.07824.md", "source_location": null, "source_url": "https://arxiv.org/abs/2602.07824v1", "captured_at": "2026-09-18", "author": "Yiwei Qin, Zhen Huang, Tiantian Mi, Weiye Si, Chenyang Zhou, Qipeng Guo, Siyuan Feng, Pengfei Liu", "contributor": null, "rationale": null}, {"id": "2602_07824_data_darwinism_taxonomy", "label": "Data Darwinism Taxonomy (L0-L9)", "file_type": "concept", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Categorizes data-processing operations by degree of transformation and human- vs model-driven authorship, from selection/discard (L0-L3) to active rewriting (L4-L5) to speculative future stages (L6-L9)."}, {"id": "2602_07824_learnability_gap", "label": "Learnability Gap Finding", "file_type": "concept", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw or lightly-filtered scientific text (L0-L3) provides negligible pre-training value despite high information density because implicit reasoning and assumed background knowledge make it opaque as training signal, decoupling 'information density' from 'learnability'."}, {"id": "2602_07824_l4_generative_refinement", "label": "L4: Generative Refinement", "file_type": "concept", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses GPT-OSS-120B on ~256-token chunks to delete non-academic noise and repair formatting while explicitly constrained to add no external knowledge."}, {"id": "2602_07824_l5_cognitive_completion", "label": "L5: Cognitive Completion", "file_type": "concept", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies reasoning reconstruction, terminological explication, and pedagogical bridging using Qwen3-235B-A22B-Instruct on 1024-token windows, applied only to papers for cost reasons; isolates incremental value beyond L4 format cleanup."}, {"id": "2602_07824_darwin_science_corpus", "label": "Darwin-Science Corpus", "file_type": "document", "source_file": "2602.07824.md", "source_location": null, "source_url": "https://github.com/GAIR-NLP", "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_07824_darwin_science_eval", "label": "Darwin-Science-Eval Benchmark", "file_type": "document", "source_file": "2602.07824.md", "source_location": null, "source_url": "https://github.com/GAIR-NLP", "captured_at": null, "author": null, "contributor": null, "rationale": "Built to evaluate domain-specific comprehension beyond standard benchmarks; entirely LLM-generated and LLM-filtered by Qwen3-32B with no reported independent human validation, raising same-family-judge risk."}, {"id": "2602_07824_davinci_origin_3b", "label": "daVinci-origin-3B", "file_type": "code", "source_file": "2602.07824.md", "source_location": null, "source_url": "https://github.com/GAIR-NLP", "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_07824_davinci_origin_7b", "label": "daVinci-origin-7B", "file_type": "code", "source_file": "2602.07824.md", "source_location": null, "source_url": "https://github.com/GAIR-NLP", "captured_at": null, "author": null, "contributor": null, "rationale": "From-scratch, contamination-free base model excluding scientific content, enabling unambiguous attribution of Sci-Mix gains to the data intervention rather than unknown prior checkpoint exposure."}, {"id": "2602_07824_sci_mix_experiment", "label": "Sci-Mix Continued Pre-training Experiment", "file_type": "concept", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controlled CPT comparing Baseline vs 50% Darwin-Science mixture (1:2 book:paper ratio) from a 930B-token checkpoint, designed to isolate the causal effect of scientific-data processing level on model performance."}, {"id": "2602_07824_ablation_study", "label": "Per-Level Ablation Study", "file_type": "concept", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Staged L0-L3 vs L4 vs L4+L5 comparison designed to demonstrate that gains derive from specific processing levels rather than an unspecified 'more processing is better' effect; results are single-run per configuration, so point estimates should be read cautiously."}, {"id": "2602_07824_gpt_oss_120b", "label": "GPT-OSS-120B", "file_type": "code", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_07824_qwen3_235b", "label": "Qwen3-235B-A22B-Instruct", "file_type": "code", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_07824_qwen3_32b", "label": "Qwen3-32B", "file_type": "code", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_07824_olmocr_7b", "label": "olmOCR-7B", "file_type": "code", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2602_07824_eai_distill_0_5b", "label": "EAI-Distill-0.5B", "file_type": "code", "source_file": "2602.07824.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rat