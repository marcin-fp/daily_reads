{"nodes": [{"id": "2105_01601_paper", "label": "MLP-Mixer: An all-MLP Architecture for Vision (paper)", "file_type": "paper", "source_file": "2105.01601.md", "source_location": null, "source_url": "https://arxiv.org/abs/2105.01601v4", "captured_at": null, "author": "Ilya Tolstikhin et al.", "contributor": null, "rationale": null}, {"id": "2105_01601_mlpmixer", "label": "MLP-Mixer architecture", "file_type": "concept", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designed to test whether convolutional locality or self-attention are actually necessary for strong vision performance by replacing both with simplest possible shared-weight MLPs, using architectural minimalism as a scientific instrument to determine load-bearing vs conventional design choices."}, {"id": "2105_01601_tokenmixingmlp", "label": "Token-mixing MLP", "file_type": "concept", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2105_01601_channelmixingmlp", "label": "Channel-mixing MLP", "file_type": "concept", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2105_01601_vit", "label": "Vision Transformer (ViT)", "file_type": "concept", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2105_01601_bit", "label": "BiT (Big Transfer, ResNet-based)", "file_type": "concept", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2105_01601_googleresearch", "label": "Google Research (Brain Team)", "file_type": "concept", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2105_01601_permutationinvariance_finding", "label": "Permutation-invariance robustness finding", "file_type": "rationale", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixer degrades ~45% under global pixel shuffling vs ~75% for ResNet, suggesting absence of a strong positional prior translates into measurable robustness rather than only being an accuracy cost, since Mixer's token-mixing MLPs are inherently sensitive to input order only via a fixed shared permutation."}, {"id": "2105_01601_negativeresults_appendix", "label": "Appendix A negative results (untying, grouping, pyramid)", "file_type": "rationale", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Untying token-mixing MLP parameters across channels, channel grouping, and pyramidal resolution reduction were tried as promising modifications but yielded no improvement, inconsistent small gains, or failed to transfer across data scales, reported explicitly as negative results for transparency about what was tried and did not help."}, {"id": "2105_01601_sandwichtransformer_ref", "label": "Sandwich Transformer paper (1911.03864)", "file_type": "paper", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2105_01601_architecturalminimalism", "label": "Architectural minimalism as scientific instrument", "file_type": "concept", "source_file": "2105.01601.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}], "edges": [{"source": "2105_01601_paper", "target": "2105_01601_vit", "relation": "cites", "confidence": "EXTRACTED