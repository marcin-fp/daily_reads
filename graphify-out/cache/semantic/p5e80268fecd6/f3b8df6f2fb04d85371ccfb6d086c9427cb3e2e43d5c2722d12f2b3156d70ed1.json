{"nodes": [{"id": "2510_01171_paper", "label": "Verbalized Sampling: How to Mitigate Mode Collapse and Unlock LLM Diversity", "file_type": "paper", "source_file": "2510.01171.md", "source_location": null, "source_url": "https://arxiv.org/abs/2510.01171v4", "captured_at": null, "author": "Jiayi Zhang, Simon Yu, Derek Chong, Anthony Sicilia, Michael R. Tomz, Christopher D. Manning, Weiyan Shi", "contributor": null, "rationale": null}, {"id": "2510_01171_typicality_bias", "label": "Typicality Bias", "file_type": "concept", "source_file": "2510.01171.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "People systematically prefer familiar, predictable, easy-to-process text over unusual text independent of quality; formalized as log-probability under a reference base model, fitted positively significant on HelpSteer preference pairs."}, {"id": "2510_01171_mode_collapse", "label": "Mode Collapse", "file_type": "concept", "source_file": "2510.01171.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_01171_verbalized_sampling", "label": "Verbalized Sampling (VS)", "file_type": "concept", "source_file": "2510.01171.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designed to counteract typicality bias in preference data causing mode collapse, by eliciting a probability distribution over candidates rather than a single instance, exploiting annotators' competing preference for representative distributions when a distribution is explicitly requested."}, {"id": "2510_01171_chakraborty2024", "label": "Chakraborty et al. 2024 (reward-model-inadequacy account)", "file_type": "document", "source_file": "2510.01171.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "2510_01