{"nodes": [{"id": "2606_13392_msa_paper", "label": "MiniMax Sparse Attention", "file_type": "paper", "source_file": "2026-06-09/2606.13392.md", "source_location": null, "source_url": "https://arxiv.org/abs/2606.13392", "captured_at": "2026-06-09", "author": "Xunhao Lai et al.", "contributor": null, "rationale": "Technical paper on efficient sparse attention mechanism for ultra-long-context LLMs, addressing quadratic attention cost bottleneck"}, {"id": "2606_13392_msa_architecture", "label": "MiniMax Sparse Attention Architecture", "file_type": "concept", "source_file": "2026-06-09/2606.13392.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-branch sparse attention: lightweight Index Branch selects top-k KV blocks per GQA group, Main Branch performs exact attention on selected blocks"}, {"id": "2606_13392_index_branch", "label": "Index Branch Component", "file_type": "concept", "source_file": "2026-06-09/2606.13392.md", "source_location": "Section 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lightweight indexer that scores KV blocks and selects top-k for each GQA group using max-pooling over token-level scores"}, {"id": "2606_13392_main_branch", "label": "Main Branch Component", "file_type": "concept", "source_file": "2026-06-09/2606.13392.md", "source_location": "Section 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard scaled dot-product softmax attention restricted to tokens in blocks selected by Index Branch"}, {"id": "2606_13392_kl_loss", "label": "KL Alignment Loss", "file_type": "concept", "source_file": "2026-06-09/2606.13392.md", "source_location": "Section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auxiliary training objective matching Index Branch selection distribution to Main Branch attention on selected tokens