{"nodes":[{"id":"2026_acl_long_204_multimodal_rag","label":"Multimodal RAG for Document Understanding Survey","file_type":"paper","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Comprehensive survey of multimodal retrieval-augmented generation methods for document understanding, covering retrieval modalities, granularity, and hybrid approaches"},{"id":"2026_acl_long_204_open_domain_rag","label":"Open-Domain Multimodal RAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.1","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Retrieves from large corpora of domain-specific documents; uses vision-language models for efficient encoding; examples: DSE, ColPali, M3DocRAG"},{"id":"2026_acl_long_204_closed_domain_rag","label":"Closed-Domain Multimodal RAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.1","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Focuses on single document; retrieves most relevant pages/segments; addresses context window limitations; examples: SV-RAG, FRAG, CREAM"},{"id":"2026_acl_long_204_image_based_retrieval","label":"Image-Based Retrieval Modality","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Encodes document pages as images using VLM vision encoders; efficient but limited textual detail; used by ColPali, VisRAG, DSE"},{"id":"2026_acl_long_204_image_text_retrieval","label":"Image+Text-Based Retrieval Modality","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Combines page images with OCR text or VLM-generated summaries; richer retrieval at higher processing cost; used by VisDoMRAG, HM-RAG, PREMIR"},{"id":"2026_acl_long_204_page_level_granularity","label":"Page-Level Retrieval Granularity","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.3","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Treats entire pages as atomic retrieval units; simpler but less precise; most early multimodal RAG methods use this approach"},{"id":"2026_acl_long_204_element_level_granularity","label":"Element-Level Retrieval Granularity","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.3","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Decomposes pages into tables, charts, images, text blocks; enables fine-grained grounding; examples: VRAG-RL, MG-RAG, MARA, Region-RAG"},{"id":"2026_acl_long_204_graph_based_rag","label":"Graph-Based Multimodal RAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.4","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Represents multimodal content as explicit graph with nodes (pages, text spans, tables) and edges (semantic, spatial, contextual relations); examples: HM-RAG, mKG-RAG, RECON"},{"id":"2026_acl_long_204_agent_based_rag","label":"Agent-Based Multimodal RAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.4","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Employs autonomous agents for query decomposition, retrieval orchestration, and evidence verification; examples: ViDoRAG, HM-RAG, Patho-AgenticRAG, HEAR"},{"id":"2026_acl_long_204_docvqa","label":"DocVQA Dataset","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 4","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"50K queries on 12,767 document images; foundational benchmark for document visual question answering"},{"id":"2026_acl_long_204_m3docvqa","label":"M3DocVQA Benchmark","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 4","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"~40K queries on ~3,368 documents; open-domain multimodal RAG benchmark with ~41M visual tokens"},{"id":"2026_acl_long_204_opendocvqa","label":"OpenDocVQA Benchmark","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Section 4","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"206K queries on 43K documents; large-scale open-domain benchmark with ~206M visual tokens"},{"id":"2026_acl_long_204_colpali","label":"ColPali Method","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Table 2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Vision-language model for efficient document retrieval; uses PaliGemma-3B and SigLIP encoder; open-domain, page-level, image-based"},{"id":"2026_acl_long_204_cream","label":"CREAM Method","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Table 2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Coarse-to-fine multimodal retrieval with attention-pooling; closed-domain, page-level, image+text modality"},{"id":"2026_acl_long_204_visrag","label":"VisRAG Method","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Table 2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Vision-based retrieval for multimodal documents; open-domain, page-level, image-based"},{"id":"2026_acl_long_204_hm_rag","label":"HM-RAG Method","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Table 2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Hierarchical multi-agent framework with graph-based indexing; open-domain, page-level, image+text, with agent and graph enhancements"},{"id":"2026_acl_long_204_premir","label":"PREMIR Method","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Table 2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Matches queries against QA pairs for charts; open-domain, element-level, image+text modality"},{"id":"2026_acl_long_204_retrieval_metrics","label":"Retrieval Evaluation Metrics","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Appendix B.1","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Top-K Accuracy, Recall@K, Precision@K, F1@K, MRR, nDCG used to evaluate retrieval performance"},{"id":"2026_acl_long_204_generation_metrics","label":"Generation Evaluation Metrics","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":"Appendix B.2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"EM, ANLS, PNLS, G-Acc used to evaluate quality of generated answers conditioned on retrieved context"},{"id":"2026_acl_long_204_multimodal_rag","label":"Multimodal RAG for Document Understanding","file_type":"paper","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Survey paper on retrieval-augmented generation systems for visually rich documents, covering retrieval metrics, generation evaluation, training objectives, and industrial deployment challenges."},{"id":"2026_acl_long_204_mrr_metric","label":"MRR@K Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Emphasizes position of first relevant item in ranking; used by Adjali et al. and Nguyen et al. (2024) to measure retrieval effectiveness."},{"id":"2026_acl_long_204_ndcg_metric","label":"nDCG@K Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Penalizes relevant items appearing lower in ranking; used by Zhao et al. (2025) and Faysse et al. (2024) to reward systems surfacing high-quality evidence earlier."},{"id":"2026_acl_long_204_bleu_metric","label":"BLEU Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Soft matching metric based on n-gram overlap with brevity penalty; earliest approach to generation quality evaluation (Papineni et al., 2002)."},{"id":"2026_acl_long_204_rouge_metric","label":"ROUGE Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Soft matching metric evaluating n-gram overlap; widely used in summarization tasks (Lin, 2004)."},{"id":"2026_acl_long_204_meteor_metric","label":"METEOR Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Soft matching metric emphasizing semantic matching beyond exact n-gram overlap; incorporates stemming, synonym matching, and word order penalties (Banerjee and Lavie, 2005)."},{"id":"2026_acl_long_204_exact_match_metric","label":"Exact Match (EM) Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Strict matching metric computing percentage of predictions exactly matching reference answers (Rajpurkar et al., 2016)."},{"id":"2026_acl_long_204_anls_metric","label":"ANLS Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Strict matching metric providing soft evaluation of string-based answers using Levenshtein distance (Biten et al., 2019)."},{"id":"2026_acl_long_204_pnls_metric","label":"PNLS Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Partial Normalized Levenshtein Similarity generalizing ANLS by relaxing alignment requirement; avoids penalizing extra prefixes/suffixes (Chen et al., 2024a)."},{"id":"2026_acl_long_204_bertscore_metric","label":"BERTScore Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Semantic matching metric leveraging contextual embeddings from pretrained language models; captures semantic similarity beyond lexical overlap (Devlin et al., 2019)."},{"id":"2026_acl_long_204_gacc_metric","label":"G-Acc Metric","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Semantic matching metric extending evaluation to free-form answers emphasizing reasoning and contextual completeness (Ma et al., 2024c)."},{"id":"2026_acl_long_204_colbert_loss","label":"ColBERT-style Contrastive Loss","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Common training objective in multimodal RAG combining late interaction mechanism with contrastive learning; encourages higher similarity for positive pairs than in-batch negatives (Khattab and Zaharia, 2020)."},{"id":"2026_acl_long_204_colpali","label":"ColPali","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"OCR-free approach embedding document page images into multi-vector representations with late interaction matching (Faysse et al., 2024)."},{"id":"2026_acl_long_204_visrag","label":"VisRAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"VLM-based RAG pipeline embedding documents as images to preserve multimodal information and avoid text-parsing loss (Yu et al., 2024)."},{"id":"2026_acl_long_204_ragflow","label":"RAGFlow","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Enterprise-grade RAG engine with agents, document processing (DeepDoc), graph-based retrieval, and rich UI for production deployments (InfiniFlow, 2023)."},{"id":"2026_acl_long_204_llamaindex","label":"LlamaIndex","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"General framework for building RAG and agentic systems over arbitrary data sources with extensive connectors and ecosystem (LlamaIndex, 2025)."},{"id":"2026_acl_long_204_graph_rag","label":"Graph-based RAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Paradigm converting documents into graph structures for multi-hop reasoning and hallucination reduction through coherent evidence paths (Peng et al., 2024)."},{"id":"2026_acl_long_204_graphrag","label":"GraphRAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Uses LLMs to directly construct graphs from original text organized through hierarchical community detection for document-level reasoning (Edge et al., 2024)."},{"id":"2026_acl_long_204_agent_rag","label":"Agent-based RAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Reframes RAG as agent-based pipeline where LLM-based agents actively control query rewriting, retrieval, and answer generation through planning and tool use (Singh et al., 2025)."},{"id":"2026_acl_long_204_vidarag","label":"ViDoRAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Multi-agent framework with exploration, summarization, and reflection agents traversing visually rich corpora to progressively refine retrieval results (Wang et al., 2025b)."},{"id":"2026_acl_long_204_hmrag","label":"HM-RAG","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Hierarchical multi-agent architecture treating graph database as retrieval modality in parallel with unstructured text and web sources, aggregating results via consistency voting (Liu et al., 2025b)."},{"id":"2026_acl_long_204_docvqa","label":"DocVQA Dataset","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Large-scale dataset from UCSF Industry collections highlighting gap between human and model performance on structured document understanding (Mathew et al., 2021)."},{"id":"2026_acl_long_204_infovqa","label":"InfoVQA Dataset","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Diverse infographic QA dataset benchmarking models on reasoning over layout, text, and visuals (Mathew et al., 2022)."},{"id":"2026_acl_long_204_tatdqa","label":"TAT-DQA Dataset","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Financial reports dataset with semi-structured tables and text requiring discrete numerical reasoning (Zhu et al., 2022)."},{"id":"2026_acl_long_204_vidore","label":"ViDoRe Dataset","file_type":"concept","source_file":"2026-06-09/26mdocrag.md","source_location":null,"source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Unifies academic tasks with diverse document types and practical tasks across multiple domains and languages for comprehensive multimodal document retrieval evaluation (Faysse et al., 2024)."}],"edges":[{"source":"2026_acl_long_204_multimodal_rag","target":"2026_acl_long_204_open_domain_rag","relation":"conceptually_related_to","confidence":"EXTRACTED","confidence_score":1.0,"source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.1","weight":1.0},{"source":"2026_acl_long_204_multimodal_rag","target":"2026_acl_long_204_closed_domain_rag","relation":"conceptually_related_to","confidence":"EXTRACTED","confidence_score":1.0,"source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.1","weight":1.0},{"source":"2026_acl_long_204_multimodal_rag","target":"2026_acl_long_204_image_based_retrieval","relation":"conceptually_related_to","confidence":"EXTRACTED","confidence_score":1.0,"source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.2","weight":1.0},{"source":"2026_acl_long_204_multimodal_rag","target":"2026_acl_long_204_image_text_retrieval","relation":"conceptually_related_to","confidence":"EXTRACTED","confidence_score":1.0,"source_file":"2026-06-09/26mdocrag.md","source_location":"Section 3.2","weight":1.0},{"source":"2026_acl_long_204_multimodal_rag","target":"2026_acl_long_204_page_level_granularity","relation":"conceptually_related_to","confidence":"E