{"nodes": [{"id": "arxiv_2601_05280", "label": "LLMs as Shannon Lossy Compressors vs Solomonoff Induction", "file_type": "paper", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": "https://arxiv.org/abs/2601.05280v4", "captured_at": "2026-05-06", "author": "Hector Zenil", "contributor": null, "rationale": "Argues that cross-entropy loss does not implement Solomonoff induction; recursive self-improvement requires symbolic model synthesis and non-circular evaluation, not just recursive generation."}, {"id": "concept_symbolic_model_synthesis", "label": "Symbolic Model Synthesis", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Functional requirement for recursive self-improvement: construction, manipulation and testing of explicit generative structures (programs, equations, causal models) against independent criteria."}, {"id": "concept_model_collapse", "label": "Model Collapse in Recursive Training", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Degenerative loss or distortion arising in recursively trained generative models; depends on update rule and data-retention scheme, not synthetic data alone."}, {"id": "concept_epistemic_openness", "label": "Epistemic Openness", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architectural property of remaining answerable to non-circular correction; system must preserve channels through which hypotheses remain testable against constraints not regenerated from own distribution."}, {"id": "method_coding_theorem_method", "label": "Coding Theorem Method (CTM)", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finite computational method estimating algorithmic probability by enumerating small programs and measuring output frequencies; approximates Solomonoff induction within specified machine and runtime regime."}, {"id": "method_block_decomposition_method", "label": "Block Decomposition Method (BDM)", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Greedy algorithm extending CTM to larger objects by decomposing into smaller components and reusing local algorithmic-complexity estimates; bridges local estimates to larger structured data."}, {"id": "method_algorithmic_information_dynamics", "label": "Algorithmic Information Dynamics (AID)", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Studies changes in estimated algorithmic information under controlled perturbations to analyze structural contribution, dynamical organization and reprogram mability of mechanisms."}, {"id": "concept_solomonoff_induction", "label": "Solomonoff Induction", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idealised formal framework assigning predictive weight through mixture over programs weighted by 2^(-|p|); defines principled direction for searching generative explanations."}, {"id": "concept_data_processing_inequality", "label": "Data-Processing Inequality (DPI)", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Information-theoretic bound: post-processing cannot create additional mutual information beyond that in inputs; foundational constraint but does not determine which finite procedures expose useful structure."}, {"id": "concept_grounding", "label": "Grounding in Recursive Training", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Corrective influence supplied by information or constraints not reducible to neutral reproduction of current model distribution; can arise from external data, experiments, formal verification, or invariant criteria."}, {"id": "loss_cross_entropy", "label": "Cross-Entropy Loss", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard next-token objective for LLM pretraining; optimizes fit to supplied conditional distribution rather than implementing Solomonoff induction."}, {"id": "concept_recursive_self_improvement", "label": "Recursive Self-Improvement", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Process where improvements to system increase its capacity to produce further improvements; requires directional criterion beyond recursive generation."}, {"id": "concept_ai_singularity", "label": "AI Singularity / Intelligence Explosion", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hypothetical transition where positive-feedback loop produces intelligence beyond ordinary forecasting; requires reliable operator mapping present state to demonstrably better successor."}, {"id": "concept_model_synthesis_neurosymbolic", "label": "Neurosymbolic Model Synthesis", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hybrid approach combining neural proposal generation with symbolic structure manipulation and independent verification; enables mechanism search beyond statistical fitting."}, {"id": "concept_epistemic_closure", "label": "Epistemic Closure", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Loop where candidate generation, training targets and evaluation become increasingly endogenous; prevents system from improving representation of world or discovering new objectives."}, {"id": "concept_information_accessibility", "label": "Resource-Bounded Information Accessibility", "file_type": "concept", "source_file": "2026-05-06/2601.05280.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operational distinction between global information ceiling (DPI) and what finite procedures can make usable; increased computation can improve access without violating conservation."}], "edges": [{"source": "arxiv_2601_05280", "target": "concept_symbolic_model_synthesis", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-05-06/2601.05280.md", "source_location": null, "weight": 1.0}, {"source": "arxiv_2601_05280", "target": "concept_model_collapse", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-05-06/2601.05280.md", "source_location": null, "weight": 1.0}, {"source": "arxiv_2601_05280", "target": "concept_epistemic_openness", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file":