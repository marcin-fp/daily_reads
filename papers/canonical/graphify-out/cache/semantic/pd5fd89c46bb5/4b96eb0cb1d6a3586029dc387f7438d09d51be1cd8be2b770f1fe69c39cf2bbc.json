{"nodes": [{"id": "2609_03430", "label": "Random Attention: Rethinking KV Cache Eviction for Efficient Reasoning", "file_type": "paper", "source_file": "2026-06-09/2609.03430.md", "source_location": null, "source_url": "https://arxiv.org/abs/2609.03430", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Demonstrates that random KV cache eviction with prompt protection matches or exceeds learned selection signals, showing that selection scoring contributes minimal value beyond protecting the prompt."}, {"id": "method_random_attention", "label": "Random Attention", "file_type": "concept", "source_file": "2026-06-09/2609.03430.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KV cache eviction policy that keeps the prompt and evicts uniformly at random within each attention head, computing no selection score."}, {"id": "benchmark_math500", "label": "MATH500", "file_type": "concept", "source_file": "2026-06-09/2609.03430.md", "source_location": "Section 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mathematical reasoning benchmark with 500 problems used to evaluate KV cache eviction methods."}, {"id": "benchmark_gpqa", "label": "GPQA-Diamond", "file_type": "concept", "source_file": "2026-06-09/2609.03430.md", "source_location": "Section 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Graduate-level question-answering benchmark with 198 problems for evaluating reasoning capabilities."}, {"id": "baseline_snapkv", "label": "SnapKV", "file_type": "concept", "source_file": "2026-06-09/2609.03430.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "KV cache eviction method that scores positions by recent-window attention, baseline for comparison."}, {"id": "baseline_r_kv", "label": "R-KV", "fil