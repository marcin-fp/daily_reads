{"nodes": [{"id": "arxiv_2311_01906", "label": "Simplifying Transformer Blocks", "file_type": "paper", "source_file": "2026-06-09/2311.01906.md", "source_url": "https://arxiv.org/abs/2311.01906v2", "captured_at": "2026-06-09", "author": "Bobby He, Thomas Hofmann", "rationale": "Demonstrates that standard transformer blocks can be simplified by removing skip connections, value/projection parameters, and normalization layers while maintaining training speed, using signal propagation theory and empirical validation."}, {"id": "signal_propagation_theory", "label": "Signal Propagation Theory", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Theoretical framework studying evolution of activation inner products at initialization to identify pathologies in deep networks; used to motivate architectural simplifications while maintaining trainability."}, {"id": "transformer_architecture", "label": "Transformer Architecture", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "skip_connections", "label": "Skip Connections in Neural Networks", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "attention_mechanism", "label": "Self-Attention Mechanism", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "shaped_attention", "label": "Shaped Attention", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Modified attention matrix initialization with trainable parameters to maintain identity-like behavior at initialization for better signal propagation in skipless transformers."}, {"id": "pre_ln_block", "label": "Pre-LN Transformer Block", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "sas_block", "label": "Simplified Attention Sub-block", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Skipless attention sub-block with identity-initialized value and projection parameters, reducing parameters by 50% while maintaining training speed."}, {"id": "sas_p_block", "label": "SAS-Parallel Block", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Combines simplified attention with parallel MLP sub-blocks, removing all skip connections while achieving 16% throughput improvement."}, {"id": "rank_collapse", "label": "Rank Collapse", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Signal degeneracy in skipless networks where activation inner products converge to values independent of inputs, harming trainability."}, {"id": "value_skipinit", "label": "Value-SkipInit", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Modification to self-attention matrix with trainable scalars initialized to encourage identity-like behavior for signal propagation in skipless transformers."}, {"id": "crammed_bert", "label": "Crammed BERT", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "glue_benchmark", "label": "GLUE Benchmark", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "parallel_transformer_block", "label": "Parallel Transformer Block", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Architecture computing MLP and attention sub-blocks in parallel for efficiency, with single skip connection combining outputs."}, {"id": "downweighting_residuals", "label": "Downweighting Residual Branches", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Technique of reducing learning rates or parameter updates on residual branches to improve signal propagation in deep networks."}, {"id": "orthogonal_initialization", "label": "Orthogonal Initialization", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "identity_initialization", "label": "Identity Initialization", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Initializing weight matrices to identity, shown to outperform orthogonal initialization in skipless attention sub-blocks."}, {"id": "adamw_optimizer", "label": "AdamW Optimizer", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "throughput_efficiency", "label": "Training Throughput Efficiency", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Wall-clock runtime performance metric showing simplified transformers achieve 16% faster training than standard Pre-LN blocks."}, {"id": "per_update_convergence", "label": "Per-Update Convergence Speed", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Training speed measured in loss reduction per gradient step, independent of hardware efficiency."}, {"id": "depth_scaling_experiments", "label": "Depth Scaling Experiments", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md", "rationale": "Testing simplified blocks at depths 18 to 72 layers to validate scalability and improved performance with depth."}, {"id": "encoder_decoder_architectures", "label": "Encoder-Decoder Architectures", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "masked_language_modeling", "label": "Masked Language Modeling", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "next_token_prediction", "label": "Next-Token Prediction", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "codeparrot_dataset", "label": "CodeParrot Dataset", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}, {"id": "pile_dataset", "label": "Pile Dataset", "file_type": "concept", "source_file": "2026-06-09/2311.01906.md"}], "edges": [{"source": "arxiv_2311_01906", "target": "signal_propagation_theory", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2311.01906.md"}, {"source": "arxiv_2311_01906", "target": "transformer_architecture", "r