{"nodes": [{"id": "2608_28444_sliding_window_attention", "label": "Sliding-Window Beats Linear Attention", "file_type": "paper", "source_file": "2026-06-09/2608.28444.md", "source_location": null, "source_url": "https://arxiv.org/abs/2608.28444v1", "captured_at": "2026-06-09", "author": "Alexia Jolicoeur-Martineau, Rhea Sanjay Sukthanker, Pashmina Cameron, Emy Gervais", "contributor": null, "rationale": "Demonstrates that Sliding Window Attention (SWA) with sinks outperforms post-trained linear attention models across multiple LLMs and benchmarks without requiring post-training."}, {"id": "2608_28444_swa_with_sinks", "label": "Sliding Window Attention with Sinks", "file_type": "concept", "source_file": "2026-06-09/2608.28444.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attends to k previous tokens plus first 4 tokens (sinks); training-free; achieves 93.2% MMLU recovery and 99.0% average benchmark recovery without post-training."}, {"id": "2608_28444_linear_attention", "label": "Linear Attention Methods", "file_type": "concept", "source_file": "2026-06-09/2608.28444.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduces time/memory complexity from quadratic to linear via kernel approximation \u03c6; requires training from scratch or extensive post-training; lower expressivity and untractable forgetting problem."}, {"id": "2608_28444_lolcats", "label": "LoLCATs (Low-Rank Linearizing)", "file_type": "concept", "source_file": "2026-06-09/2608.28444.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combines linear attention with small SWA; post-trains with 40M tokens using LoRA; recovers 83.2% MMLU and 97.5% average performance."}, {"id": "2608_28444_hedgehog_kernel", "label": "Hedgehog Kernel", "file_type": "concept", "source_file": "2026-06-09/2608.28444.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Learnable projection followed by dual-sided exponential transformation; provides expressiveness, spikiness, monotonicity for linear attention."}, {"id": "2608_28444_needle_in_haystack", "label": "Single Needle-in-a-Haystack (S-NIAH)", "file_type": "concept", "source_file": "2026-06-09/2608.28444.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long-context reasoning task; SWA recovers 17-23% of full attention at 4K context vs. 0.8-5.8% for LoLCATs/Liger-GLA."}, {"id": "2608_28444_babilong", "label": "BABILong Benchmark", "file_type": "concept", "source_file": "2026-06-09/2608.28444.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long-context reasoning; SWA recovers 25% at 4K context vs. 5% for LoLCATs."}, {"id": "2608_28444_flashattention", "label": "FlashAttention", "file_type": "code", "source_file": "2026-06-09/2608.28444.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend for FA and SWA; enables efficient attention computation."}, {"id": "2608_28444_thunderkittens", "label": "ThunderKittens", "file_type": "code", "source_file": "2026-06-09/2608.28444.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backend for linear attention and LoLCATs; fused SWA + linear-attention kernel."}], "edges": [{"source": "2608_28444_sliding_window_attention", "target": "2608_28444_swa_with_sinks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2608.28444.md", "source_location": null, "weight": 1.0}, {"source": "2608_28444_swa_with_sinks", "target": "2608_28444_linear_attention", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2608.28444.md", "source_location": null, "weight": 1.0}, {"source": "2608_28444_linear_attention", "target": "2608_28444_lolcats", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2608.28444.md", "source_location": null, "weight": 1.0}, {"source": "2608_28444_lolcats", "target": "2608_28444_hedgehog_kernel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2608.28444.md", "source_location": null, "weight": 1.0}, {"source": "2608_28444_sliding_window_attention", "target": "2608_28444_needle_in_haystack", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2608.28444.md", "source_location": null, "weight": 1.0}, {"source": "2608_28444_sliding_window_attention", "target": "2608_28444_babilong", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2608.28444.md", "source_location": null, "weight": 1.0}, {"source": "2608_28444_swa_with_sinks", "target": "2608_28444_flashattention", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2608.28444.md", "source_location": null, "weight": 1.0}, {"source": "2608_28444_linear_attention", "target": "2608_28444_thunderkittens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2608.28444.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "attention_mechanism_comparison", "label": "Attention Mechanism Comparison Framework", "nodes": ["2608_28444_swa_with_sinks", "2608_28444_linear_attention", "2608_28444_lolcats", "2608_28444_needle_in_haystack", "2608_28444_babilong"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "sourc