{"nodes": [{"id": "embedfilter_method", "label": "EmbedFilter: Linear Transformation for Text Embeddings", "file_type": "paper", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 1, 4", "source_url": "https://arxiv.org/abs/2606.07502", "captured_at": "2026-06-09", "author": "Songhao Wu, Zhongxin Chen, Yuxuan Liu, Heng Cui, Cong Li, Rui Yan", "contributor": null, "rationale": "Post-processing technique that filters out edge spectrum subspace of LLM unembedding matrix to suppress high-frequency tokens and enhance semantic representations."}, {"id": "embedfilter_edge_spectrum", "label": "Edge Spectrum Subspace Discovery", "file_type": "concept", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 3", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Identified via Logit Spectroscopy; spans right singular vectors with smallest and largest singular values; actively writes frequent tokens into embedding space."}, {"id": "embedfilter_logit_lens", "label": "Logit Lens Analysis", "file_type": "concept", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 2.3", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Mechanistic interpretability tool that projects intermediate representations onto vocabulary space to analyze token alignment patterns."}, {"id": "embedfilter_logit_spectroscopy", "label": "Logit Spectroscopy", "file_type": "concept", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 2.3", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Extension of Logit Lens that projects representations onto spectral components of weight matrices to measure contribution of different subspaces."}, {"id": "embedfilter_dimensionality_reduction", "label": "Distance-Preserving Dimensionality Reduction", "file_type": "concept", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 4.2", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "EmbedFilter enables embedding dimensionality reduction via orthogonal transformation; reduces storage and speeds retrieval while preserving similarity."}, {"id": "embedfilter_mteb_evaluation", "label": "MTEB Benchmark Evaluation", "file_type": "concept", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 5", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "EmbedFilter achieves up to 14.1% improvement on MTEB across semantic similarity, classification, clustering, and retrieval tasks."}, {"id": "embedfilter_anisotropy_problem", "label": "Anisotropy in LLM Text Embeddings", "file_type": "concept", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 1, 3.1", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Raw LLM embeddings are confined to narrow cone; centroid corresponds to frequency-weighted average token; suppressing this component mitigates anisotropy."}, {"id": "embedfilter_average_token_reverse_engineering", "label": "Average Token Reverse-Engineering", "file_type": "concept", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 3.2", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Uses unembedding matrix and word frequencies to reconstruct centroid hidden state representing average token; enables Logit Spectroscopy analysis."}, {"id": "embedfilter_bulk_spectrum_transformation", "label": "Bulk Spectrum Transformation", "file_type": "concept", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 4.1", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Filters out edge spectrum by keeping mid-range singular components; simple linear transformation with no training overhead."}, {"id": "embedfilter_model_coverage", "label": "EmbedFilter Model Coverage", "file_type": "concept", "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 5.1", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Evaluated on Qwen-2.5 (0.5B), Llama-3.1-8B-Instruct, Mistral-7B-Instruct-V0.3; demonstrates universality across model families and scales."}], "edges": [{"source": "embedfilter_method", "target": "embedfilter_edge_spectrum", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 3, 4", "weight": 1.0}, {"source": "embedfilter_method", "target": "embedfilter_logit_lens", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 2.3", "weight": 1.0}, {"source": "embedfilter_method", "target": "embedfilter_dimensionality_reduction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 4.2", "weight": 1.0}, {"source": "embedfilter_method", "target": "embedfilter_mteb_evaluation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 5", "weight": 1.0}, {"source": "embedfilter_logit_lens", "target": "embedfilter_logit_spectroscopy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2606.07502.md", "source_location": "Section 2.3", "weight": 1.0}, {"source": "embedfilter_edge_spectrum", "target": "embedfilter_anisotropy_problem", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2606.07502.md", "source_location": "Sectio