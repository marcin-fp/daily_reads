{"nodes": [{"id": "2609_06746", "label": "Reason Through the Latent! Making Latent Visual Reasoning Necessary", "file_type": "paper", "source_file": "2026-06-09/2609.06746.md", "source_location": null, "source_url": "https://arxiv.org/abs/2609.06746", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Introduces CVRR to enforce causal necessity of latent visual reasoning by removing alternative image-conditioned paths while preserving pretrained visual competence through native multimodal initialization."}, {"id": "method_cvrr", "label": "Causal Visual Recurrent Reasoning (CVRR)", "file_type": "concept", "source_file": "2026-06-09/2609.06746.md", "source_location": "Section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Method that initializes recurrence from native multimodal question state, repeatedly updates while re-reading fixed visual evidence, and removes alternative image-conditioned paths."}, {"id": "benchmark_v_star", "label": "V* Benchmark", "file_type": "concept", "source_file": "2026-06-09/2609.06746.md", "source_location": "Section 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-resolution visual QA benchmark with 191 examples used to evaluate visual reasoning methods."}, {"id": "benchmark_mmvp", "label": "MMVP Benchmark", "file_type": "concept", "source_file": "2026-06-09/2609.06746.md", "source_location": "Section 4.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visual QA benchmark with 300 questions over 150 visually similar image pairs, testing fine-grained visual discrimination."}, {"id": "finding_latent_informativeness_vs_necessity", "label": "Latent Informativeness vs. Causal Necessity", "file_type": "concept", "source_file": "2026-06-09/2609.06746.md", "source_location": "Section 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rati