{"nodes": [{"id": "s42256_026_01268_y_multi_agent_coordination", "label": "Multi-Agent Coordination Study", "file_type": "document", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": null, "source_url": "https://doi.org/10.1038/s42256-026-01268-y", "captured_at": "2026-07-24", "author": "Kim et al.", "contributor": null, "rationale": "Controlled evaluation of agent coordination across 260 configurations spanning six benchmarks, five architectures, three LLM families; derives predictive model showing single-agent baseline is strongest predictor of whether multi-agent coordination improves performance."}, {"id": "s42256_026_01268_y_capability_saturation_threshold", "label": "Capability-Saturation Threshold (~45%)", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empirically derived threshold beyond which additional agents unlikely to improve performance; correctly predicts multi-agent coordination effect in 94% of validation configurations on SWE-bench Verified and Terminal-Bench."}, {"id": "s42256_026_01268_y_baseline_scaled_error_amplification", "label": "Baseline-Scaled Error Amplification", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Architectures without centralized verification propagate errors more as baseline difficulty grows; survives cluster-robust inference (Probust = 0.030), supporting failure-mode taxonomy where verification bottlenecks intercept errors before aggregation."}, {"id": "s42256_026_01268_y_finance_agent_benchmark", "label": "Finance Agent Benchmark", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-step quantitative reasoning task where centralized MAS achieves +80.8% improvement over SAS (0.631 vs 0.349), driven by opportunities for distributed financial reasoning across independent agents."}, {"id": "s42256_026_01268_y_plancraft_benchmark", "label": "PlanCraft Benchmark", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minecraft environment planning task where all MAS architectures degrade (\u221270% to \u221239%), due to inherent sequential dependencies where coordination overhead exceeds task complexity."}, {"id": "s42256_026_01268_y_swe_bench_verified", "label": "SWE-bench Verified Benchmark", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Software engineering benchmark (GitHub issue resolution) where all MAS architectures show slight degradation (\u22121.3% to \u221212.8%), consistent with capability-saturation threshold as most models exceed 45% single-agent baseline."}, {"id": "s42256_026_01268_y_five_architectures", "label": "Five Agent Architectures", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Methods", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canonical architectures compared: SAS (single sequential agent), MAS-independent (parallel agents + synthesis), MAS-decentralized (sequential peer debate + voting), MAS-centralized (hierarchical orchestrator), MAS-hybrid (orchestrator + peer exchange)."}, {"id": "s42256_026_01268_y_predictive_model", "label": "Predictive Architecture-Selection Model", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Linear regression with prespecified interactions (20 parameters) relating performance to intelligence, task properties, and empirical coordination metrics; achieves R\u00b2CV = 0.373 (0.413 with task-grounded ACI), selects best architecture in 87% of held-out configurations."}, {"id": "s42256_026_01268_y_coordination_metrics", "label": "Empirical Coordination Metrics", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four categories of predictors: base model capability (intelligence index I), system configuration (agent count na), task properties (tool count T, single-agent baseline PSA), and coordination metrics (efficiency Ec, overhead O%, error amplification Ae, message density c, redundancy R)."}, {"id": "s42256_026_01268_y_turn_count_scaling", "label": "Turn Count Power-Law Scaling", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Total reasoning turns exhibit super-linear growth with agent count (exponent 1.724 > 1), reflecting quadratic message complexity; hybrid requires 6.2\u00d7 more turns than SAS, centralized 3.8\u00d7, decentralized 3.6\u00d7."}, {"id": "s42256_026_01268_y_error_absorption", "label": "Error Absorption Mechanisms", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": "Results", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centralized and hybrid architectures achieve 22.7% average error reduction through iterative verification; independent MAS shows +4.6% amplification due to absence of verification; optimal redundancy at R \u2248 0.41 (centralized median)."}, {"id": "s42256_026_01268_y_agent_scaling_study", "label": "Agent Scaling Study", "file_type": "paper", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": null, "source_url": "https://doi.org/10.1038/s42256-026-01268-y", "captured_at": "2026-06-09", "author": "Yubin Kim, Daniel McDuff, Xin Liu", "contributor": null, "rationale": "Empirical study comparing single-agent and multi-agent LLM architectures across six benchmarks to quantify coordination overhead and performance trade-offs."}, {"id": "s42256_026_01268_y_single_agent_system", "label": "Single-Agent System (SAS)", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Baseline architecture spending entire per-system token budget within single reasoning trajectory; 0% communication overhead."}, {"id": "s42256_026_01268_y_independent_mas", "label": "Independent Multi-Agent System", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Pure ensemble without inter-agent communication; 58% communication overhead relative to SAS baseline."}, {"id": "s42256_026_01268_y_centralized_mas", "label": "Centralized Multi-Agent System", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Hierarchical verification through orchestrator bottleneck; 285% communication overhead; enables controlled attribution of performance to coordination mechanisms."}, {"id": "s42256_026_01268_y_decentralized_mas", "label": "Decentralized Multi-Agent System", "file_type": "concept", "source_file": "2026-06-09/s42256-026-01268-y.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, 