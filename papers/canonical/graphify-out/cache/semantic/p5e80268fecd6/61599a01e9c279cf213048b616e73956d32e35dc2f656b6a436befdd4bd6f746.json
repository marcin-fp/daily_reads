{"nodes": [{"id": "2604_14228_claude_code_architecture", "label": "Claude Code: AI Agent System Architecture", "file_type": "document", "source_file": "2026-05-06/2604.14228.md", "source_location": "Full paper", "captured_at": "2026-05-06", "rationale": "Comprehensive source-level analysis of Claude Code's architecture, design principles, and subsystem organization"}, {"id": "2604_14228_design_values", "label": "Five Core Design Values", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 2.1", "rationale": "Identifies human decision authority, safety/security/privacy, reliable execution, capability amplification, and contextual adaptability as motivating values"}, {"id": "2604_14228_design_principles", "label": "Thirteen Design Principles", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 2.2, Table 1", "rationale": "Operationalizes five values through thirteen recurring design principles addressing safety, context, extensibility, and persistence"}, {"id": "2604_14228_query_loop", "label": "Query Loop: Core Agent Iteration", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 4", "rationale": "Implements ReAct pattern as async generator with context assembly, model call, tool dispatch, and result collection"}, {"id": "2604_14228_permission_system", "label": "Permission System and Safety Architecture", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 5", "rationale": "Seven-layer defense-in-depth safety architecture with deny-first rules, ML classifier, and graduated trust spectrum"}, {"id": "2604_14228_extensibility", "label": "Four Extension Mechanisms", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 6", "rationale": "MCP servers, plugins, skills, and hooks provide extensibility at graduated context costs"}, {"id": "2604_14228_context_management", "label": "Context Management and Compaction", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 7", "rationale": "Five-layer compaction pipeline manages bounded context window through graduated compression strategies"}, {"id": "2604_14228_subagent_delegation", "label": "Subagent Delegation and Orchestration", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 8", "rationale": "Isolated subagent boundaries with worktree isolation, permission override precedence, and summary-only returns"}, {"id": "2604_14228_session_persistence", "label": "Session Persistence and Recovery", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 9", "rationale": "Append-only JSONL transcripts with resume/fork support but no session-scoped permission restoration"}, {"id": "2604_14228_openclaw_comparison", "label": "OpenClaw: Multi-Channel Gateway Architecture", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 10", "rationale": "Persistent WebSocket gateway with multi-channel routing, perimeter-level access control, and structured memory"}, {"id": "2604_14228_hermes_agent_comparison", "label": "Hermes Agent: Single-Process Multi-Surface Architecture", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 10", "rationale": "Single Python process with role set by entry point, SQLite persistence, and pluggable memory/model backends"}, {"id": "2604_14228_long_term_capability", "label": "Long-Term Developer Capability Question", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 2.4, 12.2, 13.6", "rationale": "Cross-cutting concern about whether short-term capability amplification costs long-term human understanding and developer pipeline"}, {"id": "2604_14228_value_tensions", "label": "Value Tensions and Trade-offs", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 12.2, Table 6", "rationale": "Documents structural tensions between authority/safety, safety/capability, adaptability/safety, capability/adaptability, and capability/reliability"}, {"id": "2604_14228_empirical_predictions", "label": "Empirical Predictions from Architecture", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 12.4", "rationale": "Predicts pattern duplication and convention violation from bounded context; supported by adjacent tool studies"}, {"id": "2604_14228_future_directions", "label": "Six Open Design Directions", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 13", "rationale": "Identifies observability gap, cross-session persistence, harness boundary evolution, horizon scaling, governance, and long-term capability as open questions"}, {"id": "agent_architecture_design_space", "label": "Agent Architecture Design Space", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "rationale": "Recurring design questions about reasoning location, safety posture, context management, extensibility, delegation, and persistence"}, {"id": "operational_harness_philosophy", "label": "Operational Harness Philosophy", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 12.1", "rationale": "Design philosophy privileging deterministic infrastructure (98.4% of codebase) over decision scaffolding (1.6%)"}, {"id": "graduated_layering_pattern", "label": "Graduated Layering Pattern", "file_type": "concept", "source_file": "2026-05-06/2604.14228.md", "source_location": "Section 12.7", "rationale": "Recurring cross-cutting design commitment using graduated stacks of independent mechanisms for safety, context, and extensibility"}, {"id": "append_only_design_pattern", "label": "Append-Only Design Pattern", "file_type": "concept", "source_file": "2