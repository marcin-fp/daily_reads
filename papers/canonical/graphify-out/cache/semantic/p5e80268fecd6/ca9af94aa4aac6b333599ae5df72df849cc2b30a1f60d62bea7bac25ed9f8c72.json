{"nodes": [{"id": "2606_20820_celeus", "label": "CELEUS: Certifiable and Efficient LLM Evaluation Framework", "file_type": "paper", "source_file": "2026-06-09/2606.20820.md", "source_location": "Title and Abstract", "source_url": "https://arxiv.org/abs/2606.20820v2", "captured_at": "2026-06-09", "author": "Zhijian Zhou, Zesheng Ye, Zhaorun Chen, Bo Li, Feng Liu", "contributor": null, "rationale": "Framework for certifiable LLM evaluation using e-processes to build anytime-valid confidence intervals with uncertainty-guided sampling and surrogate-assisted approximations"}, {"id": "2606_20820_e_processes", "label": "E-Processes: Statistical Foundation", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Key Idea section", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Mathematical framework enabling anytime-valid confidence intervals under bounded evaluation scores; core validity mechanism for CELEUS"}, {"id": "2606_20820_uncertainty_guided_sampling", "label": "Uncertainty-Guided Sampling Strategy", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Technical Contributions section", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Prioritizes informative samples for evaluation by selecting based on surrogate-residual magnitude; reduces estimation variance and evaluation cost"}, {"id": "2606_20820_surrogate_assisted_approximation", "label": "Surrogate-Assisted Approximation Component", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Technical Contributions section", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Provides approximate scores for unevaluated samples using pre-trained surrogate models; enables variance reduction without task-specific training"}, {"id": "2606_20820_conditional_unbiasedness", "label": "Conditional Unbiasedness Property", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Technical Contributions section, Theorem 3", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Central validity mechanism: signals remain conditionally unbiased for evaluation score under non-uniform sample selection, enabling e-process construction"}, {"id": "2606_20820_sst2_benchmark", "label": "SST-2: Stanford Sentiment Treebank 2", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Setup section, Datasets", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Binary sentiment classification benchmark with 68,221 samples used for evaluating CELEUS efficiency"}, {"id": "2606_20820_ag_news_benchmark", "label": "AG News: Topic Classification Benchmark", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Setup section, Datasets", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Multi-class topic classification benchmark with 127,600 samples for evaluating CELEUS on diverse task difficulty"}, {"id": "2606_20820_mmlu_benchmark", "label": "MMLU: Massive Multitask Language Understanding", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Setup section, Datasets", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Broad multiple-choice benchmark with 115,700 samples testing LLMs across academic subjects; primary evaluation dataset for CELEUS"}, {"id": "2606_20820_llama3_70b", "label": "Llama-3-70B: Target Model", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Setup section, Surrogate-target pairs", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Large dense LLM used as target model for evaluation; paired with Llama-3-8B and Llama-2-7B surrogates"}, {"id": "2606_20820_deepseek_67b", "label": "DeepSeek-67B: Target Model", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Setup section, Surrogate-target pairs", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Large dense LLM used as target model; evaluated with multiple surrogate models across family and generation axes"}, {"id": "2606_20820_mixtral_8x7b", "label": "Mixtral-8\u00d77B: Mixture-of-Experts Target Model", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Setup section, Surrogate-target pairs", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "MoE architecture target model demonstrating CELEUS effectiveness on non-dense model families"}, {"id": "2606_20820_qwen2_5_72b", "label": "Qwen2.5-72B: Target Model", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Setup section, Surrogate-target pairs", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Large dense LLM from Qwen family used as target model for cross-family evaluation"}, {"id": "2606_20820_llama3_8b_surrogate", "label": "Llama-3-8B: Surrogate Model", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Setup section, Surrogate-target pairs", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "7-8B surrogate model used without task-specific training; provides efficient approximations for unevaluated samples"}, {"id": "2606_20820_cer_eval_baseline", "label": "Cer-Eval: Prior Certifiable Evaluation Method", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Introduction and Main Results", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Prior work on certifiable evaluation; CELEUS addresses its gap between theoretical guarantees and adaptive-partition algorithm in practice"}, {"id": "2606_20820_evalue_baseline", "label": "EVALUE: Standard E-Process Baseline", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Baselines section", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Applies standard e-processes for bounded mean estimation under uniform sampling without surrogate; baseline for efficiency comparison"}, {"id": "2606_20820_theorem1_unbiasedness", "label": "Theorem 1: Risk Estimator Unbiasedness", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Theoretical Analysis, Section 4", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Establishes fixed-time unbiasedness and consistency of risk estimator under non-uniform adaptive sampling"}, {"id": "2606_20820_theorem3_conditional_unbiasedness", "label": "Theorem 3: Conditional Unbiasedness of Signal", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Theoretical Analysis, Section 4", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Proves conditional unbiasedness of inferential signal for finite-pool risk, enabling anytime-valid e-process construction"}, {"id": "2606_20820_theorem4_variance_optimal", "label": "Theorem 4: Variance-Optimal Sampling Distribution", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Theoretical Analysis, Section 4", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Characterizes oracle sampling distribution that minimizes variance; motivates practical uncertainty-guided sampling strategy"}, {"id": "2606_20820_theorem5_ci_shrinkage", "label": "Theorem 5: Anytime-Valid CI Shrinkage Rate", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Theoretical Analysis, Section 4", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Proves anytime-valid coverage and near-parametric shrinkage rate O(log log t / sqrt(t)) for confidence intervals"}, {"id": "2606_20820_theorem6_population_coverage", "label": "Theorem 6: Population Risk Coverage and Shrinkage", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Theoretical Analysis, Section 4", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Lifts finite-pool guarantee to population risk via Hoeffding correction; shows combined shrinkage rate with pool-size dependence"}, {"id": "2606_20820_hoeffding_correction", "label": "Hoeffding Correction: Finite-Pool-to-Population Transfer", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "The CELEUS Evaluation Method, Section 3", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Transfers CI guarantee from pool risk to population risk; correction depends on full pool size and becomes negligible for large pools"}, {"id": "2606_20820_hedged_capital_process", "label": "Hedged Capital Process: E-Process Implementation", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "The CELEUS Evaluation Method, Section 3", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Implements sequential test for each candidate value using betting fractions; enables test inversion for confidence interval construction"}, {"id": "2606_20820_lure_estimator", "label": "LURE Estimator: Label-Efficient Risk Estimation", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Performance Estimation at Stopping", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Adjusts surrogate residuals for sequential non-uniform sample selection; provides fixed-time unbiased performance estimate"}, {"id": "2606_20820_rq1_coverage", "label": "RQ1: Anytime-Valid Coverage Validation", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Main Results, Section 5.2", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Empirical validation showing CELEUS maintains nominal 95% coverage while Cer-Eval fails with 16.1% miscoverage"}, {"id": "2606_20820_rq2_efficiency", "label": "RQ2: Sample Efficiency Gains", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Main Results, Section 5.2", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "CELEUS achieves 54-62% reduction in evaluated samples vs EVALUE; 10-23% additional improvement with surrogate models"}, {"id": "2606_20820_rq3_mechanism", "label": "RQ3: Mechanism Analysis", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Main Results, Section 5.2", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Isolates contributions of LURE weights, surrogate-corrected signal, and uncertainty-guided sampling to efficiency gains"}, {"id": "2606_20820_celeus", "label": "CELEUS: Certifiable and Efficient LLM Evaluation via E-Processes", "file_type": "paper", "source_file": "2026-06-09/2606.20820.md", "source_location": null, "source_url": "https://arxiv.org/abs/2606.20820", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Framework for certifiable LLM evaluation combining e-processes with surrogate-assisted sampling to construct anytime-valid confidence intervals for population risk with reduced sample complexity."}, {"id": "2606_20820_e_process", "label": "E-Process Construction", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section II, Theorem 5-7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Time-uniform martingale concentration via hedged capital process; provides anytime-valid bounds without requiring fixed sample size in advance."}, {"id": "2606_20820_surrogate_assisted_approximation", "label": "Surrogate-Assisted Approximation", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Theorem 4, Remark 1-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses auxiliary surrogate model scores to reduce residual variance in risk estimation; enables label-free sample selection strategies without requiring true labels before evaluation."}, {"id": "2606_20820_variance_optimal_sampling", "label": "Variance-Optimal Sampling Proposal", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Theorem 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Theoretical optimal sampling distribution proportional to absolute residual magnitude; CELEUS approximates this using label-free proxies (predictive dispersion, entropy)."}, {"id": "2606_20820_anytime_valid_ci", "label": "Anytime-Valid Confidence Intervals", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Theorem 6, Section B.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Confidence intervals that maintain coverage guarantee under adaptive stopping and repeated monitoring; combines finite-pool e-process bounds with finite-pool-to-population correction via Hoeffding's inequality."}, {"id": "2606_20820_stitching_construction", "label": "Dyadic Stitching for Anytime Validity", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section B.2, B.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upgrades finite-horizon e-process bounds to anytime-valid bounds via union bound over dyadic horizons; introduces log log t term in width bound."}, {"id": "2606_20820_sst2_benchmark", "label": "SST-2 Sentiment Classification Benchmark", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section D.1, Table 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binary sentiment classification task with N=67,349 samples; exhibits discrete two-modal residual distribution under 0-1 loss, enabling sharp acquisition scores."}, {"id": "2606_20820_mmlu_benchmark", "label": "MMLU Multi-Choice QA Benchmark", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section D.1, Table 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four-way multiple-choice across 57 academic subjects with N=115,700 samples; heterogeneous difficulty distribution across subjects controls tail of residual distribution."}, {"id": "2606_20820_ag_news_benchmark", "label": "AG News Topic Classification Benchmark", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section D.1, Table 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four-way topic classification with N=127,600 samples; relies on dispersed lexical cues, making surrogate correlation weaker than sentiment or factual tasks."}, {"id": "2606_20820_llama_models", "label": "Llama Model Family (2, 3 variants)", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section D.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used as both surrogate (8B, 7B) and target (70B) models in experiments; enables same-family and cross-generation comparisons."}, {"id": "2606_20820_deepseek_models", "label": "DeepSeek Model Family", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section D.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "67B variant used as target model in cross-family surrogate-target pairs."}, {"id": "2606_20820_mixtral_models", "label": "Mixtral Model Family", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section D.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "8\u00d77B mixture-of-experts variant used as target model in cross-family experiments."}, {"id": "2606_20820_qwen_models", "label": "Qwen Model Family", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section D.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "2.5-72B variant used as target model in cross-family experiments."}, {"id": "2606_20820_evalue_baseline", "label": "EVALUE Baseline Method", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section D.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Applies hedged-capital confidence sequence with uniform sampling (no surrogate); serves as baseline for isolating contribution of active sampling and surrogate assistance."}, {"id": "2606_20820_cer_eval_baseline", "label": "Cer-Eval Baseline Method", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Section D.3, Appendix C", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adaptive partitioning method with double-dipping issue: uses evaluated samples both to learn partition and estimate within-partition variation, leading to potential undercoverage."}, {"id": "2606_20820_synthetic_setting", "label": "Synthetic Evaluation Setting with Hidden Risk Structure", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Appendix C", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Isolates failure mode where embeddings are independent of target risk; demonstrates gap between Cer-Eval's fixed-partition theory and adaptive algorithm in practice."}, {"id": "2606_20820_strategy_a_01loss", "label": "Strategy A: Hard Pseudo-Loss for 0-1 Risk", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Remark 1, Appendix G", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses hard pseudo-loss (agreement indicator) as target-loss proxy and predictive dispersion as surrogate score; preserves discrete structure of 0-1 loss."}, {"id": "2606_20820_strategy_a_ce_loss", "label": "Strategy A: Mode Loss for Cross-Entropy Risk", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Remark 2, Appendix G", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses mode loss (negative log-prob of predicted class) as target-loss proxy and predictive entropy as surrogate score for cross-entropy risk."}, {"id": "2606_20820_hyperparameter_sensitivity", "label": "Hyperparameter Sensitivity Analysis", "file_type": "concept", "source_file": "2026-06-09/2606.20820.md", "source_location": "Appendix H", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Studies sensitivity to \u03b1-split, hedge weight \u03b8, stabilizer c, and sampling floor \u03b2; shows smooth performance changes and stability of default choices."}], "edges": [{"source": "2606_20820_celeus", "target": "2606_20820_e_processes", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 0.95, "so