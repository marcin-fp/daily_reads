{"nodes": [{"id": "arxiv_2509_14786", "label": "Pre-training under Infinite Compute", "file_type": "paper", "source_file": "2026-06-09/2509.14786.md", "source_url": "https://arxiv.org/abs/2509.14786", "captured_at": "2026-06-09", "rationale": "Proposes data-constrained pre-training recipes using regularization, ensembling, and distillation to achieve 5.17\u00d7 data efficiency improvement over standard approaches."}, {"id": "concept_regularization_weight_decay", "label": "Regularization via Weight Decay", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Key finding that optimal weight decay is 30\u00d7 larger than standard practice (0.1) for data-constrained pre-training, enabling monotonic scaling laws."}, {"id": "concept_ensemble_scaling", "label": "Ensemble Scaling for Data Efficiency", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Demonstrates that training multiple smaller models and ensembling achieves lower loss asymptote than single large model scaling, with better data efficiency."}, {"id": "method_locally_optimal_hyperparameters", "label": "Locally Optimal Hyperparameter Search", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Coordinate descent algorithm for finding hyperparameters where no single-variable change improves loss, enabling clean scaling laws in over-parameterized regime."}, {"id": "method_asymptote_estimation", "label": "Asymptote-based Scaling Law Evaluation", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Novel evaluation metric for data-constrained regime: estimate best possible performance via asymptote of power law rather than fixed compute budget."}, {"id": "method_self_distillation", "label": "Self-Distillation for Data Efficiency", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Training student model on mixture of real and synthetic data from same-sized teacher improves performance without increasing training parameter count."}, {"id": "model_llama_style", "label": "Llama-style Transformer Architecture", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md"}, {"id": "dataset_dclm", "label": "DCLM Pre-training Dataset", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md"}, {"id": "finding_weight_decay_scaling", "label": "Weight Decay Increases with Model Size", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Optimal weight decay scales with parameter count in data-constrained regime, from 0.8 at 150M to 3.2 at 1.4B parameters."}, {"id": "finding_ensemble_efficiency", "label": "Ensembles More Sample-Efficient than Parameter Scaling", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "At low sample budgets (N<10), ensemble scaling achieves better loss asymptote than parameter scaling with same total parameters."}, {"id": "experiment_regularization_tuning", "label": "Regularization Hyperparameter Tuning", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Extensive search for locally-optimal weight decay, learning rate, and epoch count across parameter and token counts."}, {"id": "experiment_ensemble_scaling_laws", "label": "Ensemble Scaling Law Fitting", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Power law fitting for ensemble member count and parameter count to estimate asymptotic performance."}, {"id": "theory_double_descent", "label": "Double Descent Phenomenon", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Over-parameterized models can exhibit non-monotonic loss curves; proper regularization enables monotonic scaling."}, {"id": "theory_multi_view_learning", "label": "Multi-View Learning Theory", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md", "rationale": "Theoretical justification for ensemble benefits: independent training learns different features, ensemble combines them."}, {"id": "related_chinchilla_scaling", "label": "Chinchilla Compute-Optimal Scaling", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md"}, {"id": "related_mixture_of_experts", "label": "Mixture-of-Experts Architecture", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md"}, {"id": "related_knowledge_distillation", "label": "Knowledge Distillation", "file_type": "concept", "source_file": "2026-06-09/2509.14786.md"}], "edges": [{"source": "arxiv_2509_14786", "target": "concept_regularization_weight_decay", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2509.14786.md"}, {"source": "arxiv_2509_14786", "target": "concept_ensemble_scaling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2509.14786.md"}, {"source": "arxiv_2509_14786", "target": "finding_weight_decay_scaling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2509.14786.md"}, {"source": "arxiv_2509_14786", "target": "finding_ensemble_efficiency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2509.14786.md"}, {"source": "arxiv_2509_14786", "target": "experiment_regularization_tuning", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2509.14786.md"}, {"source": "arxiv_2509_14786", "target": "experiment_ensemble_scaling_laws", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2509.14786.md"}, {"source": "concept_regularization_weight_decay", "target": "method_locally_optimal_hyperparameters", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "2026-06-09/2509.147