{"nodes": [{"id": "paper_2608_31111", "label": "Aspire: Vague-Goal-Driven Self-Evolution", "file_type": "paper", "source_file": "2026-06-09/2608.31111.md", "source_location": null, "source_url": "https://arxiv.org/abs/2608.31111", "captured_at": null, "author": "Yuhao Wu, Jingyuan Zhang, Jiajun Shi, Yuxuan Zhang, Xinping Lei", "contributor": null, "rationale": "Benchmark for measuring LLM self-evolution when given only vague capability goals without explicit task specifications or decomposable rewards"}, {"id": "concept_goal_operationalization", "label": "Goal Operationalization", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 1, 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Process of converting a broad capability goal into trainable objectives, learning signals, and validation criteria; identified as missing axis in autonomous post-training"}, {"id": "concept_vague_goal", "label": "Vague Goal", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 1, 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Broad capability direction not yet operationalized as fixed task-level objective; requires agent to diagnose gaps, form intermediate objectives, and construct learning signals"}, {"id": "concept_forward_deployed_engineer", "label": "Forward-Deployed Engineer Role", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human role that translates general-purpose models into working systems by operationalizing vague deployment needs into concrete objectives and constraints; motivates study of vague-goal self-evolution"}, {"id": "experiment_rq1_aspire", "label": "RQ1: Vague Goals vs Explicit Tasks", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.2, Figure 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vague-goal prompting associated with more goal-operationalization work and lower aggregate scores than explicit-task references"}, {"id": "experiment_rq2_aspire", "label": "RQ2: Self-Directed Weight Evolution", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.3, Figures 5-8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only 1/12 final-only model-goal pairs exceed base score; adaptive feedback produces locally rising trajectories that remain below base in most cases"}, {"id": "experiment_rq3_aspire", "label": "RQ3: Harness Evolution", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.4, Table 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One-step harness evolution produces executable successors but all remain below engineered Qwen-Agent reference"}, {"id": "finding_weight_evolution_instability", "label": "Weight Evolution Instability", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.3, Figure 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Apparent progress can be recovery from training-induced regression; continued optimization can induce regression rather than produce better descendant"}, {"id": "finding_answer_format_collapse", "label": "Answer-Format Collapse Failure Mode", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Numeric-label SFT training associated with all-digit evaluation outputs and near-zero scores; documents concrete answer-format mismatch"}, {"id": "finding_harness_validation_specialization", "label": "Harness Validation Specialization", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.4, Appendix D", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Narrow agent validation can specialize harness to wrong proxy; validation gain on agent data does not guarantee hidden evaluation improvement"}, {"id": "benchmark_aspire_goals", "label": "Aspire Six Vague Goals", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 3.2, Table 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scientific and academic reasoning, humanities and social sciences, health and medicine, mathematical reasoning, logic/reliability/instruction following, academic and scientific writing"}, {"id": "evaluation_hidden_set_aspire", "label": "Aspire Hidden Evaluation Set", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 3.2, Figure 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "520 expert-authored items across six goals; items, answers, rubrics remain controller-only; protocol returns only aggregate scores"}, {"id": "protocol_final_only", "label": "Final-Only Evaluation Protocol", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent receives no intermediate evaluation scores; single final-checkpoint submission prevents feedback-guided search"}, {"id": "protocol_adaptive_feedback", "label": "Adaptive-Feedback Evaluation Protocol", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded queries permit repeated aggregate scores on same goal items; enables feedback-guided checkpoint search without per-item feedback"}, {"id": "model_qwen_3_5_4b", "label": "Qwen3.5-4B", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instruction-tuned base model used in RQ2 weight evolution and RQ3 harness evolution experiments"}, {"id": "model_gpt_5_6", "label": "GPT-5.6", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External decision model used in adaptive-feedback protocol (Luna, Terra, Sol variants)"}, {"id": "tool_unified_agent_tool", "label": "Unified Agent Tool Interface", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 3.3, Figure 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Composable interface for data search/download/import/synthesis, SFT/GRPO training, verification, validation, evaluation, branching, termination"}, {"id": "method_sft", "label": "Supervised Fine-Tuning", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Training method available to agents in Aspire for weight evolution"}, {"id": "method_grpo", "label": "Group Relative Policy Optimization", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Training method available to agents in Aspire for weight evolution"}, {"id": "method_lora", "label": "Low-Rank Adaptation", "file_type": "concept", "source_file": "2026-06-09/2608.31111.md", "source_location": "Section 4.2", "so