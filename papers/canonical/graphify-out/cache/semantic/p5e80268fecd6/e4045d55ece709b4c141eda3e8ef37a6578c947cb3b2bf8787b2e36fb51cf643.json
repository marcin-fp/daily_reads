{"nodes": [{"id": "arxiv_2511_09149", "label": "Interlat: Inter-agent Latent Space Communication", "file_type": "paper", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": "https://arxiv.org/abs/2511.09149v5", "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Proposes paradigm for LLM-based agents to communicate entirely in latent space by transmitting last-layer hidden states rather than discrete tokens, enabling richer information exchange and compression."}, {"id": "concept_latent_communication", "label": "Latent Space Communication", "file_type": "concept", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct transmission of last-layer hidden states between agents instead of discrete tokens; preserves continuous information and enables compression via latent-space reasoning."}, {"id": "experiment_alfworld", "label": "ALFWorld Benchmark", "file_type": "concept", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text-only embodied task benchmark simulating household tasks; used to evaluate Interlat latent communication against language-based baselines."}, {"id": "experiment_math_benchmark", "label": "MATH Benchmark", "file_type": "concept", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mathematical problem-solving benchmark; Interlat shows improved performance on Level-5 tasks compared to CoT baseline."}, {"id": "model_qwen2_5", "label": "Qwen2.5 Model Family", "file_type": "concept", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Base and instruction-tuned variants (7B, 0.5B) used as reasoning and actor agents in Interlat experiments."}, {"id": "model_llama3_1", "label": "LLaMA3.1 Model", "file_type": "concept", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "8B-Base model used as actor agent in Interlat experiments; demonstrates cross-family latent communication capability."}, {"id": "concept_compression_latent_space", "label": "Latent Space Compression", "file_type": "concept", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Training separate reasoning model to generate compact latent messages HK with K<<L while preserving task utility; achieves up to 24x reduction in communication latency."}, {"id": "concept_separation_loss", "label": "Conditional Thought Separation Loss", "file_type": "concept", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "contributor": null, "rationale": "Training objective comparing conditional output distributions under matched vs mismatched latent communications; encourages actor to attend to task-relevant latent information."}, {"id": "concept_curriculum_learning", "label": "Token-to-Latent Curriculum Learning", "file_type": "concept", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stochastic replacement of early communication positions with plan token embeddings; stabilizes training and enhances efficiency in learning to interpret latents."}, {"id": "concept_communication_adapter", "label": "Communication Adapter", "file_type": "concept", "source_file": "2026-05-06/2511.09149.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Light