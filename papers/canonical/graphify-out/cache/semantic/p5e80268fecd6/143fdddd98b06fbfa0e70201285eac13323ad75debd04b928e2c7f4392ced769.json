{"nodes": [{"id": "paper_2602_17582", "label": "Building an AI-native Research Ecosystem for Experimental Particle Physics: A Community Vision", "file_type": "paper", "source_file": "2026-06-09/2602.17582.md", "source_location": null, "source_url": "https://arxiv.org/abs/2602.17582", "captured_at": null, "author": "Thea Klaeboe Aarrestad et al.", "contributor": null, "rationale": "Community vision document for AI-native research ecosystem in experimental particle physics; provides broader context for machine learning applications in physics."}, {"id": "2602_17582_whitepaper", "label": "AI-Native Research Ecosystem for Experimental Particle Physics Whitepaper", "file_type": "document", "source_file": "2026-06-09/2602.17582.md", "source_location": null, "source_url": null, "captured_at": "2026-02-20", "author": "Thea Klaeboe Aarrestad et al.", "contributor": null, "rationale": "Community vision document endorsed by CPSC/DPF/APS presenting strategic roadmap for embedding AI across experimental particle physics lifecycle"}, {"id": "gc_accelerated_experimental_design", "label": "Grand Challenge 1: Accelerated Experimental Design", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses differentiable, agent-guided optimization to co-design accelerators and detectors, enabling ambitious ideas to become buildable, higher-impact experiments on faster timescales with reduced technical risk and costs"}, {"id": "gc_intelligent_sensing_instrumentation", "label": "Grand Challenge 2: Intelligent Sensing and Instrumentation", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves intelligence upstream via trigger-less or AI-assisted readout, physics-aware compression, and real-time inference to preserve rare, unexpected, or time-critical signals within bandwidth and storage constraints"}, {"id": "gc_autonomous_experiments", "label": "Grand Challenge 3: Autonomous Experiments", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transforms labor-intensive, reactive operations into proactive, resilient, continuously calibrated systems, capturing more high-quality data with less downtime and preserving institutional knowledge over decades-long experiment lifetimes"}, {"id": "gc_data_to_discovery", "label": "Grand Challenge 4: From Data to Discovery", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integrates foundation models, fast AI-enabled reconstruction and simulation, and agent-orchestrated workflows to compress analysis cycles by orders of magnitude and open new regions of theory space to exploration"}, {"id": "ai_native_paradigm", "label": "AI-Native Experimental Paradigm", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Executive Summary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Embeds AI end-to-end across experimental lifecycle from co-design of accelerators and detectors to intelligent sensing, data acquisition, autonomous operations, calibration, and accelerated analysis; experiments become continuously learning systems"}, {"id": "national_scale_collaboration", "label": "National-Scale AI Collaboration for Particle Physics", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed structure bringing together DOE national laboratories, U.S. universities, and industry partners; envisioned as 120+ FTEs jointly managed across multiple funding partners to develop shared AI capabilities and train AI-literate workforce"}, {"id": "doe_national_labs", "label": "DOE National Laboratories", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "universities_ecosystem", "label": "U.S. Universities in AI-Physics Ecosystem", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 4, 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drive innovative R&D and workforce development through deep engagement of students and postdocs; connections to nearly all U.S. Ph.D.-granting universities and many undergraduate institutions"}, {"id": "nsf_mission", "label": "NSF Mission and Community Engagement", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enables expansion beyond particle physics and provides pathways to engage other domain sciences and translate impact more broadly in U.S. research and education ecosystem"}, {"id": "industry_partnerships", "label": "Strategic Industry Partnerships", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ensure rapid access to state-of-the-art AI technologies and best practices, enabling efficient technology transfer and co-design"}, {"id": "workforce_development", "label": "Workforce Development Initiative", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Integrated with national-scale collaboration; could contribute 2100 PhDs and ~20,000 undergraduates to DOE Genesis Mission goal of training 100,000 scientists over next decade"}, {"id": "ai_cyberinfrastructure", "label": "AI-Native Cyberinfrastructure", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New generation infrastructure supporting large-scale model training, always-on low-latency inference for real-time operations, and AI-accelerated simulation tightly integrated with HPC facilities"}, {"id": "fair_data_ecosystem", "label": "FAIR Data Ecosystem", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Federated, AI-ready data ecosystem following Findable, Accessible, Interoperable, and Reusable principles; enables cross-experiment learning while respecting governance and ownership"}, {"id": "multimodal_foundation_models", "label": "Multimodal Foundation Models", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "differentiable_simulation", "label": "Fast and Differentiable Simulation with Simulation-Based Inference", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agentic_active_learning", "label": "Agentic Active Learning Systems", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "inference_as_service", "label": "Inference-as-a-Service", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "digital_twins", "label": "High-Fidelity Digital Twins", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doe_leadership_facilities", "label": "DOE Leadership Class Facilities", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "american_science_cloud", "label": "American Science Cloud", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "hl_lhc", "label": "High-Luminosity Large Hadron Collider (HL-LHC)", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dune", "label": "Deep Underground Neutrino Experiment (DUNE)", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "eic", "label": "Electron-Ion Collider (EIC)", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fcc_ee", "label": "Future Circular Collider electron-electron (FCC-ee)", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "icecube_gen2", "label": "IceCube-Gen2", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "muon_collider", "label": "Muon Collider (U.S.)", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cpsc", "label": "Coordinating Panel for Software and Computing (CPSC)", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dpf", "label": "Division of Particles and Fields (DPF)", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aps", "label": "American Physical Society (APS)", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "doe_genesis_mission", "label": "DOE Genesis Mission", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Goal of training 100,000 scientists over next decade; proposed collaboration could contribute 2100 PhDs and ~20,000 undergraduates"}, {"id": "experimental_particle_physics", "label": "Experimental Particle Physics", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Abstract, Executive Summary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Field addressing fundamental questions about universe through collider, neutrino, cosmic, and rare-event experiments; generates petabytes of data annually"}, {"id": "high_dimensional_pattern_recognition", "label": "High-Dimensional Pattern Recognition", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Executive Summary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI strength aligned with particle physics data structure and scale"}, {"id": "rare_signal_inference", "label": "Rare-Signal Inference", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Executive Summary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI capability critical for particle physics discovery of rare events"}, {"id": "low_latency_decision_making", "label": "Low-Latency Decision Making", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Executive Summary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI capability required for real-time trigger and data acquisition in particle physics experiments"}, {"id": "complex_system_orchestration", "label": "Complex System Orchestration", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Executive Summary", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI capability for coordinating hardware, software, and human expertise in large experimental facilities"}, {"id": "2602_17582_grand_challenge_1", "label": "Grand Challenge 1: AI for Detector Design and Optimization", "file_type": "document", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.1", "rationale": "Addresses accelerating detector design cycles through AI-driven optimization, reducing design time from years to months and enabling exploration of vastly larger design spaces"}, {"id": "2602_17582_grand_challenge_2", "label": "Grand Challenge 2: AI for Simulation and Reconstruction", "file_type": "document", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.2", "rationale": "Aims to transform simulation from static pre-computed resource to dynamic adaptive element; enable fast, differentiable simulation; and improve reconstruction through foundation models"}, {"id": "2602_17582_grand_challenge_3", "label": "Grand Challenge 3: Autonomous Experiments", "file_type": "document", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.3", "rationale": "Targets using AI to automate detector/facility operations, data quality monitoring, and calibration; aims for 50% less downtime, 10\u00d7 faster calibration cycles, and 10\u00d7 reduction in personnel effort"}, {"id": "2602_17582_grand_challenge_4", "label": "Grand Challenge 4: From Data to Discovery", "file_type": "document", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.4", "rationale": "Seeks to reduce time for physics analysis design and evaluation by 100-1000\u00d7; enable exploration of vastly larger theory spaces through automated workflows and agentic science"}, {"id": "2602_17582_foundation_models", "label": "Foundation Models for HEP", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "Multimodal foundation models adaptable to multiple levels of analysis stack (reconstruction, population, inference); enable transfer across detector geometries and event topologies"}, {"id": "2602_17582_fast_simulation", "label": "Fast Data Generation and Simulation", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "Generative AI and accelerated simulation to provide rapid, adaptable, on-demand data creation; essential for design optimization, operations, and analysis"}, {"id": "2602_17582_differentiable_simulation", "label": "Differentiable Simulation", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "Integration of simulators into automatic differentiation frameworks enabling gradient-based optimization for sensitivity analysis, calibration, design optimization, and simulation-based inference"}, {"id": "2602_17582_neural_sbi", "label": "Neural Simulation-Based Inference", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "Methods at conjunction of simulation, probabilistic modeling, and deep learning enabling high-dimensional Bayesian/Frequentist inference with significant sensitivity improvements"}, {"id": "2602_17582_anomaly_detection", "label": "Anomaly Detection", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "Unsupervised/weakly supervised methods for identifying deviations from dominant distributions; enables model-agnostic searches and automated system monitoring"}, {"id": "2602_17582_active_learning", "label": "Active Learning and Reinforcement Learning", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "Paradigms for iterative measurement-informed decision making; enable hypothesis selection, data quality checks, and design process optimization"}, {"id": "2602_17582_agentic_systems", "label": "Agentic Systems", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "LLM-based systems with reasoning and coding capabilities for outer-loop orchestration of workflows and automated decision making across all Grand Challenges"}, {"id": "2602_17582_ai_training_inference_service", "label": "AI Training and Inference as a Service", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "Backbone infrastructure for AI-native experimentation; enables offloading AI compute to external services at national laboratories"}, {"id": "2602_17582_on_edge_ai", "label": "On-Edge AI", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "Development and deployment of AI models on FPGAs and ASICs for constrained-resource systems; enables inference in triggers and remote sensing with radiation-hardness considerations"}, {"id": "2602_17582_digital_twins", "label": "Digital Twins", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 6", "rationale": "Realistic, dynamic models of physical experiments enabling tight feedback loops and verifiability; key substrate for AI-native experiments and agentic AI"}, {"id": "2602_17582_national_collaboration", "label": "National-Scale AI Collaboration for Particle Physics", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 4", "rationale": "Jointly managed core effort across DOE, NSF, and private foundations; modeled on successful U.S. LHC operations programs; requires ~120 FTE over 5 years"}, {"id": "2602_17582_workforce_development", "label": "Workforce Development Pipeline", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 5", "rationale": "Structured training from undergraduate through postdoctoral levels; dual-competency in physics and AI; leverages existing programs (REU, SULI, PURSUE, SUPER, IRIS-HEP Fellows)"}, {"id": "2602_17582_data_curation", "label": "Data Curation, Governance, and Open Access", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "rationale": "Federated Data Lakehouse with coherent representations and automated curation pipelines; enables cross-experiment foundation models and FAIR data principles"}, {"id": "2602_17582_amsc", "label": "American Science Cloud (AmSC)", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 7", "rationale": "Emerging national infrastructure offering unified inference for open-source and industry models; supports Genesis Mission goals through Intelligent Interfaces and MCP servers"}, {"id": "2602_17582_grand_challenges", "label": "Four Grand Challenges in AI for Particle Physics", "file_type": "concept", "source_file": "2026-06-09/2602.17582.md", "source_location": "Sections 3.1-3.4", "rationale": "Unified framework organizing AI research across detector design, simulation/reconstruction, autonomous experiments, and data-to-discovery workflows"}], "edges": [{"source": "2602_17582_whitepaper", "target": "gc_accelerated_experimental_design", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.1", "weight": 1.0}, {"source": "2602_17582_whitepaper", "target": "gc_intelligent_sensing_instrumentation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.2", "weight": 1.0}, {"source": "2602_17582_whitepaper", "target": "gc_autonomous_experiments", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.3", "weight": 1.0}, {"source": "2602_17582_whitepaper", "target": "gc_data_to_discovery", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 3.4", "weight": 1.0}, {"source": "2602_17582_whitepaper", "target": "ai_native_paradigm", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2602.17582.md", "source_location": "Executive Summary", "weight": 1.0}, {"source": "2602_17582_whitepaper", "target": "national_scale_collaboration", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2602.17582.md", "source_location": "Section 4", "weight": 1.0}, {"source": 