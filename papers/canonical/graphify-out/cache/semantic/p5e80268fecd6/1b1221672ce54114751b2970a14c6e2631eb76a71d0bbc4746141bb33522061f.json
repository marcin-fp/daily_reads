{"nodes": [{"id": "2608_05000_multimodal_pretraining", "label": "Physics of Multimodal Pretraining", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "rationale": "Systematic study of fundamental mechanisms governing unified multimodal pretraining across language, visual understanding, and visual generation"}, {"id": "2608_05000_knowledge_flow", "label": "Asymmetric Knowledge Flow", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "rationale": "Finding that language and visual understanding act as strong priors for visual generation, but visual generation yields neutral effects on other abilities"}, {"id": "2608_05000_modality_synergy", "label": "Modality Synergy vs. Competition", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "rationale": "Data complexity determines whether modalities synergize or compete; shared attention and normalization promote synergy while decoupled FFNs mitigate competition"}, {"id": "2608_05000_early_unification", "label": "Early Unification Principle", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "rationale": "Unifying modalities from early training stages and training them jointly is more effective than late alignment or sequential training"}, {"id": "2608_05000_transfusion", "label": "Transfusion Framework", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "rationale": "Unified framework combining discrete next-token prediction for text and continuous flow matching for visual generation within single model"}, {"id": "2608_05000_rae", "label": "Representation Autoencoder (RAE)", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "rationale": "Visual tokenization using frozen SigLIP-2 ViT encoder for 224\u00d7224 images into 16\u00d716 grid of 256 semantic tokens"}, {"id": "2608_05000_clevr_synthetic", "label": "CLEVR Synthetic Testbed", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "rationale": "Controlled synthetic environment for isolating concept transfer between modalities with systematic ablation of color, shape, relation, size, and count"}, {"id": "2608_05000_concept_dependent_transfer", "label": "Concept-Dependent Knowledge Transfer", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "rationale": "Low-level concepts (color, shape) fail zero-shot transfer but generation provides latent priors; structural concepts (relation, size, count) transfer from understanding to generation"}, {"id": "2608_05000_multimodal_pretraining", "label": "Physics of Unified Multimodal Pretraining", "file_type": "paper", "source_file": "2026-06-09/2608.05000.md", "source_location": null, "source_url": "https://arxiv.org/abs/2608.05000", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Core paper investigating knowledge flow asymmetry, vision laziness, and architectural design for unified multimodal models"}, {"id": "2608_05000_knowledge_flow", "label": "Asymmetric Knowledge Flow Between Modalities", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "source_location": "Section 3", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Language acts as universal booster; visual understanding drives generation; generation provides minimal backward transfer"}, {"id": "2608_05000_vision_laziness", "label": "Vision Laziness in Late Alignment", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "source_location": "Section 5.3", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Delayed multimodal unification causes vision pathway to become underdeveloped and disconnected from language manifold"}, {"id": "2608_05000_early_unification", "label": "Early Unification Strategy", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "source_location": "Section 5", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Training vision and language from scratch together prevents vision laziness and enables native visual learning"}, {"id": "2608_05000_moe_architecture", "label": "Mixture-of-Experts Architecture Design", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "source_location": "Section 4", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Shared attention and normalization with modality-specific FFNs maximizes synergy while minimizing competition"}, {"id": "2608_05000_asymmetric_data_mixture", "label": "Asymmetric Data Mixture Recipe (L70/U25/G5)", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "source_location": "Section 6.1", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Optimal pretraining allocates 70% language, 25% visual understanding, 5% visual generation based on knowledge flow asymmetry"}, {"id": "2608_05000_clevr_synthetic", "label": "CLEVR Synthetic Dataset for Concept Transfer", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "source_location": "Section 3.2, Appendix C", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Controlled synthetic environment to measure concept-dependent knowledge flow across color, shape, relation, size, count"}, {"id": "2608_05000_figure_12", "label": "Sequential vs Joint Pretraining Comparison", "file_type": "image", "source_file": "2026-06-09/2608.05000.md", "source_location": "Figure 12", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Demonstrates joint training dominates sequential approaches across metrics; replay buffer mitigates but does not match synergies"}, {"id": "2608_05000_figure_13", "label": "Vision Laziness Mechanistic Measurements", "file_type": "image", "source_file": "2026-06-09/2608.05000.md", "source_location": "Figure 13", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Four orthogonal axes measure vision pathway commitment: training activation L2, embedding norm, inference activation, attention on image"}, {"id": "2608_05000_table_1", "label": "Data Mixing Ratios Grid Search Results", "file_type": "image", "source_file": "2026-06-09/2608.05000.md", "source_location": "Table 1", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Extensive grid search across three axes validates asymmetric data volume requirements; L70/U25/G5 emerges as optimal"}, {"id": "2608_05000_table_2", "label": "Scaling Results and Controlled Baselines", "file_type": "image", "source_file": "2026-06-09/2608.05000.md", "source_location": "Table 2", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "13.5B MoE model validation on 2T tokens; compares asymmetric vs balanced recipe, MoE vs dense, early vs late fusion"}, {"id": "concept_multimodal_synergy", "label": "Multimodal Synergy vs Competition", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "source_location": "Section 4", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Shared attention promotes synergy; decoupled FFNs prevent competition; architectural design determines modality interaction dynamics"}, {"id": "concept_scaling_laws_multimodal", "label": "Scaling Laws for Native Multimodal Models", "file_type": "concept", "source_file": "2026-06-09/2608.05000.md", "source_location": "Section 8", "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Early-fusion co-evolution enables efficient scaling; generative capabilities bootstrapped from understanding and language priors"}], "edges": [{"source": "2608_05000_multimodal_pretraining", "target": "2608_05000_knowledge_flow", "relat