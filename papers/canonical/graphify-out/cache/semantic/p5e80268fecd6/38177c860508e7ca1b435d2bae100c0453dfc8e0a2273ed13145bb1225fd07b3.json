{"nodes": [{"id": "scientific_invention_position_paper_zahavy", "label": "LLMs Can't Jump Position Paper", "file_type": "paper", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": "Tom Zahavy, Google DeepMind", "contributor": null, "rationale": "Philosophical analysis of scientific discovery mechanisms; argues LLMs lack abductive reasoning required for axiom formulation; uses Einstein's General Relativity as case study."}, {"id": "scientific_invention_induction", "label": "Induction (Statistical Pattern Matching)", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Inferring general rules from observations based on statistical frequency; mastered by modern LLMs; insufficient for discovery without error signal."}, {"id": "scientific_invention_deduction", "label": "Deduction (Formal Proof)", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Formal derivation of theorems from established premises; rapidly conquered by AI (AlphaProof, Gemini, GPT-5); downstream verification process."}, {"id": "scientific_invention_abduction", "label": "Abduction (Hypothesis Generation)", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Creative leap inventing cause for singular phenomenon; requires embodied simulation and physical grounding; structurally absent in current LLMs."}, {"id": "scientific_invention_manipulative_abduction", "label": "Manipulative Abduction", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Active interaction with mental models to generate hypotheses through thinking by doing; anchors abstract symbols in tangible physical simulations."}, {"id": "scientific_invention_einstein_equivalence_principle", "label": "Einstein's Equivalence Principle", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Indistinguishability of gravity and acceleration; formulated via thought experiment of falling observer; exemplifies abductive leap from embodied simulation."}, {"id": "scientific_invention_world_models", "label": "Physically Consistent World Models", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Proposed pathway to bridge sensory grounding gap; must enable counterfactual intervention and interactive simulation, not just passive video generation."}, {"id": "scientific_invention_genie_model", "label": "Genie Interactive World Model", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Generative world model with action-controllability; enables agentic intervention prerequisite for manipulative abduction; marks shift from passive to interactive simulation."}, {"id": "scientific_invention_michelson_morley", "label": "Michelson-Morley Experiment", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Failed to detect Earth's movement through ether; constant light speed observation; motivated Einstein's Special Relativity postulates."}, {"id": "scientific_invention_mercury_perihelion", "label": "Mercury Perihelion Anomaly", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Tiny shift in Mercury's orbit; only known anomaly to Newtonian gravity; initially attributed to undiscovered planet 'Vulcan'; resolved by General Relativity."}, {"id": "scientific_invention_special_relativity", "label": "Special Relativity (1905)", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Einstein's resolution of Michelson-Morley contradiction; founded on two postulates: relativity principle and invariance of light speed."}, {"id": "scientific_invention_general_relativity", "label": "General Relativity (1915)", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Einstein's generalization to accelerated frames; field equations relate spacetime curvature to matter-energy; formulated through iterative refinement 1907-1915."}, {"id": "scientific_invention_entwurf_sketch", "label": "Entwurf (Sketch) Theory 1913", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Einstein-Grossmann collaboration; identified Riemann curvature tensor but abandoned path due to fatal error in static field assumption."}, {"id": "scientific_invention_alphaproof", "label": "AlphaProof System", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "source_url": null, "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "AI system achieving silver-medal performance on IMO problems; demonstrates LLM mastery of deductive formal proof generation."}, {"id": "scientific_invention_position_paper_17_poisson_equation", "label": "Generalized Poisson Equation", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": "Section (6)", "rationale": "Einstein's tensor generalization of Poisson's equation replaces scalar potential with curvature tensor and mass density with stress-energy tensor, bridging Newtonian and relativistic gravity."}, {"id": "scientific_invention_position_paper_17_newtonian_limit", "label": "Newtonian Limit", "file_type": "concept", "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": "Section (7)", "rationale": "Requirement that General Relativity reduces to Newton's laws under weak fields, slow motion, and static conditions\u2014a consistency constraint on relativistic theory."}], "edges": [{"source": "scientific_invention_position_paper_zahavy", "target": "scientific_invention_induction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "weight": 1.0}, {"source": "scientific_invention_position_paper_zahavy", "target": "scientific_invention_deduction", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/scientific-invention-position-paper-17.md", "source_location": null, "weight": 1.0}, {"source": "scientific_invention_pos