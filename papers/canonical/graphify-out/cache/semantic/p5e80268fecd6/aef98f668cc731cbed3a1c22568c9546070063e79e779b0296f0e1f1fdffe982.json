{"nodes": [{"id": "2105_01601_mlp_mixer", "label": "MLP-Mixer Architecture", "file_type": "paper", "source_file": "2026-06-09/2105.01601.md", "source_location": "Section 1-2", "source_url": "https://arxiv.org/abs/2105.01601v4", "captured_at": null, "author": "Tolstikhin et al.", "contributor": null, "rationale": "Vision architecture using only MLPs without convolutions or attention, with token-mixing and channel-mixing layers for spatial and feature interactions."}, {"id": "2105_01601_token_mixing", "label": "Token-Mixing MLPs", "file_type": "concept", "source_file": "2026-06-09/2105.01601.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MLP layers that operate on columns of input table, enabling cross-location spatial communication with linear complexity in number of patches."}, {"id": "2105_01601_channel_mixing", "label": "Channel-Mixing MLPs", "file_type": "concept", "source_file": "2026-06-09/2105.01601.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MLP layers that operate on rows of input table, enabling per-location feature communication with parameter sharing across spatial locations."}, {"id": "2105_01601_isotropic_design", "label": "Isotropic Architecture Design", "file_type": "concept", "source_file": "2026-06-09/2105.01601.md", "source_location": "Section 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed-width layers throughout network unlike pyramidal CNNs, similar to Transformers and deep RNNs, enabling consistent computational complexity."}, {"id": "2105_01601_parameter_tying", "label": "Parameter Tying in Token-Mixing", "file_type": "concept", "source_file": "2026-06-09/2105.01601.md", "source_location": "Section 2, Appendix A.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same MLP kernel shared across all channels in token-mixing, providing positional invariance and memory savings without empirical performance loss."}, {"id": "2105_01601_imagenet_results", "label": "ImageNet Transfer Performance", "file_type": "concept", "source_file": "2026-06-09/2105.01601.md", "source_location": "Section 3.1, Table 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixer-H/14 achieves 87.94% top-1 accuracy on ImageNet when pre-trained on JFT-300M, competitive with ViT-H/14 (88.55%) while 2.5x faster."}, {"id": "2105_01601_data_scaling", "label": "Data Scaling Analysis", "file_type": "concept", "source_file": "2026-06-09/2105.01601.md", "source_location": "Section 3.3, Figure 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixer improves faster with dataset size than ResNets and ViT, with performance gap shrinking as data scale increases from 3% to 100% of JFT-300M."}, {"id": "2105_01601_permutation_invariance", "label": "Permutation Invariance Study", "file_type": "concept", "source_file": "2026-06-09/2105.01601.md", "source_location": "Section 3.4, Figure 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixer invariant to patch and pixel shuffling within patches; ResNet performance drops 75% with global pixel permutation vs Mixer's 45% drop."}, {"id": "2105_01601_visualization", "label": "Learned Feature Visualization", "file_type": "concept", "source_file": "2026-06-09/2105.01601.md", "source_location": "Section 3.5, Figure 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Token-mixing MLPs learn both global and local feature detectors with opposing-phase pairs, similar to CNN Gabor-like filters but with global receptive fields."}], "edges": [{"source": "2105_01601_mlp_mixer", "target": "2105_01601_token_mixing", "relation": "uses", "confidence": "EXTRACTED", "confidence_score": 1.0