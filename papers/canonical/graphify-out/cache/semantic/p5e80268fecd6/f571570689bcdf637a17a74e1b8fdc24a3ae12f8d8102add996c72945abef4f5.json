rationale": "Tool for novelty screening and reference retrieval in ideation and writeup stages"}, {"id": "deepseek_v4_flash_judge", "label": "DeepSeek-V4-Flash Judge", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-family evaluation judge for OmniScientist manuscript scoring"}, {"id": "gemini_2_5_flash_lite_judge", "label": "Gemini-2.5-Flash-Lite Judge", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-family evaluation judge for OmniScientist manuscript scoring"}, {"id": "omniscientist_paper", "label": "OmniScientist: An Omni-Modal Omni-Discipline AI Scientist", "file_type": "paper", "source_file": "2026-06-09/2608.13558.md", "source_location": null, "source_url": "https://arxiv.org/abs/2608.13558", "captured_at": "2026-06-09", "author": "Chenyang Shao et al.", "contributor": null, "rationale": "Autonomous AI system for scientific discovery across multiple disciplines and modalities; uses gated stages (ideation, experiment, writeup) with deterministic exit checks to enforce research rigor."}, {"id": "omniscientist_ideation_stage", "label": "Ideation Stage", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 4, Appendix G", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First gated stage of OmniScientist; generates and screens research ideas through literature search, material inspection, and feasibility checks; enforces novelty and computational feasibility constraints."}, {"id": "omniscientist_experiment_stage", "label": "Experiment Stage", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 4, Appendix G", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Second gated stage; executes full study battery (primary, baseline, ablation, mechanism, breakdown, sensitivity); enforces multiple-comparison correction, anti-fabrication, and anti-HARKing rules."}, {"id": "omniscientist_writeup_stage", "label": "Writeup Stage", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 4, Appendix F", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Third gated stage; drafts manuscript with field-specific structural templates (ML, biomedical, earth & space, physics, chemistry); enforces traceability of all reported numbers to experiment record."}, {"id": "omniscientist_perception_layer", "label": "Perception Layer", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Appendix D, Table 18", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multimodal perception tools for signal, audio, 3D, image, video, trajectory, and table data; provides both visual rendering (look_at_*) and native analysis (analyze_*) channels; 337 total calls across 36 runs."}, {"id": "omniscientist_rigour_check", "label": "Rigour Check (Exit Predicate)", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 4, Appendix B, Table 14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic code-based validation of experiment stage output; enforces verdict, real execution, provenance, multiple-test correction, lead selection, and demotion rules; rejected 87 finalize attempts across 36 runs."}, {"id": "omniscientist_idea_check", "label": "Idea Check (Exit Predicate)", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 4, Appendix B, Table 14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic validation of ideation stage; enforces schema completeness, breadth (\u22655 candidates), prior art searches, feasibility, novelty evidence, and claim scope; rejected 28 finalize attempts."}, {"id": "omniscientist_claim_check", "label": "Claim Check (Exit Predicate)", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 4, Appendix B, Table 14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic validation of writeup stage; enforces traceability of all numbers to experiment record, guards against prose-polish alterations, removes over-reaching claims, ensures compilation."}, {"id": "omniscientist_evaluation_results", "label": "OmniScientist Evaluation Results", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 5, Table 3, Table 12, Table 17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "36 primary runs across 6 scientific domains; 265 analyses per run (7.4 avg); 67 demoted analyses (1.9 avg); 44% supported, 47% mixed, 6% refuted verdicts; macro-average perception gain +1.39 across evaluation dimensions."}, {"id": "omniscientist_judge_panel", "label": "OmniScientist Judge Panel", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 5.2, Appendix A, Listing 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two expert peer reviewers score 7 dimensions (novelty, soundness, clarity, significance, reproducibility, mm_grounding, factual_accuracy) on 0-10 scale; inter-judge agreement Krippendorff's \u03b1=0.66; validates rubric-based evaluation."}, {"id": "omniscientist_task_specification", "label": "Task Specification Format", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Appendix E, Listing 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSON specification file defining role, subject, property, request, and member list; modality field unlocks perception tools; no method/hypothesis/analysis specified; enables discipline-agnostic engine."}, {"id": "omniscientist_writeup_templates", "label": "Field-Specific Writeup Templates", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Appendix F, Table 19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "5 structural specifications (ML, biomedical, earth & space, physics, chemistry) with field-specific section ordering; reflects actual field conventions (e.g., biomedical puts Methods last)."}, {"id": "omniscientist_check_rejections", "label": "Check Rejection Statistics", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Appendix B, Table 15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "115 total rejections across 36 runs; 51 demotion rejections (non-significant analyses), 21 verdict schema rejections, 12 schema rejections in ideation; only 4 runs reached both stage exits without rejection."}, {"id": "omniscientist_perception_budget", "label": "Perception Budget Management", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Appendix C, Table 16, Algorithm 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ideation averages 4.5 visual perception calls per run; experiment averages 0.9; total 337 perception calls across 36 runs; budget enforced at stage boundary to prevent unbounded exploration."}, {"id": "omniscientist_execution_statistics", "label": "OmniScientist Execution Statistics", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Appendix C, Table 16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ideation: 8.8 steps, 19.9 tool calls, 8.7 literature searches, 0 code executions; Experiment: 36.0 steps, 37.2 tool calls, 31.8 code executions, 1.0 perception calls; no budget exhaustion."}, {"id": "omniscientist_backbone_models", "label": "OmniScientist Backbone Models", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 5.2, Table 3, Table 11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluated on 8 models: Sonnet 5, GPT-5.6, Qwen3.5 (27B, 122B, 9B), Gemma-4 (31B, 26B), GLM-5; Sonnet 5 achieves highest panel scores; cost ranges $0.03\u2013$4.34 per paper."}, {"id": "omniscientist_multimodal_grounding", "label": "Multimodal Grounding Evaluation", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 5.2, Table 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Perception-enabled system improves mm_grounding dimension by +1.53 macro-average; plant phenotyping gains +4.0, pathology +3.0; rewards papers that show and interpret raw observations."}, {"id": "omniscientist_case_studies", "label": "OmniScientist Case Studies", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Section 5.5, Table 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "6 scientific domains: galaxy cross-survey, seismology, pathology, mechanical CAD, plant phenotyping, cardiology; perception gain ranges +0.3 to +3.0 overall; mechanical CAD shows strongest clarity improvement (+3.5)."}, {"id": "omniscientist_leakage_prevention", "label": "Leakage Prevention in OmniScientist", "file_type": "concept", "source_file": "2026-06-09/2608.13558.md", "source_location": "Appendix B, Table 14, Appendix G", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idea check enforces no label us