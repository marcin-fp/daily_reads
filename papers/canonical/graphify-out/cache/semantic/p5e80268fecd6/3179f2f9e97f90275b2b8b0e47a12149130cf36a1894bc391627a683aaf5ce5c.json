{"nodes": [{"id": "jain_et_al_2026_sycophancy_llms", "label": "Interaction Context Often Increases Sycophancy in LLMs", "file_type": "paper", "source_file": "2026-05-06/3772318-3791915.md", "source_location": null, "source_url": "https://doi.org/10.1145/3772318.3791915", "captured_at": "2026-05-06", "author": "Shomik Jain, Charlotte Park, Matt Viana, Ashia Wilson, Dana Calacci", "contributor": null, "rationale": "Study investigates how interaction context shapes sycophancy in LLMs through real-world user interactions, finding that agreement sycophancy increases with user context while perspective sycophancy depends on model understanding of user views."}, {"id": "jain_et_al_2026_agreement_sycophancy", "label": "Agreement Sycophancy", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Definition 2.1", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Model behavior that excessively mirrors a user's positive self-image through overly agreeable or flattering responses; measured using LLM-judge on personal advice scenarios."}, {"id": "jain_et_al_2026_perspective_sycophancy", "label": "Perspective Sycophancy", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Definition 2.2", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Model behavior that excessively mirrors a user's perspective or viewpoint in responses; measured through participant ratings of political explanations."}, {"id": "jain_et_al_2026_user_memory_profiles", "label": "User Memory Profiles", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 3.3", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Distilled summaries of user personality and preferences extracted from conversation history; associated with largest increases in agreement sycophancy across models."}, {"id": "jain_et_al_2026_gemini_2_5_pro", "label": "Gemini 2.5 Pro", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 4.1", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "LLM model evaluated in study; showed +45% increase in agreement sycophancy with user memory profiles and +9% with synthetic interactions."}, {"id": "jain_et_al_2026_claude_sonnet_4", "label": "Claude Sonnet 4", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 4.1", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "LLM model evaluated in study; showed +33% increase in agreement sycophancy with user memory profiles; demonstrated 45% accuracy in understanding user political views."}, {"id": "jain_et_al_2026_gpt_4_1_mini", "label": "GPT 4.1 Mini", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 3.2", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Model used for interaction period in study; showed +16% increase in agreement sycophancy with user memory profiles; demonstrated 71% accuracy in understanding user political views."}, {"id": "jain_et_al_2026_llama_4_scout", "label": "Llama 4 Scout", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 4.1", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "LLM model evaluated in study; showed +25% increase in agreement sycophancy with user interactions but no significant change with memory profiles; exhibited degraded responses with some contexts."}, {"id": "jain_et_al_2026_gpt_5_1", "label": "GPT 5.1", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 4.1", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "LLM model evaluated in study; did not exhibit significant changes in agreement sycophancy with user interactions or memory profiles; does not support temperature setting."}, {"id": "jain_et_al_2026_personal_advice_evaluation", "label": "Personal Advice Evaluation Task", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 3.3", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Evaluation using 10 Reddit AITA scenarios to measure agreement sycophancy; uses LLM-judge to determine if responses suggest user did something wrong."}, {"id": "jain_et_al_2026_political_explanations_evaluation", "label": "Political Explanations Evaluation Task", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 3.4", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Evaluation using 10 U.S. political topics to measure perspective sycophancy; participants rate how closely responses reflect their political views on 4-point Likert scale."}, {"id": "jain_et_al_2026_study_participants", "label": "Study Participants", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 3.1", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "38 college students (19 men, 17 women, 2 non-binary) from 11 U.S. institutions; stratified by gender and political views; average 90 queries over 2-week interaction period."}, {"id": "jain_et_al_2026_interaction_context_types", "label": "Interaction Context Types", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 3.3", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Three types evaluated: synthetic interactions (Ultrachat queries), user interactions (participant conversation history), and user memory profiles (distilled personality summaries)."}, {"id": "jain_et_al_2026_mirroring_behaviors", "label": "Mirroring Behaviors in Human-AI Interaction", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 2.1", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Broader class of behaviors where AI systems reflect user features including body language, speech, values, desires; includes confirmation bias, linguistic style matching, emotional contagion."}, {"id": "jain_et_al_2026_personalization_alignment", "label": "Personalization and Alignment Methods", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 2.1", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "System design choices that may promote mirroring; includes user-driven value alignment, mimetic models for productivity, bidirectional alignment approaches."}, {"id": "jain_et_al_2026_echo_chambers", "label": "Echo Chambers and Information Filtering", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 2.1", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Risk of mirroring behaviors creating echo chambers; users engage in more selective search when using LLMs for political explanations; generative echo chamber effect."}, {"id": "jain_et_al_2026_regression_analysis", "label": "Regression Analysis Framework", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 3.6", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Linear regression model examining associations between sycophancy and context presence, model understanding, user demographics; includes interaction terms and task fixed effects."}, {"id": "jain_et_al_2026_model_understanding", "label": "Model Understanding of Users", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 3.5", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Measured by asking models to infer user personality and political views from interaction context; users rated accuracy on 5-point scale; models generally understand personality better than politics."}, {"id": "jain_et_al_2026_design_interventions", "label": "Design Interventions for Reducing Sycophancy", "file_type": "concept", "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 5.4", "source_url": null, "captured_at": "2026-05-06", "author": null, "contributor": null, "rationale": "Proposed strategies: automated detection of sycophancy, offering alternative perspectives, increasing transparency about uncertainty, allowing user control over personalization degree."}], "edges": [{"source": "jain_et_al_2026_sycophancy_llms", "target": "jain_et_al_2026_agreement_sycophancy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Abstract and Section 2.2", "weight": 1.0}, {"source": "jain_et_al_2026_sycophancy_llms", "target": "jain_et_al_2026_perspective_sycophancy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Abstract and Section 2.2", "weight": 1.0}, {"source": "jain_et_al_2026_agreement_sycophancy", "target": "jain_et_al_2026_personal_advice_evaluation", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-05-06/3772318-3791915.md", "source_location": "Section 3.3", "weight": 1.0}, {"source": "jain_et_al_2026_perspective_sycophancy