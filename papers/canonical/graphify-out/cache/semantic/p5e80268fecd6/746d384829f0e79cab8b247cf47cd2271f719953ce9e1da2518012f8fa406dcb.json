{"nodes": [{"id": "2609_13443_ngu", "label": "Never Give Up (NGU)", "file_type": "paper", "source_file": "2026-06-09/2609.13443.md", "source_location": null, "source_url": "https://arxiv.org/abs/2609.13443", "captured_at": "2026-06-09", "author": "Michael Noukhovitch, Hamish Ivison, Nathan Lambert, Aaron Courville", "contributor": null, "rationale": "Adaptive sampling method for RL that iteratively generates samples until correct, dynamically allocating more compute to harder problems to counter the Matthew Effect."}, {"id": "2609_13443_matthew_effect", "label": "Matthew Effect in RL for LLMs", "file_type": "concept", "source_file": "2026-06-09/2609.13443.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phenomenon where RL improves performance on tasks in proportion to initial model competence, making easy tasks easier while hard tasks remain difficult."}, {"id": "2609_13443_signal_efficiency", "label": "Signal Efficiency Hypothesis", "file_type": "concept", "source_file": "2026-06-09/2609.13443.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alternative explanation for Matthew Effect focusing on inefficient compute allocation: excessive sampling of easy problems wastes compute while hard problems are undersampled."}, {"id": "2609_13443_grpo", "label": "GRPO (Group Relative Policy Optimization)", "file_type": "concept", "source_file": "2026-06-09/2609.13443.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard RL method for LLMs using empirical group baseline that can exacerbate Matthew Effect through fixed compute allocation."}, {"id": "2609_13443_harness_aware_matthew_effect", "label": "Harness-Aware Matthew Effect", "file_type": "concept", "source_file": "2026-06-09/2609.13443.md", "source_location": null, "source_url": null, "captured_at": nu