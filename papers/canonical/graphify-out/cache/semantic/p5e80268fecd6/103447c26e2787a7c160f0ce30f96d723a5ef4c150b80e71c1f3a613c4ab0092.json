{"nodes": [{"id": "2211_09085_galactica", "label": "Galactica Large Language Model", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "1, 4", "captured_at": "2026-06-09", "rationale": "Large language model trained on curated scientific corpus (106B tokens); designed to store, combine, and reason about scientific knowledge"}, {"id": "2211_09085_scientific_corpus", "label": "Galactica Scientific Corpus", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "3", "captured_at": "2026-06-09", "rationale": "Curated dataset of 106B tokens from papers (48M), code (2M), reference material (8M), knowledge bases (2M), filtered CommonCrawl (0.9M)"}, {"id": "2211_09085_working_memory_token", "label": "Working Memory Token <work>", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "3.1.1", "captured_at": "2026-06-09", "rationale": "Novel tokenization approach wrapping step-by-step reasoning; mimics internal working memory; addresses limitations of chain-of-thought prompting"}, {"id": "2211_09085_citation_token", "label": "Citation Token [START_REF]", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "3.1.2", "captured_at": "2026-06-09", "rationale": "Special tokens for citations using title-based identifiers; enables citation prediction task; trade-off between accuracy and hallucination"}, {"id": "2211_09085_prompt_pretraining", "label": "Prompt Pre-training Strategy", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "3.2", "captured_at": "2026-06-09", "rationale": "Includes task-specific prompts (358M tokens) alongside general corpus in pre-training; balances task specialization with generality"}, {"id": "2211_09085_repeated_tokens", "label": "Repeated Tokens Training", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "5.1", "captured_at": "2026-06-09", "rationale": "Trains for 4.25 epochs on curated corpus; validation loss continues to fall; contradicts prior work suggesting repeated tokens harmful; suggests quality matters more than scale"}, {"id": "2211_09085_latex_equations_probe", "label": "LaTeX Equations Knowledge Probe", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "5.2.1", "captured_at": "2026-06-09", "rationale": "Galactica 120B achieves 68.2% vs GPT-3 49.0% on equation knowledge; demonstrates value of curated scientific corpus"}, {"id": "2211_09085_mmlu_math", "label": "MMLU Mathematics Benchmark", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "5.2.3", "captured_at": "2026-06-09", "rationale": "Galactica 120B with <work> token achieves 41.3% vs Chinchilla 35.7%; demonstrates reasoning capability"}, {"id": "2211_09085_math_benchmark", "label": "MATH Benchmark", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "5.2.3", "captured_at": "2026-06-09", "rationale": "Galactica 120B achieves 20.4% vs PaLM 540B 8.8%; 30B model beats PaLM 540B with 18x fewer parameters"}, {"id": "2211_09085_citation_prediction", "label": "Citation Prediction Task", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "5.4", "captured_at": "2026-06-09", "rationale": "Galactica 120B achieves 51.9% on PWC Citations, outperforming retrieval baselines; distributional analysis shows improved modeling of citation distribution with scale"}, {"id": "2211_09085_iupac_naming", "label": "IUPAC Name Prediction", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "5.6.1", "captured_at": "2026-06-09", "rationale": "Galactica learns IUPAC nomenclature in self-supervised way; attention visualization shows interpretable learning of functional groups"}, {"id": "2211_09085_moleculenet", "label": "MoleculeNet Drug Discovery Tasks", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "5.6.2", "captured_at": "2026-06-09", "rationale": "Galactica poses drug discovery as natural language prompts; weak supervision setup; scales with model size but lags specialist models"}, {"id": "2211_09085_protein_sequences", "label": "Protein Sequence Handling", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "3.1, 5.6.2", "captured_at": "2026-06-09", "rationale": "Character-based tokenization with [START_AMINO] and [END_AMINO] tokens; enables multi-modal learning with SMILES and protein sequences"}, {"id": "2211_09085_smiles_representation", "label": "SMILES Chemical Representation", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "3.1, 5.6", "captured_at": "2026-06-09", "rationale": "Character-based tokenization with [START_SMILES] and [END_SMILES] tokens; enables chemical structure representation in language model"}, {"id": "2211_09085_big_bench", "label": "BIG-bench General Tasks", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "5.5", "captured_at": "2026-06-09", "rationale": "Galactica 120B achieves 48.7% on 57 BIG-bench tasks, outperforming larger general models; suggests data quality matters more than scale"}, {"id": "galactica_paper", "label": "Galactica: A Large Language Model for Science", "file_type": "paper", "source_file": "2026-06-09/2211.09085.md", "source_location": null, "source_url": "https://arxiv.org/abs/2211.09085", "captured_at": null, "author": "Meta AI Research", "contributor": null, "rationale": "Large-scale LLM trained on scientific corpus including papers, textbooks, knowledge bases, and chemical/biological sequences. Demonstrates multi-modal learning across text and scientific modalities."}, {"id": "galactica_protein_understanding", "label": "Protein Sequence Understanding in Galactica", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "Section 5.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Galactica learns implicit sequence similarity measures from protein sequences without explicit 3D structure modeling. Enables functional annotation and description prediction tasks."}, {"id": "galactica_sequence_validation", "label": "Sequence Validation Perplexity", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "Section 5.7.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluation metric for protein sequence understanding using holdout sets (CASPSeq, PaenSeq, UniProtSeq) to measure generalization and detect memorization."}, {"id": "galactica_keyword_prediction", "label": "Protein Keyword Prediction Task", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "Section 5.7.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Task to predict UniProt keywords from protein sequences alone, demonstrating translation from sequence modality to natural language annotations."}, {"id": "galactica_function_description", "label": "Protein Function Description Generation", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "Section 5.7.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free-form generation of protein function descriptions from sequences using ROUGE-L metric. Shows smooth scaling with model size."}, {"id": "galactica_bias_toxicity", "label": "Bias and Toxicity Evaluation", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "Section 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Comprehensive evaluation on CrowS-Pairs, StereoSet, RealToxicityPrompts, and TruthfulQA showing Galactica exhibits lower bias than comparable models due to scientific corpus."}, {"id": "multimodal_learning", "label": "Multi-Modal Learning in Language Models", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "Section 5.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Galactica demonstrates learning across text and scientific modalities (SMILES, protein sequences) within single model. Enables cross-modal reasoning and annotation."}, {"id": "scientific_corpus_construction", "label": "Scientific Corpus Construction", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "Section A.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Galactica training corpus includes 48M papers, 8M reference materials, 2M knowledge bases, and filtered CommonCrawl. Totals ~120B tokens with quality filters applied."}, {"id": "citation_prediction", "label": "Citation Prediction Task", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "Section 2.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Galactica outperforms retrieval baselines on citation prediction using title-based identifiers. Demonstrates knowledge absorption and context-associative power."}, {"id": "work_token_reasoning", "label": "Work Token for Step-by-Step Reasoning", "file_type": "concept", "source_file": "2026-06-09/2211.09085.md", "source_location": "Section 2.4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Special token enabling intermediate reasoning steps. Improves performance on MATH and MMLU benchmarks compared to chain-of-thought prompting."}], "edges": [{"source": "2211_09085_galactica", "target": "2211_09085_scientific_corpus", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 0.95, "source_file": "2026-06-09/2211.09085.md", "source_location": "3", "weight": 1.0}, {"source":