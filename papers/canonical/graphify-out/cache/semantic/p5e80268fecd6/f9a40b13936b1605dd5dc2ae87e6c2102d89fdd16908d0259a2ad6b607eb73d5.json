{"nodes": [{"id": "arxiv_2310_03716", "label": "A Long Way to Go: Investigating Length Correlations in RLHF", "file_type": "paper", "source_file": "2026-06-09/2310.03716.md", "source_url": "https://arxiv.org/abs/2310.03716v2", "captured_at": "2026-06-09", "author": "Prasann Singhal, Tanya Goyal, Jiacheng Xu, Greg Durrett", "rationale": "Investigates how RLHF optimizes for response length rather than meaningful quality improvements, demonstrating that reward models exhibit strong length biases that dominate PPO optimization."}, {"id": "rlhf_reward_model_bias", "label": "RLHF Reward Model Length Bias", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Core finding that reward models in RLHF are strongly correlated with output length, causing PPO to optimize primarily for length rather than meaningful quality improvements."}, {"id": "ppo_optimization", "label": "Proximal Policy Optimization", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md"}, {"id": "length_stratified_analysis", "label": "Length-Stratified Reward Analysis", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Technique comparing outputs of similar length to isolate non-length reward gains, revealing that 70-90% of RLHF improvements on some datasets are length-driven."}, {"id": "webgpt_dataset", "label": "WebGPT Dataset", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md"}, {"id": "stack_dataset", "label": "Stack Exchange Dataset", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md"}, {"id": "rlcd_dataset", "label": "RLCD Dataset", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md"}, {"id": "llama_7b", "label": "Llama-7B Model", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md"}, {"id": "lppo_length_only", "label": "Length-Only PPO", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Experiment using only output length as reward signal, showing it reproduces most RLHF improvements, validating that length optimization dominates."}, {"id": "nrg_metric", "label": "Non-Length Reward Gain", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Metric measuring reward improvement within length buckets, isolating non-length features; reveals length accounts for 70-90% of gains on some datasets."}, {"id": "training_dynamics_analysis", "label": "Training Dynamics Analysis", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Study of reward model training over epochs tracking confidence and length heuristic agreement, showing length bias emerges from easy examples."}, {"id": "dataset_cartography", "label": "Dataset Cartography", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Technique mapping training examples by confidence and variance to identify easy vs hard examples; reveals length bias concentrated in high-confidence examples."}, {"id": "dpo_direct_preference_optimization", "label": "Direct Preference Optimization", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md"}, {"id": "lora_low_rank_adaptation", "label": "LoRA Low-Rank Adaptation", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md"}, {"id": "alpacafarm_simulated_preferences", "label": "AlpacaFarm Simulated Preferences", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Evaluation metric using GPT-4 as judge to compare model outputs, though itself may have length biases."}, {"id": "reward_model_training", "label": "Reward Model Training", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Process of training scalar reward models on preference data using Bradley-Terry model to estimate human preferences."}, {"id": "preference_data_balancing", "label": "Preference Data Balancing", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Intervention to reduce length bias in preference datasets by balancing distribution of pair length differences."}, {"id": "reward_scaling_intervention", "label": "Reward Scaling", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Batch normalization-like technique for reward scores to control training fluctuations and prevent over-optimization."}, {"id": "kl_divergence_penalty", "label": "KL Divergence Penalty", "file_type": "concept", "source_file": "2026-06-09/2310.03716.md", "rationale": "Regularization term in PPO objective preventing policy from deviating too far from initial SFT distribution."}], "edges": [{"source": "arxiv_2310_03716", "target": "rlhf_reward_model_bias", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2310.03716.md"}, {"source": "arxiv_2310_03716", "target": "ppo_optimization", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2310.03716.md"}, {"source": "arxiv_2310_03716", "target": "length_stratified_analysis", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2310.03716.md"}, {"source": "arxiv_2310_03716", "target": "lppo_length_only", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2310.03716.md"}, {"source": "arxiv_2310_03716", "target": "nrg_metric", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2310.03716.md"}, {"source": "arxiv_2310_03716", "target": "training_dynamics_analysis", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "2026-06-09/2310.03716.md"}, {"source": "arxiv_2310_03716", "target": "dataset_cartography", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_fil