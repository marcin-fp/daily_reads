{"nodes": [{"id": "2606_12683_agi_to_asi", "label": "From AGI to ASI Report", "file_type": "paper", "source_file": "2026-06-09/2606.12683.md", "source_location": "Full document", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": "Tim Genewein et al.", "contributor": null, "rationale": "Comprehensive analysis of technological pathways from human-level AGI to artificial superintelligence (ASI), including scaling, paradigm shifts, recursive improvement, and multi-agent coordination."}, {"id": "2606_12683_agi_definition", "label": "AGI Definition", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 3", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Informal characterization: system with roughly median human-level intelligence across cognitive tasks; grounded in Legg-Hutter score as universal measure of intelligence."}, {"id": "2606_12683_asi_definition", "label": "ASI Definition", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 3", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Artificial general superintelligence exceeding performance of large human-expert collectives on virtually all tasks; set bar high to avoid complications from individual vs. collective distinctions."}, {"id": "2606_12683_universal_ai", "label": "Universal AI (UAI/AIXI)", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 3, 4", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Theoretical limit of superintelligence defined via AIXI agent; maximizes Legg-Hutter score over all computable environments; incomputable but provides formal upper bound."}, {"id": "2606_12683_digital_intelligence_advantages", "label": "Advantages of Digital Intelligence", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 3, Table 1", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Seven key advantages (I/O speed, processing speed, memory, substrate independence, lossless replication, experience sharing, high-bandwidth learning) that amplify with more compute."}, {"id": "2606_12683_scaling_pathway", "label": "Scaling Compute, Models & Data Pathway", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.1", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Pathway from AGI to ASI via continued scaling of effective compute (10\u00d7 per year), data, and model sizes; main uncertainty is how scale translates to capabilities."}, {"id": "2606_12683_paradigm_shift_pathway", "label": "Algorithmic Paradigm Shift Pathway", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.2", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Pathway involving evolution of current transformer paradigm (test-time scaling, continual learning, unbounded context, world models) or true paradigm shifts; difficult to predict."}, {"id": "2606_12683_recursive_improvement_pathway", "label": "Recursive Self-Improvement Pathway", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.3", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Pathway where AI facilitates AI R&D leading to improved systems that further accelerate research; could lead to explosive (hyperbolic) growth if fully autonomous."}, {"id": "2606_12683_multi_agent_pathway", "label": "Multi-Agent Coordination Pathway", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.4", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Pathway where ASI emerges from coordination of many AGI agents into group agents via centralized or decentralized (market-based) organization; collective intelligence scales with population."}, {"id": "2606_12683_effective_compute_growth", "label": "Effective Compute Growth Rate", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 2", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Estimated at 10\u00d7 per year from three compounding factors: hardware improvements (1.5\u00d7/year), investment growth (2.5\u00d7/year), and algorithmic efficiency (3\u00d7/year or higher)."}, {"id": "2606_12683_recursive_improvement_types", "label": "Types of Recursive Improvement", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.3", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Four types mapped to human evolution: genotypic (code/architecture), memetic (data/distillation), sociogenic (specialization/cooperation), and hardware improvements."}, {"id": "2606_12683_fundamental_limits_asi", "label": "Fundamental Limits of ASI", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 3, Table 2", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "ASI bounded by physics (speed of light, Landauer principle), real-time constraints, physical manipulation limits, epistemic uncertainty, complexity theory, and logic (G\u00f6del, Halting)."}, {"id": "2606_12683_aixi_framework", "label": "AIXI Framework", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 4", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Formal agent that solves general RL by planning with posterior belief over computable environments; optimal under Solomonoff prior; incomputable but approximable from below."}, {"id": "2606_12683_legg_hutter_score", "label": "Legg-Hutter Intelligence Score", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 3, 4", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Formal measure of intelligence as average performance across all computable tasks weighted by inverse complexity; provides continuum grounding for AGI/ASI characterization."}, {"id": "2606_12683_solomonoff_prior", "label": "Solomonoff Universal Prior", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 4", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Prior assigning probabilities to computable environments based on Kolmogorov complexity; lower complexity environments exponentially more likely; mathematically motivated from first principles."}, {"id": "2606_12683_data_exhaustion_friction", "label": "High-Quality Data Exhaustion Friction", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.1", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Friction on scaling pathway: high-quality text estimated to exhaust later this decade; bridging to ASI requires synthetic data generation or interactive environments."}, {"id": "2606_12683_test_time_scaling", "label": "Test-Time Scaling", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.2", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Paradigm evolution: expanding capabilities orthogonally to model scale via chain-of-thought reasoning, planning, search; decouples intelligence from static training constraints."}, {"id": "2606_12683_continual_learning", "label": "Continual Learning", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.2", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Paradigm evolution: AGI-level system capability for perpetual learning from interactions without catastrophic forgetting; critical for open-ended capability growth."}, {"id": "2606_12683_world_models", "label": "Internal World Models", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.2", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Paradigm evolution: learning compressed, manipulable representations of environment dynamics for simulation, planning, and counterfactual reasoning; prerequisite for human-level AGI."}, {"id": "2606_12683_group_agency", "label": "Group Agency", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.4", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Coherent collective structures where multiple AGI agents form group agents with representational and motivational states distinct from constituents; analogous to human institutions."}, {"id": "2606_12683_cognitive_division_labor", "label": "Cognitive Division of Labor", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.4", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Multi-agent pathway mechanism: specialization and delegation based on complementary affordances; enables collective to bypass bottlenecks of single architecture."}, {"id": "2606_12683_agent_economies", "label": "Virtual Agent Economies", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.4", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Decentralized multi-agent coordination via market mechanisms (auctions, price signals, credit assignment); system-level optimization emerges from local incentives."}, {"id": "2606_12683_hyperbolic_growth", "label": "Hyperbolic Growth Dynamics", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 2, 5.3", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "Super-exponential growth where growth rates increase with quantity; characteristic property is infinite growth in finite time (singularity); possible under recursive improvement."}, {"id": "2606_12683_embedding_problem", "label": "Embedding Problem in AIXI", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 4", "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": null, "contributor": null, "rationale": "AIXI limitation: agent is outside environment class (incomputable); cannot consider itself embedded or reason about other incomputable agents; recently addressed with embedded multi-agent extension."}, {"id": "2606_12683_agi_asi_report", "label": "From AGI to ASI: Mapping the Technological Landscape", "file_type": "paper", "source_file": "2026-06-09/2606.12683.md", "source_location": null, "source_url": "https://arxiv.org/abs/2606.12683", "captured_at": "2026-06-09", "author": "Marcus Hutter et al.", "contributor": null, "rationale": "Comprehensive technical report analyzing pathways from AGI to ASI, bottlenecks, and research agenda for post-AGI AI development"}, {"id": "2606_12683_scaling_pathway", "label": "Scaling of Compute, Models & Data Pathway", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.1, Table 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Continuation of exponential scaling trends in model size, data, and compute as primary pathway to ASI"}, {"id": "2606_12683_paradigm_shift_pathway", "label": "Algorithmic Paradigm Shifts Pathway", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.2, Table 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Discovery of more efficient algorithms and learning paradigms beyond current transformer-based pretraining"}, {"id": "2606_12683_recursive_improvement_pathway", "label": "Recursive Self-Improvement Pathway", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.3, Table 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI systems automating AI research and development, creating self-accelerating cycles of capability improvement"}, {"id": "2606_12683_group_agent_pathway", "label": "ASI via Group Agent Formation Pathway", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.4, Table 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collective intelligence of multiple AGI instances exceeding individual capabilities through coordination and specialization"}, {"id": "2606_12683_data_wall_bottleneck", "label": "Data Wall Bottleneck", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5, Table 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Running out of sufficient high-quality training data as model sizes outpace global novel text production"}, {"id": "2606_12683_economic_bottleneck", "label": "Economic and Natural Resource Demand Bottleneck", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5, Table 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unsustainable growth in economic investments, hardware production, and natural resources required for continued scaling"}, {"id": "2606_12683_paradigm_insufficiency_bottleneck", "label": "Neural Paradigm Insufficiency Bottleneck", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5, Table 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current transformer-based pretraining paradigm may be fundamentally insufficient for achieving AGI or ASI"}, {"id": "2606_12683_research_harder_bottleneck", "label": "Research Gets Harder Bottleneck", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5, Table 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Increased research effort required as field matures and low-hanging fruit are exhausted, potentially offset by AI-assisted research"}, {"id": "2606_12683_abstraction_barrier_bottleneck", "label": "Abstraction Barrier Bottleneck", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5, Table 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI systems trained on human abstractions may lack ability to form novel concepts from raw data, limiting path to true ASI"}, {"id": "2606_12683_deliberate_slowdown_bottleneck", "label": "Deliberate Slowdown, Regulation & Governance Bottleneck", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5, Table 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regulatory capping, safety concerns, and societal backlash may deliberately slow AI capability development"}, {"id": "2606_12683_universal_ai_framework", "label": "Universal AI (AIXI) Framework", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 4, Table 2", "source_url": null, "captured_at": null, "author": "Hutter, Legg", "contributor": null, "rationale": "Mathematical formalism providing theoretical upper bound on machine intelligence and fundamental limits"}, {"id": "2606_12683_instrumental_convergence", "label": "Instrumental Convergence", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 6, Remarks", "source_url": null, "captured_at": null, "author": "Omohundro, Bostrom", "contributor": null, "rationale": "Tendency for advanced AI systems to pursue universal sub-goals like resource acquisition and self-preservation regardless of final objectives"}, {"id": "2606_12683_knowledge_seeking_objective", "label": "Knowledge Seeking Objective", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 6, Remarks", "source_url": null, "captured_at": null, "author": "Orseau", "contributor": null, "rationale": "Alternative objective function maximizing information gain rather than scalar rewards, potentially more robust for advanced AI"}, {"id": "2606_12683_creativity_boden", "label": "Boden's Creativity Framework", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 6, Remarks", "source_url": null, "captured_at": null, "author": "Boden", "contributor": null, "rationale": "Three-level framework for creativity: combinational, exploratory, and transformative; ASI may require transformative creativity"}, {"id": "2606_12683_embodied_bottleneck", "label": "Embodied Bottleneck", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requirement that novel concepts be validated against physical reality, limiting recursive self-improvement to empirical science speeds"}, {"id": "2606_12683_multi_agent_scaling", "label": "Multi-Agent Scaling Laws", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 7.1, Research Agenda", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Understanding how collective intelligence scales with number of AGI instances and organizational structure"}, {"id": "2606_12683_test_time_scaling", "label": "Test-Time Scaling", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using additional compute at inference time through search, sampling, or reasoning to improve model performance beyond training"}, {"id": "2606_12683_recursive_distillation", "label": "Recursive Distillation", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 7.1, Research Agenda", "source_url": null, "captured_at": null, "author": "Silver et al. (AlphaZero)", "contributor": null, "rationale": "Iterative process of improving base model through test-time search followed by distillation back into model weights"}, {"id": "agi_asi_scaling_pathway_to_compute_efficiency", "label": "Scaling Pathway depends on Compute Efficiency", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exponential growth in model/data size requires exponential growth in compute efficiency to remain economically viable"}, {"id": "data_generation_counters_data_wall", "label": "Synthetic Data Generation Counters Data Wall", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Test-time scaling, simulations, and RL-generated interaction data can potentially overcome data wall bottleneck"}, {"id": "ai_research_automation_recursive_improvement", "label": "AI Research Automation Enables Recursive Improvement", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If AI can automate research, compute growth could translate to research productivity growth, enabling intelligence explosion"}, {"id": "group_scaling_bypasses_individual_limits", "label": "Group Scaling Bypasses Individual AGI Limits", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 6, Remarks", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Even if individual AGI plateaus at human level, large groups of AGIs could achieve superhuman performance through coordination"}, {"id": "abstraction_barrier_limits_novel_concepts", "label": "Abstraction Barrier Limits Novel Concept Discovery", "file_type": "concept", "source_file": "2026-06-09/2606.12683.md", "source_location": "Section 5.5", "source_url": null, "captured_at": null, "author": "Lerchner", "contributor": null, "rationale": "AI trained on human abstractions may lack ability to discover fundamentally new concepts from raw data, limiting ASI"}, {"id": "embodied_bottleneck_slows_recursive_improvement", "label": "Embodied Bottleneck Slows 